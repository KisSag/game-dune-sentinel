+++ b/Source/DuneSentinel/DuneSentinelGameInstance.cpp
@@ -0,0 +1,25 @@
+#include "DuneSentinelGameInstance.h"
+#include "AutoPlaySubsystem.h"
+#include "Kismet/GameplayStatics.h"
+
+void UDuneSentinelGameInstance::Init()
+{
+	Super::Init();
+
+	UAutoPlaySubsystem* AP = GetSubsystem<UAutoPlaySubsystem>();
+	if (AP && AP->IsAutoPlay())
+	{
+		AP->StartScenario = [this](int32 Scenario)
+		{
+			PendingScenario = Scenario;
+			if (ScenarioMaps.IsValidIndex(Scenario - 1))
+			{
+				UGameplayStatics::OpenLevel(this, FName(*ScenarioMaps[Scenario - 1]), true, FString::Printf(TEXT("Scenario=%d"), Scenario));
+			}
+			else if (UAutoPlaySubsystem* Sub = GetSubsystem<UAutoPlaySubsystem>())
+			{
+				Sub->FinishRun(TEXT("error"), 0.0, FString::Printf(TEXT("\"reason\":\"no map for scenario %d\""), Scenario));
+			}
+		};
+	}
+}
diff --git a/Source/DuneSentinel/DuneSentinelGameInstance.h b/Source/DuneSentinel/DuneSentinelGameInstance.h
new file mode 100644
index 0000000000000000000000000000000000000000..9a787b75b86773db6bb1adbfcd1c072b1767c01a
--- /dev/null
+++ b/Source/DuneSentinel/DuneSentinelGameInstance.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Engine/GameInstance.h"
+#include "DuneSentinelGameInstance.generated.h"
+
+/**
+ * Game instance. Wires the AutoPlay drop-in (AutoPlay/AutoPlaySubsystem.h, contract v1.4): when the game is started
+ * with -AutoPlay -Scenario=N, StartScenario opens scenario N's map. The game mode then applies the start state, calls
+ * UAutoPlaySubsystem::ScenarioStarted(<display name>) once the player has control, spawns the bot (which acts only
+ * through UAutoPlaySubsystem::Inject) and calls FinishRun("win"/"lose", Score) at the end.
+ */
+UCLASS(Config = Game)
+class UDuneSentinelGameInstance : public UGameInstance
+{
+	GENERATED_BODY()
+
+public:
+	virtual void Init() override;
+
+	/** Map per scenario, index 0 = scenario 1 (Config/DefaultGame.ini: +ScenarioMaps=/Game/Maps/L_Example). */
+	UPROPERTY(Config, EditDefaultsOnly, Category = "Scenarios")
+	TArray<FString> ScenarioMaps;
+
+	/** Scenario the current map was opened for (0 = normal play). */
+	UPROPERTY(Transient, BlueprintReadOnly, Category = "Scenarios")
+	int32 PendingScenario = 0;
+};
