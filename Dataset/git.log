diff --git a/Source/DuneSentinel/DSEnemyAircraft.cpp b/Source/DuneSentinel/DSEnemyAircraft.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a80bd2d774d5c1c22488ed1cfc8d0b47d7bce09a
--- /dev/null
+++ b/Source/DuneSentinel/DSEnemyAircraft.cpp
@@ -0,0 +1,158 @@
+#include "DSEnemyAircraft.h"
+#include "DSGameMode.h"
+#include "DSFlightPawn.h"
+#include "DSProjectile.h"
+#include "DSImpactFX.h"
+#include "Components/SphereComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Engine/StaticMesh.h"
+#include "Kismet/GameplayStatics.h"
+#include "UObject/ConstructorHelpers.h"
+
+ADSEnemyAircraft::ADSEnemyAircraft()
+{
+    PrimaryActorTick.bCanEverTick = true;
+    Collision = CreateDefaultSubobject<USphereComponent>(TEXT("TargetCollision"));
+    SetRootComponent(Collision);
+    Collision->InitSphereRadius(1050.f);
+    Collision->SetCollisionProfileName(TEXT("BlockAllDynamic"));
+    Collision->SetCollisionResponseToChannel(ECC_Pawn, ECR_Ignore);
+    Mesh = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Airframe"));
+    Mesh->SetupAttachment(Collision);
+    Mesh->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+}
+
+void ADSEnemyAircraft::Initialize(bool Bomber, const FVector& Destination)
+{
+    bBomber = Bomber;
+    Objective = Destination;
+    Health = bBomber ? 240.f : 65.f;
+    Speed = bBomber ? 170.f : 235.f;
+    const TCHAR* Path = bBomber ? TEXT("/Game/Art/Aircraft/SM_bomber.SM_bomber") : TEXT("/Game/Art/Aircraft/SM_hostile.SM_hostile");
+    Mesh->SetStaticMesh(LoadObject<UStaticMesh>(nullptr, Path));
+    GunCooldown = FMath::FRandRange(.3f, 2.f);
+    MissileCooldown = FMath::FRandRange(8.f, 16.f);
+}
+
+void ADSEnemyAircraft::Tick(float Dt)
+{
+    Super::Tick(Dt);
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode || Mode->Phase != EDSPhase::Flying || bDying) return;
+    LifeTime += Dt;
+    GunCooldown -= Dt;
+    MissileCooldown -= Dt;
+    FVector Aim = Objective;
+    ADSFlightPawn* Player = Mode->Player;
+    const FVector Pos = GetActorLocation();
+    const float PlayerDist = IsValid(Player) ? FVector::Dist(Pos, Player->GetActorLocation()) : BIG_NUMBER;
+    if (!bBomber && IsValid(Player))
+    {
+        Aim = Player->GetActorLocation() + Player->GetActorForwardVector() * Player->Speed * 100.f * FMath::Clamp(PlayerDist / 60000.f, .1f, 2.f);
+        if (PlayerDist < 18000.f) Aim = Pos + GetActorForwardVector() * 160000.f + FVector(0,0,30000.f);
+    }
+    if (bBomber && !bEgress)
+    {
+        Aim.Z = Objective.Z + 65000.f;
+        if (FVector::Dist2D(Pos, Objective) < 210000.f)
+        {
+            BombCooldown -= Dt;
+            if (BombCooldown <= 0.f && BombsDropped < 3)
+            {
+                ADSBomb* Bomb = GetWorld()->SpawnActor<ADSBomb>(Pos - FVector(0,0,400), FRotator(-70, GetActorRotation().Yaw, 0));
+                if (Bomb) Bomb->Velocity = GetActorForwardVector() * Speed * 100.f;
+                ++BombsDropped;
+                BombCooldown = .8f;
+                if (BombsDropped == 1) Mode->Radio(TEXT("AIRFIELD: Bombs inbound. Intercept the next formation."));
+            }
+            if (BombsDropped >= 3)
+            {
+                bEgress = true;
+                Objective = Pos + GetActorForwardVector() * 1800000.f + FVector(0,0,100000.f);
+                Aim = Objective;
+            }
+        }
+    }
+    FRotator Desired = (Aim - Pos).Rotation();
+    const float YawError = FMath::FindDeltaAngleDegrees(GetActorRotation().Yaw, Desired.Yaw);
+    Desired.Roll = FMath::Clamp(YawError * (bBomber ? .5f : 1.3f), -65.f, 65.f);
+    FRotator NewRot = FMath::RInterpConstantTo(GetActorRotation(), Desired, Dt, bBomber ? 14.f : 30.f);
+    SetActorRotation(NewRot);
+    SetActorLocation(Pos + GetActorForwardVector() * Speed * 100.f * Dt);
+    if (IsValid(Player))
+    {
+        const FVector TowardPlayer = (Player->GetActorLocation() - Pos).GetSafeNormal();
+        const float Facing = FVector::DotProduct(GetActorForwardVector(), TowardPlayer);
+        if (PlayerDist < (bBomber ? 95000.f : 180000.f) && (bBomber || Facing > .94f) && GunCooldown <= 0.f)
+        {
+            FRotator ShotRot = TowardPlayer.Rotation();
+            ShotRot.Pitch += FMath::FRandRange(-1.5f,1.5f);
+            ShotRot.Yaw += FMath::FRandRange(-1.5f,1.5f);
+            ADSProjectile* Shot = GetWorld()->SpawnActor<ADSProjectile>(Pos + TowardPlayer * 1300.f, ShotRot);
+            if (Shot) Shot->Initialize(this, Player, false, false, bBomber ? 4.f : 5.f, 1100.f);
+            GunCooldown = bBomber ? .4f : .22f;
+        }
+        if (!bBomber && PlayerDist < 450000.f && PlayerDist > 70000.f && Facing > .85f && MissileCooldown <= 0.f)
+        {
+            ADSProjectile* Missile = GetWorld()->SpawnActor<ADSProjectile>(Pos + GetActorForwardVector()*1500.f, GetActorRotation());
+            if (Missile) Missile->Initialize(this, Player, false, true, 25.f, 650.f);
+            MissileCooldown = 14.f;
+            Mode->Radio(TEXT("SENTINEL: Incoming missile. Break and change altitude."), 3.f);
+            Mode->PlayCue(TEXT("lock"), .4f);
+        }
+    }
+    if ((bEgress && FVector::Dist2D(GetActorLocation(), Mode->AirportLocation) > Mode->ArenaHalfExtent*1.35f) || LifeTime > 420.f)
+    {
+        bDying = true;
+        Mode->RegisterKill(this, false);
+        Destroy();
+    }
+}
+
+void ADSEnemyAircraft::ApplyCombatDamage(float Damage, bool bPlayerOwned)
+{
+    if (bDying || Damage <= 0.f) return;
+    Health = FMath::Max(0.f, Health-Damage);
+    if (Health <= 0.f)
+    {
+        bDying = true;
+        if (ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>())
+        {
+            Mode->RegisterKill(this, bPlayerOwned);
+            Mode->PlayCue(TEXT("explosion"), .65f);
+        }
+        SetActorEnableCollision(false);
+        GetWorld()->SpawnActor<ADSImpactFX>(GetActorLocation(), FRotator::ZeroRotator);
+        Mesh->SetVisibility(false);
+        SetLifeSpan(.1f);
+    }
+}
+
+ADSBomb::ADSBomb()
+{
+    PrimaryActorTick.bCanEverTick=true;
+    Mesh=CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Bomb"));
+    SetRootComponent(Mesh);
+    Mesh->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    static ConstructorHelpers::FObjectFinder<UStaticMesh> Model(TEXT("/Game/Art/Effects/SM_missile.SM_missile"));
+    if (Model.Succeeded()) Mesh->SetStaticMesh(Model.Object);
+}
+
+void ADSBomb::Tick(float Dt)
+{
+    Super::Tick(Dt);
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode || Mode->Phase != EDSPhase::Flying) return;
+    Age += Dt;
+    Velocity.Z -= 981.f * Dt;
+    SetActorLocation(GetActorLocation()+Velocity*Dt);
+    SetActorRotation(Velocity.Rotation());
+    if (GetActorLocation().Z <= Mode->GroundHeightAt(GetActorLocation())+100.f)
+    {
+        if (FVector::Dist2D(GetActorLocation(),Mode->AirportLocation)<180000.f) Mode->DamageAirport(300.f);
+        Mode->PlayCue(TEXT("explosion"), .5f);
+        GetWorld()->SpawnActor<ADSImpactFX>(GetActorLocation(), FRotator::ZeroRotator);
+        Destroy();
+    }
+    else if (Age > 40.f) Destroy();
+}
diff --git a/Source/DuneSentinel/DSEnemyAircraft.h b/Source/DuneSentinel/DSEnemyAircraft.h
new file mode 100644
index 0000000000000000000000000000000000000000..9ae3da86c9797e7edf9f15ca524503d8cbecb8e4
--- /dev/null
+++ b/Source/DuneSentinel/DSEnemyAircraft.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "CoreMinimal.h"
+#include "GameFramework/Actor.h"
+#include "DSEnemyAircraft.generated.h"
+
+class UStaticMeshComponent;
+class USphereComponent;
+UCLASS()
+class DUNESENTINEL_API ADSEnemyAircraft : public AActor
+{
+    GENERATED_BODY()
+public:
+    ADSEnemyAircraft();
+    virtual void Tick(float DeltaSeconds) override;
+    virtual FVector GetVelocity() const override { return bDying ? FVector::ZeroVector : GetActorForwardVector()*Speed*100.f; }
+    void Initialize(bool Bomber, const FVector& Destination);
+    void ApplyCombatDamage(float Damage, bool bPlayerOwned);
+    UPROPERTY(BlueprintReadOnly) bool bBomber = false;
+    UPROPERTY(BlueprintReadOnly) bool bDying = false;
+    UPROPERTY(BlueprintReadOnly) float Health = 65.f;
+    UPROPERTY(BlueprintReadOnly) float Speed = 220.f;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<USphereComponent> Collision;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UStaticMeshComponent> Mesh;
+    bool bEgress = false;
+private:
+    FVector Objective;
+    float GunCooldown = 1.f;
+    float MissileCooldown = 5.f;
+    float BombCooldown = 0.f;
+    float LifeTime = 0.f;
+    int32 BombsDropped = 0;
+};
+
+UCLASS()
+class DUNESENTINEL_API ADSBomb : public AActor
+{
+    GENERATED_BODY()
+public:
+    ADSBomb();
+    virtual void Tick(float DeltaSeconds) override;
+    FVector Velocity = FVector::ZeroVector;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UStaticMeshComponent> Mesh;
+private:
+    float Age = 0.f;
+};
diff --git a/Source/DuneSentinel/DSFlightPawn.cpp b/Source/DuneSentinel/DSFlightPawn.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..33078aba113283bc9599e49a78c8a33e8dc05ea9
--- /dev/null
+++ b/Source/DuneSentinel/DSFlightPawn.cpp
@@ -0,0 +1,504 @@
+#include "DSFlightPawn.h"
+
+#include "DSGameMode.h"
+#include "DSEnemyAircraft.h"
+#include "DSPlayerController.h"
+#include "DSProjectile.h"
+#include "AutoPlay/AutoPlaySubsystem.h"
+#include "Camera/CameraComponent.h"
+#include "Components/SphereComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Components/AudioComponent.h"
+#include "Engine/LocalPlayer.h"
+#include "Engine/StaticMesh.h"
+#include "Engine/World.h"
+#include "EnhancedInputComponent.h"
+#include "EnhancedInputSubsystems.h"
+#include "GameFramework/SpringArmComponent.h"
+#include "InputAction.h"
+#include "InputMappingContext.h"
+#include "InputModifiers.h"
+#include "Kismet/GameplayStatics.h"
+#include "Sound/SoundBase.h"
+
+ADSFlightPawn::ADSFlightPawn()
+{
+    PrimaryActorTick.bCanEverTick = true;
+    Collision = CreateDefaultSubobject<USphereComponent>(TEXT("FlightCollision"));
+    Collision->InitSphereRadius(430.f);
+    Collision->SetCollisionProfileName(TEXT("Pawn"));
+    Collision->SetCollisionResponseToChannel(ECC_Camera, ECR_Ignore);
+    Collision->SetCollisionResponseToChannel(ECC_Visibility, ECR_Block);
+    SetRootComponent(Collision);
+    AircraftMesh = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Aircraft"));
+    AircraftMesh->SetupAttachment(Collision);
+    AircraftMesh->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    LandingGear = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("LandingGear"));
+    LandingGear->SetupAttachment(AircraftMesh);
+    LandingGear->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    CameraArm = CreateDefaultSubobject<USpringArmComponent>(TEXT("ChaseArm"));
+    CameraArm->SetupAttachment(Collision);
+    CameraArm->TargetArmLength = 5800.f;
+    CameraArm->SocketOffset = FVector(0.f, 0.f, 850.f);
+    CameraArm->bDoCollisionTest = false;
+    CameraArm->SetUsingAbsoluteRotation(true);
+    CameraArm->bUsePawnControlRotation = false;
+    Camera = CreateDefaultSubobject<UCameraComponent>(TEXT("FlightCamera"));
+    Camera->SetupAttachment(CameraArm, USpringArmComponent::SocketName);
+    Camera->FieldOfView = 78.f;
+    EngineAudio = CreateDefaultSubobject<UAudioComponent>(TEXT("EngineLoop"));
+    EngineAudio->SetupAttachment(Collision);
+    EngineAudio->bAutoActivate = false;
+    EngineAudio->bAllowSpatialization = false;
+    EngineAudio->SetVolumeMultiplier(.09f);
+    WindAudio = CreateDefaultSubobject<UAudioComponent>(TEXT("WindLoop"));
+    WindAudio->SetupAttachment(Collision);
+    WindAudio->bAutoActivate = false;
+    WindAudio->bAllowSpatialization = false;
+    WindAudio->SetVolumeMultiplier(0.f);
+    bUseControllerRotationPitch = false;
+    bUseControllerRotationYaw = false;
+    bUseControllerRotationRoll = false;
+}
+
+void ADSFlightPawn::BeginPlay()
+{
+    Super::BeginPlay();
+    MakeInputActions();
+    ConfigureAircraft(Spec);
+    CameraOrientation = GetActorQuat();
+    if (!bFlying) Park();
+    if (USoundBase* Sound = LoadObject<USoundBase>(nullptr, TEXT("/Game/Audio/S_engine.S_engine")))
+    {
+        EngineAudio->SetSound(Sound);
+        EngineAudio->SetPitchMultiplier(EnginePitch);
+        EngineAudio->Play();
+    }
+    if (USoundBase* Sound = LoadObject<USoundBase>(nullptr, TEXT("/Game/Audio/S_wind.S_wind")))
+    {
+        WindAudio->SetSound(Sound);
+    }
+}
+
+void ADSFlightPawn::MakeInputActions()
+{
+    if (FlightMapping) return;
+    FlightMapping = NewObject<UInputMappingContext>(this, TEXT("FlightKeyboardMouse"));
+    auto Action = [this](const TCHAR* Name, EInputActionValueType Type)
+    {
+        UInputAction* Result = NewObject<UInputAction>(this, FName(*(FString(TEXT("IA_")) + Name)));
+        Result->ValueType = Type;
+        return Result;
+    };
+    PitchAction = Action(TEXT("FlightPitch"), EInputActionValueType::Axis1D);
+    RollAction = Action(TEXT("FlightRoll"), EInputActionValueType::Axis1D);
+    YawAction = Action(TEXT("FlightYaw"), EInputActionValueType::Axis1D);
+    YawLeftAction = Action(TEXT("FlightYawLeft"), EInputActionValueType::Axis1D);
+    YawRightAction = Action(TEXT("FlightYawRight"), EInputActionValueType::Axis1D);
+    ThrottleAction = Action(TEXT("FlightThrottle"), EInputActionValueType::Axis1D);
+    BrakeAction = Action(TEXT("FlightBrake"), EInputActionValueType::Axis1D);
+    GunAction = Action(TEXT("FlightGun"), EInputActionValueType::Boolean);
+    MissileAction = Action(TEXT("FlightMissile"), EInputActionValueType::Boolean);
+    TargetAction = Action(TEXT("FlightNextTarget"), EInputActionValueType::Boolean);
+    MousePitchAction = Action(TEXT("FlightMousePitch"), EInputActionValueType::Axis1D);
+    MouseRollAction = Action(TEXT("FlightMouseRoll"), EInputActionValueType::Axis1D);
+    LookAction = Action(TEXT("FlightLookTarget"), EInputActionValueType::Boolean);
+    FreeLookAction = Action(TEXT("FlightFreeLook"), EInputActionValueType::Boolean);
+    CameraAction = Action(TEXT("FlightCamera"), EInputActionValueType::Boolean);
+    auto Map = [this](UInputAction* Input, FKey Key, bool bNegative = false)
+    {
+        FEnhancedActionKeyMapping& Mapping = FlightMapping->MapKey(Input, Key);
+        if (bNegative) Mapping.Modifiers.Add(NewObject<UInputModifierNegate>(FlightMapping));
+    };
+    Map(PitchAction, EKeys::Down); Map(PitchAction, EKeys::Up, true);
+    Map(RollAction, EKeys::D); Map(RollAction, EKeys::A, true);
+    Map(YawRightAction, EKeys::E); Map(YawLeftAction, EKeys::Q);
+    Map(ThrottleAction, EKeys::W); Map(BrakeAction, EKeys::S);
+    Map(GunAction, EKeys::LeftMouseButton); Map(GunAction, EKeys::LeftControl);
+    Map(MissileAction, EKeys::RightMouseButton); Map(MissileAction, EKeys::SpaceBar);
+    Map(TargetAction, EKeys::Tab); Map(LookAction, EKeys::F);
+    Map(FreeLookAction, EKeys::LeftAlt); Map(CameraAction, EKeys::V);
+    Map(MousePitchAction, EKeys::MouseY); Map(MouseRollAction, EKeys::MouseX);
+}
+
+void ADSFlightPawn::InstallInputContext()
+{
+    if (bContextInstalled) return;
+    MakeInputActions();
+    if (APlayerController* PC = Cast<APlayerController>(GetController()))
+    {
+        if (ULocalPlayer* LocalPlayer = PC->GetLocalPlayer())
+        {
+            if (UEnhancedInputLocalPlayerSubsystem* Input = LocalPlayer->GetSubsystem<UEnhancedInputLocalPlayerSubsystem>())
+            {
+                Input->AddMappingContext(FlightMapping, 0);
+                bContextInstalled = true;
+            }
+        }
+    }
+}
+
+void ADSFlightPawn::SetupPlayerInputComponent(UInputComponent* PlayerInputComponent)
+{
+    Super::SetupPlayerInputComponent(PlayerInputComponent);
+    MakeInputActions();
+    UEnhancedInputComponent* Input = Cast<UEnhancedInputComponent>(PlayerInputComponent);
+    if (!Input) return;
+    auto BindContinuous = [this, Input](UInputAction* Action, auto Function)
+    {
+        Input->BindAction(Action, ETriggerEvent::Triggered, this, Function);
+        Input->BindAction(Action, ETriggerEvent::Completed, this, Function);
+        Input->BindAction(Action, ETriggerEvent::Canceled, this, Function);
+    };
+    BindContinuous(PitchAction, &ADSFlightPawn::OnPitch);
+    BindContinuous(RollAction, &ADSFlightPawn::OnRoll);
+    BindContinuous(YawAction, &ADSFlightPawn::OnYaw);
+    BindContinuous(YawLeftAction, &ADSFlightPawn::OnYawLeft);
+    BindContinuous(YawRightAction, &ADSFlightPawn::OnYawRight);
+    BindContinuous(ThrottleAction, &ADSFlightPawn::OnThrottle);
+    BindContinuous(BrakeAction, &ADSFlightPawn::OnBrake);
+    BindContinuous(GunAction, &ADSFlightPawn::OnGun);
+    BindContinuous(MousePitchAction, &ADSFlightPawn::OnMousePitch);
+    BindContinuous(MouseRollAction, &ADSFlightPawn::OnMouseRoll);
+    BindContinuous(LookAction, &ADSFlightPawn::OnLook);
+    BindContinuous(FreeLookAction, &ADSFlightPawn::OnFreeLook);
+    BindContinuous(TargetAction, &ADSFlightPawn::OnTargetHeld);
+    Input->BindAction(MissileAction, ETriggerEvent::Started, this, &ADSFlightPawn::OnMissile);
+    Input->BindAction(TargetAction, ETriggerEvent::Started, this, &ADSFlightPawn::OnTarget);
+    Input->BindAction(CameraAction, ETriggerEvent::Started, this, &ADSFlightPawn::OnCamera);
+    InstallInputContext();
+}
+
+void ADSFlightPawn::EndPlay(const EEndPlayReason::Type Reason)
+{
+    EngineAudio->Stop();
+    WindAudio->Stop();
+    if (APlayerController* PC = Cast<APlayerController>(GetController()))
+    {
+        if (ULocalPlayer* LocalPlayer = PC->GetLocalPlayer())
+            if (UEnhancedInputLocalPlayerSubsystem* Input = LocalPlayer->GetSubsystem<UEnhancedInputLocalPlayerSubsystem>())
+                Input->RemoveMappingContext(FlightMapping);
+    }
+    Super::EndPlay(Reason);
+}
+
+void ADSFlightPawn::OnPitch(const FInputActionValue& Value) { PitchInput = Value.Get<float>(); }
+void ADSFlightPawn::OnRoll(const FInputActionValue& Value) { RollInput = Value.Get<float>(); }
+void ADSFlightPawn::OnYaw(const FInputActionValue& Value) { YawInput = Value.Get<float>(); }
+void ADSFlightPawn::OnThrottle(const FInputActionValue& Value) { ThrottleInput = Value.Get<float>(); }
+void ADSFlightPawn::OnBrake(const FInputActionValue& Value) { BrakeInput = Value.Get<float>(); }
+void ADSFlightPawn::OnGun(const FInputActionValue& Value) { bGunHeld = Value.Get<bool>(); }
+void ADSFlightPawn::OnMissile(const FInputActionValue& Value) { if (Value.Get<bool>()) FireMissile(); }
+void ADSFlightPawn::OnTarget(const FInputActionValue& Value) { if (bFlying && Value.Get<bool>()) SelectNextTarget(); }
+void ADSFlightPawn::OnTargetHeld(const FInputActionValue& Value) { bTargetHeld = Value.Get<bool>(); if (!bTargetHeld) TargetHoldTime = 0.f; }
+void ADSFlightPawn::OnYawLeft(const FInputActionValue& Value) { YawLeftInput = Value.Get<float>(); }
+void ADSFlightPawn::OnYawRight(const FInputActionValue& Value) { YawRightInput = Value.Get<float>(); }
+void ADSFlightPawn::OnMousePitch(const FInputActionValue& Value) { MousePitchInput = Value.Get<float>(); }
+void ADSFlightPawn::OnMouseRoll(const FInputActionValue& Value) { MouseRollInput = Value.Get<float>(); }
+void ADSFlightPawn::OnLook(const FInputActionValue& Value) { bLookingAtTarget = Value.Get<bool>(); }
+void ADSFlightPawn::OnFreeLook(const FInputActionValue& Value) { bFreeLooking = Value.Get<bool>(); }
+void ADSFlightPawn::OnCamera(const FInputActionValue& Value)
+{
+    if (bFlying && Value.Get<bool>()) bCockpitView = !bCockpitView;
+}
+
+void ADSFlightPawn::ResetControls()
+{
+    PitchInput = RollInput = YawInput = ThrottleInput = BrakeInput = 0.f;
+    YawLeftInput = YawRightInput = TargetHoldTime = 0.f;
+    MousePitchInput = MouseRollInput = 0.f;
+    bGunHeld = bLookingAtTarget = bFreeLooking = bTargetHeld = false;
+    AngularRates = FVector::ZeroVector;
+    FreeLookRotation = FRotator::ZeroRotator;
+}
+
+void ADSFlightPawn::ConfigureAircraft(const FDSAircraftSpec& Aircraft)
+{
+    Spec = Aircraft;
+    Health = FMath::Max(1.f, Spec.MaxHealth);
+    CannonAmmo = FMath::Max(0, Spec.Cannon);
+    MissileAmmo = FMath::Max(0, Spec.Missiles);
+    if (UStaticMesh* Model = LoadObject<UStaticMesh>(nullptr, *Spec.MeshPath))
+        AircraftMesh->SetStaticMesh(Model);
+    if (UStaticMesh* Gear = LoadObject<UStaticMesh>(nullptr, TEXT("/Game/Art/Aircraft/SM_landinggear.SM_landinggear")))
+        LandingGear->SetStaticMesh(Gear);
+    Target.Reset();
+    LockProgress = 0.f;
+}
+
+void ADSFlightPawn::Park()
+{
+    bFlying = false;
+    Speed = 0.f;
+    FlightVelocity = FVector::ZeroVector;
+    Collision->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    LandingGear->SetVisibility(true);
+    bCockpitView = bHighG = bStalling = bMissileWarning = false;
+    GunCooldown = MissileCooldown = GunSoundCooldown = 0.f;
+    Target.Reset();
+    LockProgress = 0.f;
+    ResetControls();
+}
+
+void ADSFlightPawn::BeginFlight()
+{
+    ResetControls();
+    bFlying = true;
+    Speed = Spec.CruiseSpeed;
+    bCockpitView = false;
+    BoundaryTime = 0.f;
+    MissileThreatUntil = 0.f;
+    Collision->SetCollisionEnabled(ECollisionEnabled::QueryOnly);
+    LandingGear->SetVisibility(false);
+    CameraOrientation = GetActorQuat();
+    InstallInputContext();
+    SelectNextTarget();
+}
+
+FVector ADSFlightPawn::GetVelocity() const { return FlightVelocity; }
+
+void ADSFlightPawn::Tick(float DeltaSeconds)
+{
+    Super::Tick(DeltaSeconds);
+    InstallInputContext();
+    if (const ADSPlayerController* PC = Cast<ADSPlayerController>(GetController()))
+    {
+        MouseSensitivity = FMath::Clamp(PC->MouseSensitivity, .1f, 4.f);
+        bInvertMouseY = PC->bInvertMouse;
+    }
+    GunCooldown = FMath::Max(0.f, GunCooldown - DeltaSeconds);
+    MissileCooldown = FMath::Max(0.f, MissileCooldown - DeltaSeconds);
+    GunSoundCooldown = FMath::Max(0.f, GunSoundCooldown - DeltaSeconds);
+    bMissileWarning = bFlying && GetWorld()->GetTimeSeconds() < MissileThreatUntil;
+    const ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    const bool bAudibleFlight = bFlying && Health > 0.f && Mode && Mode->Phase == EDSPhase::Flying;
+    const float SpeedFraction = FMath::Clamp(Speed / FMath::Max(Spec.MaxSpeed, 1.f), 0.f, 1.f);
+    EngineVolume = FMath::FInterpTo(EngineVolume, bAudibleFlight ? .13f + SpeedFraction * .08f : .065f, DeltaSeconds, 2.f);
+    WindVolume = FMath::FInterpTo(WindVolume, bAudibleFlight ? .025f + SpeedFraction * .09f : 0.f, DeltaSeconds, 2.f);
+    EnginePitch = FMath::FInterpTo(EnginePitch, bAudibleFlight ? .85f + SpeedFraction * .35f + ThrottleInput * .06f : .72f, DeltaSeconds, 1.5f);
+    EngineAudio->SetVolumeMultiplier(Health > 0.f ? EngineVolume : 0.f);
+    EngineAudio->SetPitchMultiplier(EnginePitch);
+    WindAudio->SetVolumeMultiplier(WindVolume);
+    if (bAudibleFlight && !WindAudio->IsPlaying()) WindAudio->Play();
+    else if (!bAudibleFlight && WindVolume < .001f && WindAudio->IsPlaying()) WindAudio->Stop();
+    if (bFlying && Health > 0.f && Mode && Mode->Phase == EDSPhase::Flying)
+    {
+        if (bTargetHeld) TargetHoldTime += DeltaSeconds;
+        UpdateFlight(DeltaSeconds);
+        UpdateTarget(DeltaSeconds);
+        if (bGunHeld) FireGun();
+    }
+    UpdateCamera(DeltaSeconds);
+}
+
+void ADSFlightPawn::UpdateFlight(float DeltaSeconds)
+{
+    const float Dt = DeltaSeconds;
+    // Mouse axes report per-frame deltas; normalize to a 60 Hz reference before
+    // feeding angular rates so physical mouse motion is independent of FPS.
+    const float MouseScale = MouseSensitivity * .12f / FMath::Max(Dt * 60.f, .001f);
+    const float MousePitch = bFreeLooking ? 0.f : MousePitchInput * MouseScale * (bInvertMouseY ? -1.f : 1.f);
+    const float MouseRoll = bFreeLooking ? 0.f : MouseRollInput * MouseScale;
+    const float Pitch = FMath::Clamp(PitchInput + MousePitch, -1.f, 1.f);
+    const float Roll = FMath::Clamp(RollInput + MouseRoll, -1.f, 1.f);
+    const float Yaw = FMath::Clamp(YawInput + YawRightInput - YawLeftInput, -1.f, 1.f);
+    bHighG = ThrottleInput > .5f && BrakeInput > .5f && Pitch > .1f && Speed > 90.f;
+    const float DesiredSpeed = ThrottleInput > .1f ? Spec.MaxSpeed : (BrakeInput > .1f ? 65.f : Spec.CruiseSpeed);
+    float Acceleration = FMath::Clamp((DesiredSpeed - Speed) * .35f, -65.f, 55.f);
+    if (bHighG) Acceleration = -75.f;
+    Acceleration -= GetActorForwardVector().Z * 12.f;
+    Speed = FMath::Clamp(Speed + Acceleration * Dt, 45.f, Spec.MaxSpeed);
+    bStalling = Speed < 95.f;
+    const float Authority = FMath::GetMappedRangeValueClamped(FVector2D(45.f, 140.f), FVector2D(.22f, 1.f), Speed);
+    const float HighGFactor = bHighG ? 1.8f : 1.f;
+    const FVector DesiredRates(Roll * Spec.RollRate * Authority, Pitch * Spec.PitchRate * Authority * HighGFactor, Yaw * 18.f * Authority);
+    AngularRates = FMath::VInterpTo(AngularRates, DesiredRates, Dt, 6.f);
+    const FQuat LocalRotation = FQuat(FVector::UpVector, FMath::DegreesToRadians(AngularRates.Z * Dt))
+        * FQuat(FVector::RightVector, FMath::DegreesToRadians(-AngularRates.Y * Dt))
+        * FQuat(FVector::ForwardVector, FMath::DegreesToRadians(-AngularRates.X * Dt));
+    SetActorRotation((GetActorQuat() * LocalRotation).GetNormalized());
+    if (YawLeftInput > .5f && YawRightInput > .5f)
+    {
+        const FQuat Level = FRotator(0.f, GetActorForwardVector().Rotation().Yaw, 0.f).Quaternion();
+        SetActorRotation(FQuat::Slerp(GetActorQuat(), Level, 1.f - FMath::Exp(-2.f * Dt)).GetNormalized());
+    }
+    FlightVelocity = GetActorForwardVector() * Speed * 100.f;
+    if (bStalling)
+    {
+        FlightVelocity.Z -= (95.f - Speed) * 150.f;
+        const FVector NoseDown = (GetActorForwardVector() + FVector(0.f, 0.f, -.25f * Dt)).GetSafeNormal();
+        const FQuat DownCorrection = FQuat::FindBetweenNormals(GetActorForwardVector(), NoseDown);
+        SetActorRotation((DownCorrection * GetActorQuat()).GetNormalized());
+    }
+    FHitResult Hit;
+    AddActorWorldOffset(FlightVelocity * Dt, true, &Hit);
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode) return;
+    if (Hit.bBlockingHit || GetActorLocation().Z < Mode->GroundHeightAt(GetActorLocation()) + 230.f)
+    {
+        ApplyCombatDamage(Health + 1.f);
+        return;
+    }
+    const FVector Position = GetActorLocation();
+    const bool bOutside = FMath::Abs(Position.X) > Mode->ArenaHalfExtent || FMath::Abs(Position.Y) > Mode->ArenaHalfExtent || Position.Z > 600000.f;
+    if (bOutside)
+    {
+        if (BoundaryTime == 0.f) Mode->Radio(TEXT("BOUNDARY WARNING / RETURN TO THE OPERATION ZONE"), 8.f);
+        BoundaryTime += Dt;
+        if (BoundaryTime > 15.f) Mode->EndSortie(TEXT("LEFT THE OPERATION ZONE"));
+    }
+    else BoundaryTime = 0.f;
+}
+
+void ADSFlightPawn::SelectNextTarget()
+{
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode) return;
+    TArray<ADSEnemyAircraft*> Candidates;
+    for (ADSEnemyAircraft* Enemy : Mode->Enemies)
+        if (IsValid(Enemy) && !Enemy->bDying && Enemy->Health > 0.f) Candidates.Add(Enemy);
+    Candidates.Sort([this](const ADSEnemyAircraft& A, const ADSEnemyAircraft& B)
+    {
+        return FVector::DistSquared(A.GetActorLocation(), GetActorLocation()) < FVector::DistSquared(B.GetActorLocation(), GetActorLocation());
+    });
+    const int32 Current = Candidates.IndexOfByKey(Target.Get());
+    Target = Candidates.IsEmpty() ? nullptr : Candidates[(Current + 1) % Candidates.Num()];
+    LockProgress = 0.f;
+    bLockSoundPlayed = false;
+}
+
+void ADSFlightPawn::UpdateTarget(float DeltaSeconds)
+{
+    if (!Target.IsValid() || Target->bDying || Target->Health <= 0.f) SelectNextTarget();
+    if (!Target.IsValid()) { LockProgress = 0.f; return; }
+    const FVector ToTarget = Target->GetActorLocation() - GetActorLocation();
+    const float Distance = ToTarget.Size();
+    const float Alignment = FVector::DotProduct(GetActorForwardVector(), ToTarget.GetSafeNormal());
+    bool bCanLock = Distance > 1500.f && Distance < 600000.f && Alignment > FMath::Cos(FMath::DegreesToRadians(16.f));
+    if (bCanLock)
+    {
+        FCollisionQueryParams Params(SCENE_QUERY_STAT(MissileLock), false, this);
+        Params.AddIgnoredActor(Target.Get());
+        FHitResult Hit;
+        bCanLock = !GetWorld()->LineTraceSingleByObjectType(Hit, GetActorLocation(), Target->GetActorLocation(), FCollisionObjectQueryParams(ECC_WorldStatic), Params);
+    }
+    LockProgress = bCanLock ? FMath::Min(1.f, LockProgress + DeltaSeconds * 1.25f) : 0.f;
+    if (LockProgress >= 1.f && !bLockSoundPlayed)
+    {
+        if (ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>()) Mode->PlayCue(TEXT("lock"), .65f);
+        bLockSoundPlayed = true;
+    }
+    if (LockProgress < .5f) bLockSoundPlayed = false;
+}
+
+void ADSFlightPawn::FireGun()
+{
+    if (!bFlying || CannonAmmo <= 0 || GunCooldown > 0.f) return;
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode || Mode->Phase != EDSPhase::Flying) return;
+    const FVector Muzzle = GetActorLocation() + GetActorForwardVector() * 1100.f - GetActorUpVector() * 45.f;
+    FActorSpawnParameters Params;
+    Params.Owner = this;
+    Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+    ADSProjectile* Shot = GetWorld()->SpawnActor<ADSProjectile>(Muzzle, GetActorRotation(), Params);
+    if (!Shot) return;
+    Shot->Initialize(this, nullptr, true, false, 8.f, 1450.f + Speed);
+    --CannonAmmo;
+    if (UAutoPlaySubsystem* AP = UAutoPlaySubsystem::Get(this); AP && AP->IsRunning())
+        AP->Telemetry(TEXT("weapon_fired"), FString::Printf(TEXT("\"weapon\":\"cannon\",\"ammo\":%d"), CannonAmmo));
+    GunCooldown = .055f;
+    if (GunSoundCooldown <= 0.f)
+    {
+        Mode->PlayCue(TEXT("gun"), .38f);
+        GunSoundCooldown = .12f;
+    }
+}
+
+void ADSFlightPawn::FireMissile()
+{
+    if (!bFlying || MissileAmmo <= 0 || MissileCooldown > 0.f) return;
+    if (!Target.IsValid() || Target->bDying || LockProgress < .99f) return;
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode || Mode->Phase != EDSPhase::Flying) return;
+    const FVector Muzzle = GetActorLocation() + GetActorForwardVector() * 700.f
+        + GetActorRightVector() * ((MissileAmmo % 2) ? 350.f : -350.f) - GetActorUpVector() * 100.f;
+    FActorSpawnParameters Params;
+    Params.Owner = this;
+    Params.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+    ADSProjectile* Shot = GetWorld()->SpawnActor<ADSProjectile>(Muzzle, GetActorRotation(), Params);
+    if (!Shot) return;
+    AActor* LockedTarget = LockProgress >= .99f && Target.IsValid() ? Target.Get() : nullptr;
+    Shot->Initialize(this, LockedTarget, true, true, 70.f, 760.f + Speed * .3f);
+    --MissileAmmo;
+    MissileCooldown = 1.2f;
+    if (UAutoPlaySubsystem* AP = UAutoPlaySubsystem::Get(this); AP && AP->IsRunning())
+        AP->Telemetry(TEXT("weapon_fired"), FString::Printf(TEXT("\"weapon\":\"missile\",\"ammo\":%d,\"locked\":true"), MissileAmmo));
+    Mode->PlayCue(TEXT("missile"), .7f);
+}
+
+void ADSFlightPawn::UpdateCamera(float DeltaSeconds)
+{
+    FRotator Desired;
+    float ArmLength = 5800.f;
+    FVector Offset(0.f, 0.f, 850.f);
+    if (!bFlying)
+    {
+        Desired = FRotator(-11.f, GetActorRotation().Yaw + 145.f, 0.f);
+        ArmLength = 4500.f;
+        Offset = FVector(0.f, 0.f, 450.f);
+    }
+    else
+    {
+        const FRotator FlightRotation = GetActorForwardVector().Rotation();
+        Desired = FRotator(FlightRotation.Pitch - 4.f, FlightRotation.Yaw, 0.f);
+        if (bFreeLooking)
+        {
+            FreeLookRotation.Yaw = FMath::Clamp(FreeLookRotation.Yaw + MouseRollInput * MouseSensitivity * .65f, -140.f, 140.f);
+            FreeLookRotation.Pitch = FMath::Clamp(FreeLookRotation.Pitch + MousePitchInput * MouseSensitivity * .65f, -65.f, 65.f);
+        }
+        else FreeLookRotation = FMath::RInterpTo(FreeLookRotation, FRotator::ZeroRotator, DeltaSeconds, 4.f);
+        Desired += FreeLookRotation;
+        if ((bLookingAtTarget || TargetHoldTime > .35f) && Target.IsValid())
+            Desired = (Target->GetActorLocation() - GetActorLocation()).Rotation();
+        if (bCockpitView)
+        {
+            ArmLength = 0.f;
+            Offset = FVector(1250.f, 0.f, 80.f);
+        }
+    }
+    const float Alpha = 1.f - FMath::Exp(-3.5f * DeltaSeconds);
+    CameraOrientation = FQuat::Slerp(CameraOrientation, Desired.Quaternion(), Alpha).GetNormalized();
+    CameraArm->SetWorldRotation(CameraOrientation);
+    CameraArm->TargetArmLength = FMath::FInterpTo(CameraArm->TargetArmLength, ArmLength, DeltaSeconds, 3.f);
+    CameraArm->SocketOffset = FMath::VInterpTo(CameraArm->SocketOffset, Offset, DeltaSeconds, 3.f);
+    const float DesiredFov = bFlying ? FMath::GetMappedRangeValueClamped(FVector2D(100.f, 460.f), FVector2D(76.f, 87.f), Speed) : 63.f;
+    Camera->SetFieldOfView(FMath::FInterpTo(Camera->FieldOfView, DesiredFov, DeltaSeconds, 2.f));
+    AircraftMesh->SetVisibility(!bCockpitView);
+}
+
+void ADSFlightPawn::ApplyCombatDamage(float Damage)
+{
+    if (!bFlying || Health <= 0.f || Damage <= 0.f) return;
+    Health = FMath::Max(0.f, Health - Damage);
+    if (ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>())
+    {
+        Mode->PlayCue(Health <= 0.f ? TEXT("explosion") : TEXT("hit"), .7f);
+        if (Health <= 0.f)
+        {
+            bGunHeld = false;
+            Mode->EndSortie(TEXT("AIRCRAFT LOST"));
+        }
+    }
+}
+
+void ADSFlightPawn::Rearm(int32 CannonCount, int32 MissileCount)
+{
+    CannonAmmo = FMath::Clamp(CannonAmmo + FMath::Max(0, CannonCount), 0, Spec.Cannon);
+    MissileAmmo = FMath::Clamp(MissileAmmo + FMath::Max(0, MissileCount), 0, Spec.Missiles);
+}
+
+void ADSFlightPawn::SetMissileThreat(float Seconds)
+{
+    MissileThreatUntil = FMath::Max(MissileThreatUntil, GetWorld()->GetTimeSeconds() + Seconds);
+    bMissileWarning = true;
+}
diff --git a/Source/DuneSentinel/DSFlightPawn.h b/Source/DuneSentinel/DSFlightPawn.h
new file mode 100644
index 0000000000000000000000000000000000000000..de3b33847ce73948c2e5569c1ccbd8a212cfb3db
--- /dev/null
+++ b/Source/DuneSentinel/DSFlightPawn.h
@@ -0,0 +1,133 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/Pawn.h"
+#include "InputActionValue.h"
+#include "DSGameTypes.h"
+#include "DSFlightPawn.generated.h"
+
+class UInputAction;
+class UInputMappingContext;
+class USphereComponent;
+class UStaticMeshComponent;
+class UCameraComponent;
+class USpringArmComponent;
+class UAudioComponent;
+class ADSEnemyAircraft;
+
+UCLASS()
+class DUNESENTINEL_API ADSFlightPawn : public APawn
+{
+    GENERATED_BODY()
+public:
+    ADSFlightPawn();
+    virtual void BeginPlay() override;
+    virtual void Tick(float DeltaSeconds) override;
+    virtual void SetupPlayerInputComponent(UInputComponent* PlayerInputComponent) override;
+    virtual FVector GetVelocity() const override;
+    virtual void EndPlay(const EEndPlayReason::Type EndPlayReason) override;
+
+    UPROPERTY(BlueprintReadOnly) float Health = 140.f;
+    UPROPERTY(BlueprintReadOnly) float Speed = 0.f;
+    UPROPERTY(BlueprintReadOnly) int32 CannonAmmo = 1200;
+    UPROPERTY(BlueprintReadOnly) int32 MissileAmmo = 16;
+    UPROPERTY(BlueprintReadOnly) FDSAircraftSpec Spec;
+    UPROPERTY(BlueprintReadOnly) TWeakObjectPtr<ADSEnemyAircraft> Target;
+    UPROPERTY(BlueprintReadOnly) float LockProgress = 0.f;
+    UPROPERTY(BlueprintReadOnly) bool bMissileWarning = false;
+    UPROPERTY(BlueprintReadOnly) bool bStalling = false;
+    UPROPERTY(BlueprintReadOnly) bool bHighG = false;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float MouseSensitivity = 1.f;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) bool bInvertMouseY = true;
+
+    UPROPERTY() TObjectPtr<UInputAction> PitchAction;
+    UPROPERTY() TObjectPtr<UInputAction> RollAction;
+    UPROPERTY() TObjectPtr<UInputAction> YawAction;
+    UPROPERTY() TObjectPtr<UInputAction> ThrottleAction;
+    UPROPERTY() TObjectPtr<UInputAction> BrakeAction;
+    UPROPERTY() TObjectPtr<UInputAction> GunAction;
+    UPROPERTY() TObjectPtr<UInputAction> MissileAction;
+    UPROPERTY() TObjectPtr<UInputAction> TargetAction;
+
+    void ConfigureAircraft(const FDSAircraftSpec& Aircraft);
+    void Park();
+    void BeginFlight();
+    void ApplyCombatDamage(float Damage);
+    void Rearm(int32 CannonCount, int32 MissileCount);
+    void ClearFlightInput() { ResetControls(); }
+    bool IsFlying() const { return bFlying; }
+    UCameraComponent* GetFlightCamera() const { return Camera; }
+    void SetMissileThreat(float Seconds = 1.5f);
+
+private:
+    UPROPERTY(VisibleAnywhere) TObjectPtr<USphereComponent> Collision;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UStaticMeshComponent> AircraftMesh;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UStaticMeshComponent> LandingGear;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<USpringArmComponent> CameraArm;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UCameraComponent> Camera;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UAudioComponent> EngineAudio;
+    UPROPERTY(VisibleAnywhere) TObjectPtr<UAudioComponent> WindAudio;
+    UPROPERTY() TObjectPtr<UInputMappingContext> FlightMapping;
+    UPROPERTY() TObjectPtr<UInputAction> MousePitchAction;
+    UPROPERTY() TObjectPtr<UInputAction> MouseRollAction;
+    UPROPERTY() TObjectPtr<UInputAction> LookAction;
+    UPROPERTY() TObjectPtr<UInputAction> FreeLookAction;
+    UPROPERTY() TObjectPtr<UInputAction> CameraAction;
+    UPROPERTY() TObjectPtr<UInputAction> YawLeftAction;
+    UPROPERTY() TObjectPtr<UInputAction> YawRightAction;
+    void MakeInputActions();
+    void InstallInputContext();
+    void OnPitch(const FInputActionValue& Value);
+    void OnRoll(const FInputActionValue& Value);
+    void OnYaw(const FInputActionValue& Value);
+    void OnThrottle(const FInputActionValue& Value);
+    void OnBrake(const FInputActionValue& Value);
+    void OnGun(const FInputActionValue& Value);
+    void OnMissile(const FInputActionValue& Value);
+    void OnTarget(const FInputActionValue& Value);
+    void OnTargetHeld(const FInputActionValue& Value);
+    void OnYawLeft(const FInputActionValue& Value);
+    void OnYawRight(const FInputActionValue& Value);
+    void OnMousePitch(const FInputActionValue& Value);
+    void OnMouseRoll(const FInputActionValue& Value);
+    void OnLook(const FInputActionValue& Value);
+    void OnFreeLook(const FInputActionValue& Value);
+    void OnCamera(const FInputActionValue& Value);
+    void ResetControls();
+    void UpdateFlight(float DeltaSeconds);
+    void UpdateTarget(float DeltaSeconds);
+    void UpdateCamera(float DeltaSeconds);
+    void FireGun();
+    void FireMissile();
+    void SelectNextTarget();
+    bool bFlying = false;
+    bool bGunHeld = false;
+    bool bLookingAtTarget = false;
+    bool bTargetHeld = false;
+    bool bFreeLooking = false;
+    bool bCockpitView = false;
+    bool bContextInstalled = false;
+    float PitchInput = 0.f;
+    float RollInput = 0.f;
+    float YawInput = 0.f;
+    float YawLeftInput = 0.f;
+    float YawRightInput = 0.f;
+    float TargetHoldTime = 0.f;
+    float ThrottleInput = 0.f;
+    float BrakeInput = 0.f;
+    float MousePitchInput = 0.f;
+    float MouseRollInput = 0.f;
+    FVector AngularRates = FVector::ZeroVector;
+    FVector FlightVelocity = FVector::ZeroVector;
+    FRotator FreeLookRotation = FRotator::ZeroRotator;
+    FQuat CameraOrientation = FQuat::Identity;
+    float GunCooldown = 0.f;
+    float MissileCooldown = 0.f;
+    float GunSoundCooldown = 0.f;
+    float MissileThreatUntil = 0.f;
+    float BoundaryTime = 0.f;
+    float EngineVolume = .09f;
+    float WindVolume = 0.f;
+    float EnginePitch = .75f;
+    bool bLockSoundPlayed = false;
+};
diff --git a/Source/DuneSentinel/DSGameMode.cpp b/Source/DuneSentinel/DSGameMode.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..24f31b0044e1c6a69ae2ccfa619045d20506bfd0
--- /dev/null
+++ b/Source/DuneSentinel/DSGameMode.cpp
@@ -0,0 +1,306 @@
+#include "DSGameMode.h"
+#include "DSFlightPawn.h"
+#include "DSEnemyAircraft.h"
+#include "DSProjectile.h"
+#include "DSHUD.h"
+#include "DSPlayerController.h"
+#include "DuneSentinelGameInstance.h"
+#include "AutoPlay/AutoPlaySubsystem.h"
+#include "Kismet/GameplayStatics.h"
+#include "EngineUtils.h"
+#include "Sound/SoundBase.h"
+#include "Misc/ConfigCacheIni.h"
+#include "InputActionValue.h"
+#include "Camera/PlayerCameraManager.h"
+#include "HighResScreenshot.h"
+#include "UnrealClient.h"
+#include "Misc/CommandLine.h"
+#include "Misc/Parse.h"
+
+ADSGameMode::ADSGameMode()
+{
+    PrimaryActorTick.bCanEverTick=true;
+    DefaultPawnClass=ADSFlightPawn::StaticClass();
+    PlayerControllerClass=ADSPlayerController::StaticClass();
+    HUDClass=ADSHUD::StaticClass();
+    FDSAircraftSpec Agile;
+    Agile.Name=TEXT("F-11 KESTREL"); Agile.Role=TEXT("INTERCEPTOR / AGILE");
+    Agile.MeshPath=TEXT("/Game/Art/Aircraft/SM_lancer.SM_lancer");
+    Agile.MaxHealth=100; Agile.Cannon=900; Agile.Missiles=12;
+    Agile.CruiseSpeed=250; Agile.MaxSpeed=430; Agile.PitchRate=55; Agile.RollRate=150;
+    Aircraft.Add(Agile);
+    FDSAircraftSpec Balanced;
+    Balanced.MeshPath=TEXT("/Game/Art/Aircraft/SM_mirage.SM_mirage");
+    Aircraft.Add(Balanced);
+    FDSAircraftSpec Heavy;
+    Heavy.Name=TEXT("F-37 OSPREY"); Heavy.Role=TEXT("STRIKE FIGHTER / ENDURANCE");
+    Heavy.MeshPath=TEXT("/Game/Art/Aircraft/SM_falcon.SM_falcon");
+    Heavy.MaxHealth=180; Heavy.Cannon=1600; Heavy.Missiles=20;
+    Heavy.CruiseSpeed=250; Heavy.MaxSpeed=500; Heavy.PitchRate=34; Heavy.RollRate=100;
+    Aircraft.Add(Heavy);
+}
+
+void ADSGameMode::BeginPlay()
+{
+    Super::BeginPlay();
+    Player=Cast<ADSFlightPawn>(UGameplayStatics::GetPlayerPawn(this,0));
+    if (APlayerController* PC=UGameplayStatics::GetPlayerController(this,0))
+    {
+        PC->AddTickPrerequisiteActor(this);
+        if(Player) Player->AddTickPrerequisiteActor(PC);
+    }
+    AirportHealth=AirportMaxHealth;
+    GConfig->GetInt(TEXT("DuneSentinel"),TEXT("HighScore"),HighScore,GGameUserSettingsIni);
+    UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this);
+    Random.Initialize(AP && AP->IsAutoPlay() ? AP->GetSeed() : FMath::Rand());
+    SelectAircraft(SelectedAircraft);
+    if (AP && AP->IsRunning())
+    {
+        StartSortie();
+        AP->ScenarioStarted(TEXT("Glass Horizon - Airfield Defense"));
+        bScenarioNotified=true;
+    }
+}
+
+void ADSGameMode::SelectAircraft(int32 Index)
+{
+    if (Phase!=EDSPhase::Menu || !Aircraft.IsValidIndex(Index)) return;
+    SelectedAircraft=Index;
+    if (Player)
+    {
+        Player->ConfigureAircraft(Aircraft[Index]);
+        Player->SetActorLocation(FVector(-28000,16000,2600));
+        Player->SetActorRotation(FRotator(0,18,0));
+        Player->Park();
+    }
+}
+
+void ADSGameMode::StartSortie()
+{
+    if (!Player) return;
+    const bool bRestart = Wave > 0;
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this); AP && AP->IsRunning() && bRestart)
+        AP->Telemetry(TEXT("restart"), TEXT("\"reason\":") + UAutoPlaySubsystem::JsonStr(Phase==EDSPhase::Defeat ? TEXT("retry_after_defeat") : TEXT("sortie_restart")));
+    UGameplayStatics::SetGamePaused(this,false);
+    for (TActorIterator<ADSEnemyAircraft> It(GetWorld());It;++It) It->Destroy();
+    for (TActorIterator<ADSProjectile> It(GetWorld());It;++It) It->Destroy();
+    for (TActorIterator<ADSBomb> It(GetWorld());It;++It) It->Destroy();
+    Enemies.Reset();
+    AirportHealth=AirportMaxHealth;
+    Elapsed=0; KillScore=0; Wave=0; NextWaveAt=WaveInterval;
+    SetMissionScore(0,bRestart ? TEXT("sortie_restart") : TEXT("sortie_start"));
+    RearmAccumulator=0; bRearming=false; DefeatReason.Empty();
+    StateTelemetryAccumulator=0.f;
+    Player->ConfigureAircraft(Aircraft[SelectedAircraft]);
+    Player->SetActorLocation(FVector(-160000,0,68000));
+    Player->SetActorRotation(FRotator(4,0,0));
+    Player->BeginFlight();
+    Phase=EDSPhase::Flying;
+    Radio(TEXT("TOWER: Evacuation convoy is moving. Keep this runway alive."),9.f);
+    SpawnWave();
+    if (APlayerController* PC=UGameplayStatics::GetPlayerController(this,0))
+        PC->PlayerCameraManager->StartCameraFade(1.f,0.f,1.25f,FLinearColor::Black,false,false);
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this))
+        AP->Telemetry(TEXT("sortie_started"),FString::Printf(TEXT("\"airframe\":%d,\"wave_interval\":%.1f"),SelectedAircraft,WaveInterval));
+    EmitStateTelemetry();
+}
+
+void ADSGameMode::ReturnToMenu()
+{
+    UGameplayStatics::SetGamePaused(this,false);
+    Phase=EDSPhase::Menu;
+    for (TActorIterator<ADSEnemyAircraft> It(GetWorld());It;++It) It->Destroy();
+    for (TActorIterator<ADSProjectile> It(GetWorld());It;++It) It->Destroy();
+    for (TActorIterator<ADSBomb> It(GetWorld());It;++It) It->Destroy();
+    Enemies.Reset();
+    bRearming=false;
+    RadioLine.Empty();
+    SelectAircraft(SelectedAircraft);
+}
+
+void ADSGameMode::Tick(float Dt)
+{
+    Super::Tick(Dt);
+    if (FParse::Param(FCommandLine::Get(),TEXT("CaptureFrames")))
+    {
+        CaptureElapsed+=Dt;
+        if (CaptureIndex<10 && CaptureElapsed>=3.f+CaptureIndex*8.f)
+        {
+            FScreenshotRequest::RequestScreenshot(FString::Printf(TEXT("DuneSentinel_%s_%02d.png"),Phase==EDSPhase::Menu?TEXT("Menu"):TEXT("Flight"),CaptureIndex),true,false);
+            ++CaptureIndex;
+        }
+    }
+    if (!Player) Player=Cast<ADSFlightPawn>(UGameplayStatics::GetPlayerPawn(this,0));
+    if (Phase!=EDSPhase::Flying) return;
+    Elapsed+=Dt;
+    SetMissionScore(KillScore+FMath::FloorToInt(Elapsed),TEXT("survival"));
+    if (Elapsed>=NextWaveAt)
+    {
+        SpawnWave();
+        NextWaveAt+=WaveInterval;
+    }
+    if (Elapsed>RadioUntil) RadioLine.Empty();
+    if (Player)
+    {
+        bRearming=FVector::Dist2D(Player->GetActorLocation(),AirportLocation)<100000.f && Player->GetActorLocation().Z-AirportLocation.Z<100000.f;
+        if (bRearming)
+        {
+            RearmAccumulator+=Dt;
+            if (RearmAccumulator>=1.f)
+            {
+                const int32 Ticks=FMath::FloorToInt(RearmAccumulator);
+                Player->Rearm(200*Ticks,2*Ticks);
+                RearmAccumulator-=Ticks;
+            }
+        }
+        else RearmAccumulator=0;
+        if (Player->Health<=0) EndSortie(TEXT("AIRCRAFT LOST"));
+    }
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this))
+    {
+        if (AP->IsRunning() && Player)
+        {
+            StateTelemetryAccumulator+=Dt;
+            if (StateTelemetryAccumulator>=.1f)
+            {
+                StateTelemetryAccumulator=FMath::Fmod(StateTelemetryAccumulator,.1f);
+                EmitStateTelemetry();
+            }
+        }
+        if (AP->IsRunning()) UpdateBot(Dt);
+    }
+}
+
+float ADSGameMode::SecondsToNextWave() const
+{
+    return FMath::Max(0.f,NextWaveAt-Elapsed);
+}
+
+void ADSGameMode::SpawnWave()
+{
+    ++Wave;
+    Enemies.RemoveAll([](ADSEnemyAircraft* Enemy){return !IsValid(Enemy) || Enemy->bDying;});
+    const int32 Fighters=FMath::Min(Random.RandRange(2,4)+(Wave-1)/2,8);
+    const int32 Bombers=FMath::Min(Random.RandRange(1,2)+(Wave-1)/3,4);
+    const float Heading=Random.FRandRange(0,2*PI);
+    for (int32 I=0;I<Fighters+Bombers && Enemies.Num()<24;++I)
+    {
+        const bool Bomber=I>=Fighters;
+        const float Angle=Heading+(I-(Fighters+Bombers)*.5f)*.065f;
+        FVector Pos(FMath::Cos(Angle)*850000.f,FMath::Sin(Angle)*850000.f,Bomber?100000.f:130000.f+I*6000);
+        const FRotator Facing=(AirportLocation+FVector(0,0,65000)-Pos).Rotation();
+        FActorSpawnParameters Params;
+        Params.SpawnCollisionHandlingOverride=ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+        ADSEnemyAircraft* Enemy=GetWorld()->SpawnActor<ADSEnemyAircraft>(Pos,Facing,Params);
+        if (Enemy) {Enemy->Initialize(Bomber,AirportLocation);Enemies.Add(Enemy);}
+    }
+    if (Wave>1) Radio(FString::Printf(TEXT("OVERWATCH: Wave %02d inbound. Prioritize the bombers."),Wave));
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this))
+        AP->Telemetry(TEXT("wave_spawned"),FString::Printf(TEXT("\"wave\":%d,\"fighters\":%d,\"bombers\":%d"),Wave,Fighters,Bombers));
+}
+
+void ADSGameMode::RegisterKill(ADSEnemyAircraft* Enemy,bool bPlayerKill)
+{
+    if (!Enemy || Phase!=EDSPhase::Flying || Enemies.Remove(Enemy)==0) return;
+    if (bPlayerKill)
+    {
+        const int32 Points=Enemy->bBomber?200:100;
+        KillScore+=Points;
+        SetMissionScore(KillScore+FMath::FloorToInt(Elapsed),Enemy->bBomber?TEXT("bomber_destroyed"):TEXT("fighter_destroyed"));
+        Radio(Enemy->bBomber?TEXT("OVERWATCH: Bomber destroyed. Airfield threat reduced. +200"):TEXT("SENTINEL: Splash one. +100"),3.f);
+        if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this))
+            AP->Telemetry(TEXT("enemy_destroyed"),FString::Printf(TEXT("\"bomber\":%s,\"points\":%d"),Enemy->bBomber?TEXT("true"):TEXT("false"),Points));
+    }
+}
+
+void ADSGameMode::DamageAirport(float Damage)
+{
+    if (Phase!=EDSPhase::Flying || Damage<=0.f) return;
+    AirportHealth=FMath::Clamp(AirportHealth-Damage,0.f,AirportMaxHealth);
+    Radio(TEXT("TOWER: Runway perimeter hit. We need air cover!"),5.f);
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this))
+        AP->Telemetry(TEXT("airport_damaged"),FString::Printf(TEXT("\"health\":%.1f,\"damage\":%.1f"),AirportHealth,Damage));
+    if (AirportHealth<=0.f) EndSortie(TEXT("AIRFIELD DESTROYED"));
+}
+
+void ADSGameMode::EndSortie(const FString& Reason)
+{
+    if (Phase!=EDSPhase::Flying) return;
+    Phase=EDSPhase::Defeat;
+    DefeatReason=Reason;
+    bRearming=false;
+    HighScore=FMath::Max(HighScore,Score);
+    if (GetWorld()->HasBegunPlay())
+    {
+        GConfig->SetInt(TEXT("DuneSentinel"),TEXT("HighScore"),HighScore,GGameUserSettingsIni);
+        GConfig->Flush(false,GGameUserSettingsIni);
+    }
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this); AP && AP->IsRunning())
+    {
+        EmitStateTelemetry();
+        AP->FinishRun(TEXT("lose"),Score,TEXT("\"reason\":")+UAutoPlaySubsystem::JsonStr(Reason));
+    }
+}
+
+void ADSGameMode::SetMissionScore(int32 NewScore,const TCHAR* Reason)
+{
+    if (NewScore==Score) return;
+    const int32 Delta=NewScore-Score;
+    Score=NewScore;
+    if (UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this))
+    {
+        AP->SetScore(Score);
+        if (AP->IsRunning())
+            AP->Telemetry(TEXT("score"),FString::Printf(TEXT("\"score\":%d,\"delta\":%d,\"reason\":%s,\"wave\":%d"),Score,Delta,*UAutoPlaySubsystem::JsonStr(Reason),Wave));
+    }
+}
+
+void ADSGameMode::EmitStateTelemetry()
+{
+    UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this);
+    if (!AP || !AP->IsRunning() || !Player) return;
+    const FRotator Rotation=Player->GetActorRotation();
+    AP->Telemetry(TEXT("state"),FString::Printf(TEXT("\"health\":%.2f,\"airport_health\":%.2f,\"cannon\":%d,\"missiles\":%d,\"speed_mps\":%.2f,\"rearming\":%s,\"position\":%s,\"rotation\":%s,\"velocity\":%s"),
+        Player->Health,AirportHealth,Player->CannonAmmo,Player->MissileAmmo,Player->Speed,bRearming?TEXT("true"):TEXT("false"),
+        *UAutoPlaySubsystem::JsonVec(Player->GetActorLocation()),*UAutoPlaySubsystem::JsonVec(FVector(Rotation.Pitch,Rotation.Yaw,Rotation.Roll)),*UAutoPlaySubsystem::JsonVec(Player->GetVelocity())));
+}
+
+void ADSGameMode::PlayCue(const FString& Cue,float Volume)
+{
+    const FString Path=FString::Printf(TEXT("/Game/Audio/S_%s.S_%s"),*Cue,*Cue);
+    if (USoundBase* Sound=LoadObject<USoundBase>(nullptr,*Path)) UGameplayStatics::PlaySound2D(this,Sound,Volume);
+}
+
+void ADSGameMode::Radio(const FString& Line,float Duration)
+{
+    RadioLine=Line;
+    RadioUntil=Elapsed+Duration;
+}
+
+float ADSGameMode::GroundHeightAt(const FVector& Position) const
+{
+    if (Position.SizeSquared2D()<180000.f*180000.f) return 2200.f;
+    FHitResult Hit;
+    FCollisionQueryParams Params(SCENE_QUERY_STAT(GroundHeight),true);
+    if (Player) Params.AddIgnoredActor(Player);
+    FCollisionObjectQueryParams GroundObjects;
+    GroundObjects.AddObjectTypesToQuery(ECC_WorldStatic);
+    if (GetWorld()->LineTraceSingleByObjectType(Hit,FVector(Position.X,Position.Y,1500000.f),FVector(Position.X,Position.Y,-50000.f),GroundObjects,Params)) return Hit.ImpactPoint.Z;
+    return 2000.f;
+}
+
+void ADSGameMode::UpdateBot(float Dt)
+{
+    UAutoPlaySubsystem* AP=UAutoPlaySubsystem::Get(this);
+    APlayerController* PC=UGameplayStatics::GetPlayerController(this,0);
+    if (!AP || !Player || !PC || Phase!=EDSPhase::Flying) return;
+    const float Skill=AP->GetSkill();
+    const float Roll=FMath::Sin(Elapsed*.14f)*.18f*Skill;
+    const float Pitch=(Player->GetActorLocation().Z<120000.f?.17f:.02f)*Skill;
+    AP->Inject(PC,Player->RollAction,FInputActionValue(Roll),TEXT("MouseX"));
+    AP->Inject(PC,Player->PitchAction,FInputActionValue(Pitch),TEXT("MouseY"));
+    if (Elapsed<4.f) AP->Inject(PC,Player->ThrottleAction,FInputActionValue(.35f),TEXT("W"));
+    if (FMath::Fmod(Elapsed,11.f)<Dt) AP->Inject(PC,Player->TargetAction,FInputActionValue(true),TEXT("Tab"));
+    if (FMath::Fmod(Elapsed,6.f)>4.5f) AP->Inject(PC,Player->GunAction,FInputActionValue(true),TEXT("LeftMouseButton"));
+    if (FMath::Fmod(Elapsed,9.f)<Dt) AP->Inject(PC,Player->MissileAction,FInputActionValue(true),TEXT("RightMouseButton"));
+}
diff --git a/Source/DuneSentinel/DSGameMode.h b/Source/DuneSentinel/DSGameMode.h
new file mode 100644
index 0000000000000000000000000000000000000000..d9e86653da92ba19c864455a258eb0d4708e8386
--- /dev/null
+++ b/Source/DuneSentinel/DSGameMode.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "CoreMinimal.h"
+#include "GameFramework/GameModeBase.h"
+#include "DSGameTypes.h"
+#include "DSGameMode.generated.h"
+
+class ADSFlightPawn;
+class ADSEnemyAircraft;
+class UDataTable;
+
+UCLASS()
+class DUNESENTINEL_API ADSGameMode : public AGameModeBase
+{
+    GENERATED_BODY()
+public:
+    ADSGameMode();
+    virtual void BeginPlay() override;
+    virtual void Tick(float DeltaSeconds) override;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float AirportMaxHealth = 5000.f;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float WaveInterval = 300.f;
+    UPROPERTY(BlueprintReadOnly) EDSPhase Phase = EDSPhase::Menu;
+    UPROPERTY(BlueprintReadOnly) float AirportHealth = 5000.f;
+    UPROPERTY(BlueprintReadOnly) float Elapsed = 0.f;
+    UPROPERTY(BlueprintReadOnly) int32 Score = 0;
+    UPROPERTY(BlueprintReadOnly) int32 Wave = 0;
+    UPROPERTY(BlueprintReadOnly) int32 SelectedAircraft = 1;
+    UPROPERTY(BlueprintReadOnly) bool bRearming = false;
+    UPROPERTY(BlueprintReadOnly) FString RadioLine;
+    UPROPERTY(BlueprintReadOnly) FString DefeatReason;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) TArray<FDSAircraftSpec> Aircraft;
+    UPROPERTY() TArray<TObjectPtr<ADSEnemyAircraft>> Enemies;
+    UPROPERTY() TObjectPtr<ADSFlightPawn> Player;
+    FVector AirportLocation = FVector(0, 0, 2200);
+    float ArenaHalfExtent = 1000000.f;
+    int32 HighScore = 0;
+    UFUNCTION(BlueprintCallable) void SelectAircraft(int32 Index);
+    UFUNCTION(BlueprintCallable) void StartSortie();
+    UFUNCTION(BlueprintCallable) void ReturnToMenu();
+    void DamageAirport(float Damage);
+    void RegisterKill(ADSEnemyAircraft* Enemy, bool bPlayerKill);
+    void EndSortie(const FString& Reason);
+    float SecondsToNextWave() const;
+    void PlayCue(const FString& Cue, float Volume=1.f);
+    void Radio(const FString& Line, float Duration=7.f);
+    float GroundHeightAt(const FVector& Position) const;
+private:
+    void SpawnWave();
+    void UpdateBot(float DeltaSeconds);
+    void SetMissionScore(int32 NewScore, const TCHAR* Reason);
+    void EmitStateTelemetry();
+    float NextWaveAt = 0.f;
+    float RearmAccumulator = 0.f;
+    float RadioUntil = 0.f;
+    int32 KillScore = 0;
+    FRandomStream Random;
+    bool bScenarioNotified = false;
+    float BotShotAt = 0.f;
+    float CaptureElapsed = 0.f;
+    int32 CaptureIndex = 0;
+    float StateTelemetryAccumulator = 0.f;
+};
diff --git a/Source/DuneSentinel/DSGameTypes.h b/Source/DuneSentinel/DSGameTypes.h
new file mode 100644
index 0000000000000000000000000000000000000000..ac8c90ad21f990b366c9d62ae639a4a8e5ebf680
--- /dev/null
+++ b/Source/DuneSentinel/DSGameTypes.h
@@ -0,0 +1,22 @@
+#pragma once
+#include "CoreMinimal.h"
+#include "DSGameTypes.generated.h"
+
+UENUM(BlueprintType)
+enum class EDSPhase : uint8 { Menu, Flying, Defeat };
+
+USTRUCT(BlueprintType)
+struct FDSAircraftSpec
+{
+    GENERATED_BODY()
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) FString Name = TEXT("F-24 PEREGRINE");
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) FString Role = TEXT("MULTIROLE / BALANCED");
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) FString MeshPath = TEXT("/Game/Art/Aircraft/SM_falcon.SM_falcon");
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float MaxHealth = 140.f;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) int32 Cannon = 1200;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) int32 Missiles = 16;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float CruiseSpeed = 240.f;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float MaxSpeed = 460.f;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float PitchRate = 42.f;
+    UPROPERTY(EditAnywhere, BlueprintReadWrite) float RollRate = 120.f;
+};
diff --git a/Source/DuneSentinel/DSHUD.cpp b/Source/DuneSentinel/DSHUD.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d11a92978c0b7949a289d30f6dafde79231505aa
--- /dev/null
+++ b/Source/DuneSentinel/DSHUD.cpp
@@ -0,0 +1,467 @@
+#include "DSHUD.h"
+#include "DSGameMode.h"
+#include "DSFlightPawn.h"
+#include "DSEnemyAircraft.h"
+#include "DSPlayerController.h"
+#include "CanvasItem.h"
+#include "Engine/Canvas.h"
+#include "Engine/Engine.h"
+#include "Engine/Font.h"
+#include "GlobalRenderResources.h"
+
+namespace
+{
+    const FLinearColor Ink(.015f, .029f, .042f, .91f);
+    const FLinearColor Cyan(.20f, .86f, .90f, 1.f);
+    const FLinearColor White(.91f, .95f, .95f, 1.f);
+    const FLinearColor Muted(.49f, .62f, .66f, 1.f);
+    const FLinearColor Rule(.19f, .34f, .39f, .80f);
+    const FLinearColor Amber(1.f, .64f, .27f, 1.f);
+    const FLinearColor Red(1.f, .30f, .25f, 1.f);
+    FString ClockText(float Seconds)
+    {
+        const int32 Whole = FMath::Max(0, FMath::CeilToInt(Seconds));
+        return FString::Printf(TEXT("%02d:%02d"), Whole / 60, Whole % 60);
+    }
+}
+
+void ADSHUD::BeginPlay()
+{
+    Super::BeginPlay();
+    DisplayFont = LoadObject<UFont>(nullptr, TEXT("/Game/UI/Fonts/OrbitronFont.OrbitronFont"));
+    BodyFont = LoadObject<UFont>(nullptr, TEXT("/Game/UI/Fonts/RajdhaniFont.RajdhaniFont"));
+    if (!BodyFont) BodyFont = DisplayFont ? DisplayFont.Get() : GEngine ? GEngine->GetMediumFont() : nullptr;
+    if (!DisplayFont) DisplayFont = BodyFont;
+}
+
+void ADSHUD::Text(const FString& Value, float X, float Y, float Size, FLinearColor Color, bool bDisplay, bool bCenter)
+{
+    UFont* Font = bDisplay ? DisplayFont.Get() : BodyFont.Get();
+    if (!Canvas || !Font || Value.IsEmpty()) return;
+    const float FontScale = Size / FMath::Max(1.f, static_cast<float>(Font->GetMaxCharHeight()));
+    float TextWidth = 0.f, TextHeight = 0.f;
+    if (bCenter) Canvas->StrLen(Font, Value, TextWidth, TextHeight);
+    FCanvasTextItem Item(Offset + FVector2D((X - (bCenter ? TextWidth * FontScale * .5f : 0.f)) * UIScale, Y * UIScale), FText::FromString(Value), Font, Color);
+    Item.Scale = FVector2D(FontScale * UIScale);
+    Item.EnableShadow(FLinearColor(0.f, 0.f, 0.f, .72f), FVector2D(1.f, 1.f));
+    Canvas->DrawItem(Item);
+}
+
+void ADSHUD::Rect(float X, float Y, float W, float H, FLinearColor Color)
+{
+    DrawRect(Color, Offset.X + X * UIScale, Offset.Y + Y * UIScale, W * UIScale, H * UIScale);
+}
+
+void ADSHUD::Line(float X1, float Y1, float X2, float Y2, FLinearColor Color, float Width)
+{
+    DrawLine(Offset.X + X1 * UIScale, Offset.Y + Y1 * UIScale, Offset.X + X2 * UIScale, Offset.Y + Y2 * UIScale, Color, Width * UIScale);
+}
+
+void ADSHUD::Triangle(FVector2D A, FVector2D B, FVector2D C, FLinearColor Color)
+{
+    FCanvasTriangleItem Item(Offset + A * UIScale, Offset + B * UIScale, Offset + C * UIScale, GWhiteTexture);
+    Item.SetColor(Color);
+    Item.BlendMode = SE_BLEND_Translucent;
+    Canvas->DrawItem(Item);
+}
+
+void ADSHUD::Frame(float X, float Y, float W, float H, FLinearColor Color, float Corner)
+{
+    Line(X, Y, X + Corner, Y, Color, 2); Line(X, Y, X, Y + Corner, Color, 2);
+    Line(X + W - Corner, Y, X + W, Y, Color, 2); Line(X + W, Y, X + W, Y + Corner, Color, 2);
+    Line(X, Y + H - Corner, X, Y + H, Color, 2); Line(X, Y + H, X + Corner, Y + H, Color, 2);
+    Line(X + W - Corner, Y + H, X + W, Y + H, Color, 2); Line(X + W, Y + H - Corner, X + W, Y + H, Color, 2);
+}
+
+void ADSHUD::Panel(float X, float Y, float W, float H, const FString& Label)
+{
+    Rect(X, Y, W, H, Ink);
+    Rect(X, Y, 3, H, Cyan.CopyWithNewOpacity(.65f));
+    Line(X + 18, Y + 39, X + W - 18, Y + 39, Rule);
+    Text(Label, X + 20, Y + 12, 15, Muted, true);
+}
+
+void ADSHUD::Button(FName Name, const FString& Label, float X, float Y, float W, float H, bool bPrimary, bool bSelected)
+{
+    const bool bHover = Mouse.X >= X && Mouse.X <= X + W && Mouse.Y >= Y && Mouse.Y <= Y + H;
+    const FLinearColor Accent = bPrimary || bSelected || bHover ? Cyan : Rule;
+    Rect(X, Y, W, H, bPrimary ? Cyan : bHover ? FLinearColor(.055f, .17f, .20f, .98f) : Ink);
+    if (!bPrimary) { Line(X, Y, X + W, Y, Accent); Line(X, Y + H, X + W, Y + H, Accent); }
+    Rect(X, Y, 3, H, Accent);
+    if (!Label.IsEmpty()) Text(Label, X + 22, Y + (H - 19) * .5f, 19, bPrimary ? Ink : White, true);
+    if (bPrimary)
+    {
+        Line(X + W - 47, Y + H * .5f, X + W - 23, Y + H * .5f, Ink, 2);
+        Line(X + W - 31, Y + H * .5f - 7, X + W - 23, Y + H * .5f, Ink, 2);
+        Line(X + W - 31, Y + H * .5f + 7, X + W - 23, Y + H * .5f, Ink, 2);
+    }
+    AddHitBox(Offset + FVector2D(X, Y) * UIScale, FVector2D(W, H) * UIScale, Name, true, 10);
+}
+
+void ADSHUD::Bar(float X, float Y, float W, float H, float Fraction, FLinearColor Color)
+{
+    Rect(X, Y, W, H, FLinearColor(.09f, .17f, .20f, .94f));
+    Rect(X, Y, W * FMath::Clamp(Fraction, 0.f, 1.f), H, Color);
+    for (int32 I = 1; I < 10; ++I) Rect(X + W * I / 10.f, Y, 2, H, Ink);
+}
+
+void ADSHUD::AmmoIcon(float X, float Y, bool bMissile, FLinearColor Color)
+{
+    if (bMissile)
+    {
+        Triangle(FVector2D(X + 13, Y), FVector2D(X + 7, Y + 12), FVector2D(X + 19, Y + 12), Color);
+        Rect(X + 8, Y + 12, 10, 28, Color);
+        Triangle(FVector2D(X + 8, Y + 22), FVector2D(X, Y + 38), FVector2D(X + 8, Y + 35), Color);
+        Triangle(FVector2D(X + 18, Y + 22), FVector2D(X + 26, Y + 38), FVector2D(X + 18, Y + 35), Color);
+        Rect(X + 10, Y + 43, 6, 5, Color.CopyWithNewOpacity(.6f));
+    }
+    else
+    {
+        Triangle(FVector2D(X + 9, Y), FVector2D(X + 3, Y + 11), FVector2D(X + 15, Y + 11), Color);
+        Rect(X + 3, Y + 11, 12, 27, Color); Rect(X, Y + 40, 18, 5, Color);
+        Line(X + 6, Y + 13, X + 6, Y + 33, Ink);
+    }
+}
+
+void ADSHUD::DrawHUD()
+{
+    Super::DrawHUD();
+    if (!Canvas) return;
+    UIScale = FMath::Min(Canvas->ClipX / 1920.f, Canvas->ClipY / 1080.f);
+    Offset = FVector2D((Canvas->ClipX - 1920.f * UIScale) * .5f, (Canvas->ClipY - 1080.f * UIScale) * .5f);
+    HitBoxMap.Reset();
+    HitBoxHits.Reset();
+    Mouse = FVector2D(-1000, -1000);
+    ADSPlayerController* PC = Cast<ADSPlayerController>(PlayerOwner);
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!PC || !Mode) return;
+    float MX = 0.f, MY = 0.f;
+    if (PC->GetMousePosition(MX, MY)) Mouse = (FVector2D(MX, MY) - Offset) / UIScale;
+    if (Mode->Phase == EDSPhase::Menu) Menu(Mode);
+    else if (Mode->Phase == EDSPhase::Flying && Mode->Player) Combat(Mode, Mode->Player);
+    else if (Mode->Phase == EDSPhase::Defeat) Debrief(Mode);
+    if (PC->bPaused) Paused(Mode);
+    if (PC->bShowSettings || PC->bShowControls)
+    {
+        // Only the visible modal receives clicks; hidden menu buttons cannot fire.
+        HitBoxMap.Reset();
+        HitBoxHits.Reset();
+        if (PC->bShowSettings) Settings(PC); else Controls();
+    }
+}
+
+void ADSHUD::NotifyHitBoxClick(FName BoxName)
+{
+    Super::NotifyHitBoxClick(BoxName);
+    if (ADSPlayerController* PC = Cast<ADSPlayerController>(PlayerOwner)) PC->HandleMenuAction(BoxName);
+}
