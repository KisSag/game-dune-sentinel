++    Line(X, Y + H - Corner, X, Y + H, Color, 2); Line(X, Y + H, X + Corner, Y + H, Color, 2);
++    Line(X + W - Corner, Y + H, X + W, Y + H, Color, 2); Line(X + W, Y + H - Corner, X + W, Y + H, Color, 2);
