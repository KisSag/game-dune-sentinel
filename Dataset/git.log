++    void ClearCombatActors()
++    {
++        for (TActorIterator<ADSEnemyAircraft> It(World.Get()); It; ++It) It->Destroy();
++        for (TActorIterator<ADSProjectile> It(World.Get()); It; ++It) It->Destroy();
