e_objects_diff_2k_559e194.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_objects_metal_2k_ba7d90c.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_objects_nor_gl_2k_1448b17.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_objects_rough_2k_2c5e5fc.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_plaster_diff_2k_d78d7fc.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_plaster_nor_gl_2k_24f9807.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_plaster_rough_2k_36d370a.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_trim_01_diff_2k_dbe25b2.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_trim_01_nor_gl_2k_c57d4eb.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_trim_01_rough_2k_e1b54b5.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_trim_02_diff_2k_3ed7795.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_trim_02_nor_gl_2k_15dc6a7.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_modular_urban_apartments_facade_trim_02_rough_2k_3144259.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_namaqualand_boulder_02_diff_2k_98a3200.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_namaqualand_boulder_02_nor_gl_2k_46e6b60.uasset", "by": "drop:reuse-final"}, {"path": "Content/Art/Textures/Downloaded/T_namaquala