++    void RemoveDelegate()
++    {
++        if (ViewportRenderedHandle.IsValid()) UGameViewportClient::OnViewportRendered().Remove(ViewportRenderedHandle);
++        ViewportRenderedHandle.Reset(); bReadbackRequested=false;
++    }
