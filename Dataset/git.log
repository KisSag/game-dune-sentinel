++    void PrepareObservation()
++    {
++        CaseBounds = FBox(ForceInit);
++        if (VisualCase < 3) Mode->Player->GetAircraftExhaust()->SetExhaustVisible(false);
++        if (ObservedEnemy.IsValid()) ObservedEnemy->GetAircraftExhaust()->SetExhaustVisible(false);
