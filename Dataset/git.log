+};
diff --git a/Source/DuneSentinel/DSMissionTests.cpp b/Source/DuneSentinel/DSMissionTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c8a37ea3329cb2b5437a88ffe95dcc701af39d0a
--- /dev/null
+++ b/Source/DuneSentinel/DSMissionTests.cpp
@@ -0,0 +1,77 @@
+#if WITH_DEV_AUTOMATION_TESTS
+#include "Misc/AutomationTest.h"
+#include "Engine/World.h"
+#include "DSGameMode.h"
+#include "DSFlightPawn.h"
+#include "DSEnemyAircraft.h"
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FDSMissionRulesTest,"DuneSentinel.Mission.CombatInvariants",EAutomationTestFlags::EditorContext|EAutomationTestFlags::EngineFilter)
+bool FDSMissionRulesTest::RunTest(const FString& Parameters)
+{
+    const UWorld::InitializationValues InitValues=UWorld::InitializationValues().AllowAudioPlayback(false).CreatePhysicsScene(false).RequiresHitProxies(false).CreateNavigation(false).CreateAISystem(false).ShouldSimulatePhysics(false).SetTransactional(false);
+    UWorld* World=UWorld::CreateWorld(EWorldType::Game,false,FName(TEXT("DuneMissionTest")),nullptr,true,ERHIFeatureLevel::Num,&InitValues);
+    ADSGameMode* Mode=World->SpawnActor<ADSGameMode>();
+    TestEqual(TEXT("Three distinct selectable airframes"),Mode->Aircraft.Num(),3);
+    TestEqual(TEXT("Waves are separated by five minutes"),Mode->WaveInterval,300.f);
+    TestTrue(TEXT("Agile airframe has higher turn rate"),Mode->Aircraft[0].PitchRate>Mode->Aircraft[2].PitchRate);
+    TestTrue(TEXT("Heavy airframe carries more ordnance"),Mode->Aircraft[2].Missiles>Mode->Aircraft[0].Missiles);
+    Mode->Phase=EDSPhase::Flying;
+    ADSEnemyAircraft* Fighter=World->SpawnActor<ADSEnemyAircraft>();
+    Mode->Enemies.Add(Fighter);
+    Mode->RegisterKill(Fighter,true);
+    TestEqual(TEXT("Fighter destruction awards 100"),Mode->Score,100);
+    Mode->RegisterKill(Fighter,true);
+    TestEqual(TEXT("Repeated destruction cannot award twice"),Mode->Score,100);
+    ADSEnemyAircraft* Bomber=World->SpawnActor<ADSEnemyAircraft>();
+    Bomber->bBomber=true; Mode->Enemies.Add(Bomber); Mode->RegisterKill(Bomber,true);
+    TestEqual(TEXT("Bomber destruction awards 200"),Mode->Score,300);
+    ADSEnemyAircraft* Escape=World->SpawnActor<ADSEnemyAircraft>();
+    Mode->Enemies.Add(Escape); Mode->RegisterKill(Escape,false);
+    TestEqual(TEXT("Escaping enemy awards no points"),Mode->Score,300);
+    Mode->AirportHealth=5000.f;
+    Mode->DamageAirport(300.f);
+    TestEqual(TEXT("Bomb damage reaches the airport"),Mode->AirportHealth,4700.f);
+    Mode->DamageAirport(6000.f);
+    TestEqual(TEXT("Airport health clamps at zero"),Mode->AirportHealth,0.f);
+    TestTrue(TEXT("Destroyed airport ends sortie"),Mode->Phase==EDSPhase::Defeat);
+    const int32 FinalScore=Mode->Score;
+    Mode->Tick(10.f);
+    TestEqual(TEXT("Survival score freezes after defeat"),Mode->Score,FinalScore);
+    ADSFlightPawn* Pawn=World->SpawnActor<ADSFlightPawn>();
+    Pawn->ConfigureAircraft(Mode->Aircraft[0]);
+    Pawn->CannonAmmo=1; Pawn->MissileAmmo=0;
+    Pawn->Rearm(100000,100000);
+    TestEqual(TEXT("Rearm cannot exceed cannon capacity"),Pawn->CannonAmmo,Mode->Aircraft[0].Cannon);
+    TestEqual(TEXT("Rearm cannot exceed missile capacity"),Pawn->MissileAmmo,Mode->Aircraft[0].Missiles);
+    Mode->Player=Pawn;
+    Mode->Phase=EDSPhase::Menu;
+    Mode->SelectAircraft(0);
+    const int32 ParkedScore=Mode->Score;
+    Mode->Tick(10.f);
+    TestEqual(TEXT("Menu never advances survival score"),Mode->Score,ParkedScore);
+    Mode->StartSortie();
+    TestTrue(TEXT("Start enables flight"),Pawn->IsFlying());
+    TestEqual(TEXT("Restart restores airport health"),Mode->AirportHealth,Mode->AirportMaxHealth);
+    TestEqual(TEXT("Restart resets score"),Mode->Score,0);
+    TestEqual(TEXT("Start spawns the initial wave"),Mode->Wave,1);
+    TestTrue(TEXT("Initial wave contains randomized bounded enemies"),Mode->Enemies.Num()>=3 && Mode->Enemies.Num()<=6);
+    Mode->Tick(299.f);
+    TestEqual(TEXT("No second wave before five minutes"),Mode->Wave,1);
+    Mode->Tick(1.1f);
+    TestEqual(TEXT("Second wave after five minutes"),Mode->Wave,2);
+    TestEqual(TEXT("Survival earns one point per second"),Mode->Score,300);
+    Pawn->CannonAmmo=0; Pawn->MissileAmmo=0;
+    Pawn->SetActorLocation(Mode->AirportLocation+FVector(0,0,30000.f));
+    Mode->Tick(1.f);
+    TestEqual(TEXT("Airfield proximity grants cannon supplies"),Pawn->CannonAmmo,200);
+    TestEqual(TEXT("Airfield proximity grants missiles"),Pawn->MissileAmmo,2);
+    Pawn->SetActorLocation(Mode->AirportLocation+FVector(200000.f,0,30000.f));
+    Mode->Tick(2.f);
+    TestEqual(TEXT("Leaving the airfield stops replenishment"),Pawn->CannonAmmo,200);
+    Mode->ReturnToMenu();
+    TestFalse(TEXT("Returning to menu parks the aircraft"),Pawn->IsFlying());
+    TestEqual(TEXT("Returning to menu removes hostile actors"),Mode->Enemies.Num(),0);
+    World->DestroyWorld(false);
+    return true;
+}
+#endif
diff --git a/Source/DuneSentinel/DSPlayerController.cpp b/Source/DuneSentinel/DSPlayerController.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..05ee484d7d183ace217c002443994a6e163a01b4
--- /dev/null
+++ b/Source/DuneSentinel/DSPlayerController.cpp
@@ -0,0 +1,239 @@
+#include "DSPlayerController.h"
+#include "DSGameMode.h"
+#include "DSFlightPawn.h"
+#include "Components/InputComponent.h"
+#include "GameFramework/GameUserSettings.h"
+#include "GameFramework/PlayerInput.h"
+#include "InputCoreTypes.h"
+#include "Kismet/GameplayStatics.h"
+#include "Kismet/KismetSystemLibrary.h"
+#include "Misc/App.h"
+#include "Misc/ConfigCacheIni.h"
+
+namespace
+{
+    const TCHAR* PilotSection = TEXT("DuneSentinel.PilotSettings");
+    const FIntPoint DisplaySizes[] = { FIntPoint(1280,720), FIntPoint(1600,900), FIntPoint(1920,1080), FIntPoint(2560,1440) };
+}
+
+ADSPlayerController::ADSPlayerController()
+{
+    PrimaryActorTick.bCanEverTick = true;
+    PrimaryActorTick.bTickEvenWhenPaused = true;
+    bShouldPerformFullTickWhenPaused = true;
+    bShowMouseCursor = true;
+    bEnableClickEvents = true;
+    bEnableMouseOverEvents = true;
+}
+
+void ADSPlayerController::BeginPlay()
+{
+    Super::BeginPlay();
+    LoadPilotSettings();
+    RefreshInputMode();
+}
+
+void ADSPlayerController::SetupInputComponent()
+{
+    Super::SetupInputComponent();
+    InputComponent->BindKey(EKeys::Escape, IE_Pressed, this, &ADSPlayerController::TogglePauseMenu).bExecuteWhenPaused = true;
+    InputComponent->BindKey(EKeys::Enter, IE_Pressed, this, &ADSPlayerController::ConfirmMenu).bExecuteWhenPaused = true;
+}
+
+void ADSPlayerController::Tick(float DeltaSeconds)
+{
+    Super::Tick(DeltaSeconds);
+    const ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (Mode && Mode->Phase != LastPhase)
+    {
+        LastPhase = Mode->Phase;
+        if (Mode->Phase != EDSPhase::Flying) ClearFlightControls();
+        if (Mode->Phase != EDSPhase::Flying && bPaused)
+        {
+            SetPause(false);
+            bPaused = false;
+        }
+        bShowSettings = false;
+        bShowControls = false;
+        RefreshInputMode();
+    }
+}
+
+void ADSPlayerController::RefreshInputMode()
+{
+    const ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    const bool bInteractive = !Mode || Mode->Phase != EDSPhase::Flying || bPaused;
+    if (bInputInitialized && bInteractive == bLastInteractive) return;
+    bInputInitialized = true;
+    bLastInteractive = bInteractive;
+    bShowMouseCursor = bInteractive;
+    bEnableClickEvents = bInteractive;
+    bEnableMouseOverEvents = bInteractive;
+    if (bInteractive)
+    {
+        FInputModeGameAndUI ModeUI;
+        ModeUI.SetHideCursorDuringCapture(false);
+        ModeUI.SetLockMouseToViewportBehavior(EMouseLockMode::DoNotLock);
+        SetInputMode(ModeUI);
+    }
+    else
+    {
+        FInputModeGameOnly ModeGame;
+        ModeGame.SetConsumeCaptureMouseDown(true);
+        SetInputMode(ModeGame);
+    }
+}
+
+void ADSPlayerController::ResumeFlight()
+{
+    ClearFlightControls();
+    SetPause(false);
+    bPaused = false;
+    bShowSettings = false;
+    bShowControls = false;
+    RefreshInputMode();
+}
+
+void ADSPlayerController::ClearFlightControls()
+{
+    if (ADSFlightPawn* Flight = Cast<ADSFlightPawn>(GetPawn())) Flight->ClearFlightInput();
+    if (PlayerInput) PlayerInput->FlushPressedKeys();
+}
+
+void ADSPlayerController::TogglePauseMenu()
+{
+    if (bShowSettings || bShowControls)
+    {
+        bShowSettings = false;
+        bShowControls = false;
+        return;
+    }
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode || Mode->Phase != EDSPhase::Flying) return;
+    if (bPaused) ResumeFlight();
+    else
+    {
+        ClearFlightControls();
+        bPaused = SetPause(true);
+        RefreshInputMode();
+    }
+}
+
+void ADSPlayerController::ConfirmMenu()
+{
+    if (bShowControls || bShowSettings) return;
+    const ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode) return;
+    if (bPaused) HandleMenuAction(TEXT("resume"));
+    else if (Mode->Phase == EDSPhase::Menu) HandleMenuAction(TEXT("start"));
+    else if (Mode->Phase == EDSPhase::Defeat) HandleMenuAction(TEXT("restart"));
+}
+
+void ADSPlayerController::HandleMenuAction(FName Action)
+{
+    ADSGameMode* Mode = GetWorld()->GetAuthGameMode<ADSGameMode>();
+    if (!Mode) return;
+    if (Mode->Phase == EDSPhase::Flying && !bPaused) return;
+    if (Action == TEXT("start") || Action == TEXT("restart"))
+    {
+        ResumeFlight();
+        Mode->StartSortie();
+        LastPhase = Mode->Phase;
+        RefreshInputMode();
+    }
+    else if (Action == TEXT("resume")) ResumeFlight();
+    else if (Action == TEXT("menu"))
+    {
+        ResumeFlight();
+        Mode->ReturnToMenu();
+        LastPhase = Mode->Phase;
+        RefreshInputMode();
+    }
+    else if (Action == TEXT("settings"))
+    {
+        bShowSettings = true;
+        bShowControls = false;
+        SettingsFeedback.Empty();
+    }
+    else if (Action == TEXT("controls"))
+    {
+        bShowControls = true;
+        bShowSettings = false;
+    }
+    else if (Action == TEXT("back")) { bShowControls = false; bShowSettings = false; }
+    else if (Action == TEXT("quit")) UKismetSystemLibrary::QuitGame(this, this, EQuitPreference::Quit, false);
+    else if (Action == TEXT("aircraft0") || Action == TEXT("aircraft1") || Action == TEXT("aircraft2"))
+    {
+        if (Mode->Phase == EDSPhase::Menu)
+            Mode->SelectAircraft(Action == TEXT("aircraft0") ? 0 : Action == TEXT("aircraft1") ? 1 : 2);
+    }
+    else if (Action == TEXT("volume_down") || Action == TEXT("volume_up"))
+    {
+        MasterVolume = FMath::Clamp(MasterVolume + (Action == TEXT("volume_up") ? .1f : -.1f), 0.f, 1.f);
+        SavePilotSettings();
+    }
+    else if (Action == TEXT("sensitivity_down") || Action == TEXT("sensitivity_up"))
+    {
+        MouseSensitivity = FMath::Clamp(MouseSensitivity + (Action == TEXT("sensitivity_up") ? .1f : -.1f), .2f, 3.f);
+        SavePilotSettings();
+    }
+    else if (Action == TEXT("invert")) { bInvertMouse = !bInvertMouse; SavePilotSettings(); }
+    else if (Action == TEXT("resolution")) CycleResolution();
+    else if (Action == TEXT("apply_display")) ApplyResolution();
+}
+
+void ADSPlayerController::LoadPilotSettings()
+{
+    if (GConfig)
+    {
+        GConfig->GetFloat(PilotSection, TEXT("MasterVolume"), MasterVolume, GGameUserSettingsIni);
+        GConfig->GetFloat(PilotSection, TEXT("MouseSensitivity"), MouseSensitivity, GGameUserSettingsIni);
+        GConfig->GetBool(PilotSection, TEXT("InvertMouse"), bInvertMouse, GGameUserSettingsIni);
+    }
+    MasterVolume = FMath::Clamp(MasterVolume, 0.f, 1.f);
+    MouseSensitivity = FMath::Clamp(MouseSensitivity, .2f, 3.f);
+    FApp::SetVolumeMultiplier(MasterVolume);
+    if (const UGameUserSettings* Settings = UGameUserSettings::GetGameUserSettings())
+    {
+        const FIntPoint Size = Settings->GetScreenResolution();
+        if (Size.X > 0 && Size.Y > 0) PendingResolution = Size;
+    }
+}
+
+void ADSPlayerController::SavePilotSettings()
+{
+    FApp::SetVolumeMultiplier(MasterVolume);
+    if (GConfig)
+    {
+        GConfig->SetFloat(PilotSection, TEXT("MasterVolume"), MasterVolume, GGameUserSettingsIni);
+        GConfig->SetFloat(PilotSection, TEXT("MouseSensitivity"), MouseSensitivity, GGameUserSettingsIni);
+        GConfig->SetBool(PilotSection, TEXT("InvertMouse"), bInvertMouse, GGameUserSettingsIni);
+        GConfig->Flush(false, GGameUserSettingsIni);
+    }
+    SettingsFeedback = TEXT("PILOT PREFERENCES SAVED");
+}
+
+void ADSPlayerController::CycleResolution()
+{
+    int32 Index = -1;
+    for (int32 I = 0; I < UE_ARRAY_COUNT(DisplaySizes); ++I) if (DisplaySizes[I] == PendingResolution) Index = I;
+    PendingResolution = DisplaySizes[(Index + 1) % UE_ARRAY_COUNT(DisplaySizes)];
+    SettingsFeedback = TEXT("SELECT APPLY DISPLAY TO CONFIRM");
+}
+
+void ADSPlayerController::ApplyResolution()
+{
+    if (UGameUserSettings* Settings = UGameUserSettings::GetGameUserSettings())
+    {
+        Settings->SetScreenResolution(PendingResolution);
+        Settings->SetFullscreenMode(EWindowMode::Windowed);
+        Settings->ApplySettings(false);
+        Settings->SaveSettings();
+        SettingsFeedback = TEXT("DISPLAY SAVED  /  WINDOWED");
+    }
+}
+
+FString ADSPlayerController::ResolutionLabel() const
+{
+    return FString::Printf(TEXT("%d x %d"), PendingResolution.X, PendingResolution.Y);
+}
diff --git a/Source/DuneSentinel/DSPlayerController.h b/Source/DuneSentinel/DSPlayerController.h
new file mode 100644
index 0000000000000000000000000000000000000000..d03acba384831e2e033f6c150704c912e26f9dd2
--- /dev/null
+++ b/Source/DuneSentinel/DSPlayerController.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/PlayerController.h"
+#include "DSGameTypes.h"
+#include "DSPlayerController.generated.h"
+
+UCLASS()
+class DUNESENTINEL_API ADSPlayerController : public APlayerController
