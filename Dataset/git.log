index 0000000000000000000000000000000000000000..9057ba7a7848584242b8fc4b8a8915d3bd75b244
--- /dev/null
+++ b/Dataset/ReplayScripts/shellfx.py
@@ -0,0 +1,446 @@
+"""File edits inside recorded shell commands, re-executed in a sandbox to rebuild file texts between commits.
+
+The builders edited scripts and code from the shell as often as with the editor tools: `cat > f <<'EOF'` heredocs,
+`cat >> f`, `sed -i`, `sed '...' a > b`, `cp a b`, and small Python programs (`python - <<'EOF'`, `python -c "..."`,
+or a helper file written to a scratch folder and run) that read a file, replace text and write it back, often to a
+new `_v2` file. Only those fragments are executed, never the whole command (it may also launch the editor, append
+workflow rows or commit). The command is walked simple command by simple command, following `cd`:
+
+  cat > f / cat >> f    exact: the heredoc body is the file text
+  sed -i, sed > f       Git's sed on sandbox copies of the files
+  python edits          the program runs in the sandbox; a prelude maps the game repo's absolute paths into the
+                        sandbox and refuses writes outside it, subprocesses, renames and deletes
+  cp / mv               copies the known state
+  git checkout/switch   files become unknown (the working tree changed under them)
+
+Any other simple command that writes a tracked file (redirect target, tee, Set-Content, ...) marks it unknown.
+Results are checked against the commit at every boundary (ledger.FileStates.boundary).
+"""
+import fnmatch
+import json
+import os
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+def _git_tool(name):
+    """A Git for Windows tool: on PATH (Git Bash), else beside git.exe, else the default install folder."""
+    hit = shutil.which(name)
+    if hit:
+        return hit
+    git_exe = shutil.which("git")
+    roots = [os.path.dirname(os.path.dirname(os.path.realpath(git_exe)))] if git_exe else []
+    roots.append(os.path.join(os.environ.get("ProgramFiles", r"C:\Program Files"), "Git"))
+    for r in roots:
+        cand = os.path.join(r, "usr", "bin", name + ".exe")
+        if os.path.exists(cand):
+            return cand
+    return name
+
+
+SED = _git_tool("sed")
+
+
+def win_path(p):
+    """An MSYS path (/c/..., /d/...) as a Windows path (C:/..., D:/...); other paths unchanged."""
+    if len(p) >= 3 and p[0] == "/" and p[1].isalpha() and p[2] == "/":
+        return p[1].upper() + ":/" + p[3:]
+    return p
+
+HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n")
+
+
+def segments(text):
+    """Simple commands split on && || ; | and newlines (quotes respected)."""
+    segs, cur, q, i = [], [], None, 0
+    while i < len(text):
+        ch = text[i]
+        if q:
+            cur.append(ch)
+            if ch == "\\" and q == '"' and i + 1 < len(text):
+                cur.append(text[i + 1])
+                i += 2
+                continue
+            if ch == q:
+                q = None
+        elif ch in "'\"":
+            q = ch
+            cur.append(ch)
+        elif text.startswith("&&", i) or text.startswith("||", i):
+            segs.append("".join(cur))
+            cur = []
+            i += 2
+            continue
+        elif ch in ";|\n":
+            segs.append("".join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+        i += 1
+    segs.append("".join(cur))
+    return [s.strip() for s in segs if s.strip()]
+
+
+def protect_heredocs(cmd):
+    """Heredoc bodies replaced by <<HEREDOC<n> placeholders, so the command splits into simple commands."""
+    bodies, out, pos = [], [], 0
+    while True:
+        m = HEREDOC.search(cmd, pos)
+        if not m:
+            out.append(cmd[pos:])
+            break
+        tag = m.group(2)
+        end = re.search(r"(?m)^[ \t]*%s[ \t]*$" % re.escape(tag), cmd[m.end():])
+        if not end:
+            out.append(cmd[pos:])
+            break
+        body = cmd[m.end():m.end() + end.start()]
+        if not m.group(1):  # unquoted tag: bash expands \\ \$ \` and line continuations (variables are left as they are)
+            body = re.sub(r"\\([\\$`])", r"\1", body.replace("\\\n", ""))
+        bodies.append(body)
+        rest_of_line = cmd[m.start():m.end()].split("\n")[0]
+        rest_of_line = re.sub(r"^<<-?\s*(['\"]?)\w+\1", "", rest_of_line)
+        out.append(cmd[pos:m.start()] + "<<HEREDOC%d " % (len(bodies) - 1) + rest_of_line + "\n")
+        pos = m.end() + end.end()
+    return "".join(out), bodies
+
+
+PRELUDE = r'''
+import builtins as _b, io as _io, os as _os, sys as _sys
+_ROOTS = %(roots)r
+_SB = %(sandbox)r
+_orig_open = _b.open
+_orig_chdir = _os.chdir
+_orig_osopen = _os.open
+_orig_mkdir = _os.mkdir
+def _map(f, write):
+    p = _os.fspath(f)
+    if isinstance(p, bytes):
+        p = p.decode()
+    q = p.replace("\\", "/")
+    if len(q) >= 3 and q[0] == "/" and q[1].isalpha() and q[2] == "/":   # MSYS drive path (/c/, /d/, ...)
+        q = q[1].upper() + ":/" + q[3:]
+    for r in _ROOTS:
+        if q.lower().startswith(r.lower() + "/") or q.lower() == r.lower():
+            q = _SB + q[len(r):]
+            break
+    # fail closed: whatever the path (absolute, relative after a chdir, ..), a write must land inside the sandbox
+    if write:
+        full = _os.path.abspath(q).replace("\\", "/")
+        if not (full.lower() + "/").startswith(_SB.lower().rstrip("/") + "/"):
+            raise PermissionError("sandbox: write outside the sandbox: " + p)
+    return q
+def _open(f, mode="r", *a, **k):
+    if isinstance(f, int):
+        return _orig_open(f, mode, *a, **k)
+    return _orig_open(_map(f, any(c in mode for c in "wax+")), mode, *a, **k)
+def _osopen(f, flags, *a, **k):
+    return _orig_osopen(_map(f, bool(flags & (_os.O_WRONLY | _os.O_RDWR | _os.O_CREAT | _os.O_APPEND | _os.O_TRUNC))), flags, *a, **k)
+def _chdir(d):
+    return _orig_chdir(_map(d, False))
+def _mkdir(d, *a, **k):
+    return _orig_mkdir(_map(d, True), *a, **k)
+_b.open = _open
+_io.open = _open
+_os.open = _osopen
+_os.chdir = _chdir
+_os.mkdir = _mkdir
+def _blocked(*a, **k):
+    raise PermissionError("sandbox: blocked")
+_os.system = _os.remove = _os.unlink = _os.rename = _os.replace = _os.rmdir = _os.removedirs = _blocked
+import shutil as _sh
+_sh.rmtree = _sh.move = _blocked
+import subprocess as _sp
+_sp.run = _sp.Popen = _sp.call = _sp.check_call = _sp.check_output = _blocked
+'''
+
+
+class Sandbox:
+    """A scratch tree holding the known state of the files a fragment may touch."""
+
+    def __init__(self, repo_abs):
+        self.repo_abs = repo_abs.replace("\\", "/").rstrip("/")
+        self.dir = tempfile.mkdtemp(prefix="uerepl-sb-").replace("\\", "/")
+
+    def close(self):
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    def run(self, states, candidates, cwd_rel, kind, payload, timeout=300):
+        """Materialize candidates, run one fragment. python/sed: (ok, err, {path: new bytes}); sed_stdout: (ok, err, stdout).
+        A fragment that outlives `timeout` is a failed fragment like any other (the window then takes the commit's
+        text), not the end of the replay (giant-fall: a host-python step past the old 60 s stopped the whole job)."""
+        try:
+            return self._run(states, candidates, cwd_rel, kind, payload, timeout)
+        except subprocess.TimeoutExpired:
+            return (False, "sandbox: timed out after %d s" % timeout) + ((b"",) if kind == "sed_stdout" else ({},))
+
+    def _run(self, states, candidates, cwd_rel, kind, payload, timeout):
+        shutil.rmtree(self.dir, ignore_errors=True)
+        os.makedirs(self.dir)
+        before = {}
+        for p in candidates:
+            st = states.get(p)
+            if st is None or st is states.ABSENT:
+                continue  # unknown or absent: not materialized; a fragment that reads it fails
+            fp = os.path.join(self.dir, p)
+            os.makedirs(os.path.dirname(fp), exist_ok=True)
+            with open(fp, "wb") as f:
+                f.write(st)
+            before[p] = st
+        cwd = os.path.join(self.dir, cwd_rel) if cwd_rel else self.dir
+        os.makedirs(cwd, exist_ok=True)
+        if kind == "python":
+            prog = PRELUDE % {"roots": [self.repo_abs], "sandbox": self.dir} + "\n" + payload
+            pf = os.path.join(tempfile.gettempdir(), "uerepl-prog-%d.py" % os.getpid())
+            with open(pf, "w", encoding="utf-8") as f:
+                f.write(prog)
+            r = subprocess.run([sys.executable, "-I", pf], cwd=cwd, capture_output=True, timeout=timeout)
+            os.remove(pf)
+        else:
+            # file arguments under the repo point into the sandbox; any other absolute path is refused (fail closed)
+            args = []
+            for x in payload:
+                q = x.replace("\\", "/")
+                q = win_path(q)
+                if q.lower().startswith(self.repo_abs.lower() + "/"):
+                    x = self.dir + q[len(self.repo_abs):]
+                elif re.match(r"^(?:[A-Za-z]:/|/)", q) and not q.lower().startswith(self.dir.lower() + "/") and not x.startswith("-"):
+                    return (False, "sandbox: sed path outside the sandbox: " + x) + (({} ,) if kind == "sed" else (b"",))
+                args.append(x)
+            r = subprocess.run([SED] + args, cwd=cwd, capture_output=True, timeout=timeout)
+            if kind == "sed_stdout":
+                return r.returncode == 0, r.stderr.decode("utf-8", "replace")[-400:], r.stdout.replace(b"\r\n", b"\n")
+        ok, err = r.returncode == 0, r.stderr.decode("utf-8", "replace")[-400:]
+        changed = {}
+        for root, _, files in os.walk(self.dir):
+            for fn in files:
+                fp = os.path.join(root, fn)
+                rel = os.path.relpath(fp, self.dir).replace("\\", "/")
+                with open(fp, "rb") as f:
+                    b = f.read().replace(b"\r\n", b"\n")
+                if before.get(rel) != b:
+                    changed[rel] = b
+        return ok, err, changed
+
+
+def _abs(p):
+    p = p.strip("'\"").replace("\\", "/")
+    return win_path(p)
+
+
+def cwd_of(action, repo_abs):
+    """Repo-relative working directory the command started in ('' = repo root, None = outside the repo)."""
+    root = repo_abs.replace("\\", "/").rstrip("/")
+    cwd = _abs(action.get("cwd") or "")
+    if cwd.lower() == root.lower():
+        return ""
+    if cwd.lower().startswith(root.lower() + "/"):
+        return cwd[len(root) + 1:]
+    return None
+
+
+def repo_path(tok, cwd_rel, repo_abs):
+    t = _abs(tok)
+    root = repo_abs.replace("\\", "/").rstrip("/")
+    if re.match(r"[A-Za-z]:/", t):
+        return t[len(root) + 1:] if t.lower().startswith(root.lower() + "/") else None
+    if cwd_rel is None:
+        return None
+    p = os.path.normpath(os.path.join(cwd_rel or ".", t)).replace("\\", "/")
+    return None if p.startswith("..") else p
+
+
+def apply_command(action, states, sandbox, tracked, log, aux=None):
+    """Apply the file edits of one shell command to `states`, simple command by simple command.
+    tracked: repo paths worth following; aux: {absolute path: text} of helper files written outside the repo."""
+    cmd = action.get("input", {}).get("command", "")
+    repo_abs = sandbox.repo_abs
+    text, bodies = protect_heredocs(cmd)
+    cwd_rel = cwd_of(action, repo_abs)
+    names = {}
+    for p in tracked:
+        names.setdefault(os.path.basename(p), []).append(p)
+
+    def cands(t):
+        return set(p for base, ps in names.items() if base in t for p in ps)
+
+    resp = action.get("response")
+    if isinstance(resp, str) and resp.lstrip().startswith("{"):
+        try:
+            resp = json.loads(resp)
+        except ValueError:
+            pass
+    if isinstance(resp, dict):
+        resp = "%s\n%s" % (resp.get("stdout") or "", resp.get("stderr") or "")
+    elif not isinstance(resp, str):
+        resp = json.dumps(resp, ensure_ascii=False)
+    shell_vars = {}  # NAME=literal assignments made earlier in this command ($NAME in later paths)
+
+    def expand_vars(t):
+        for k in sorted(shell_vars, key=len, reverse=True):
+            t = re.sub(r"\$(?:\{%s\}|%s\b)" % (re.escape(k), re.escape(k)), lambda m: shell_vars[k], t)
+        return t
+
+    def recorded_failure(how, helper=None):
+        """The recorded output shows this Python program raised (a traceback from its own source)."""
+        marker = {"python_heredoc": 'File "<stdin>"', "python_c": 'File "<string>"'}.get(how)
+        if helper:
+            marker = os.path.basename(helper)
+        return bool(marker) and "Traceback (most recent call last)" in resp and marker in resp
+
+    def run_python(prog, how, helper=None):
+        c = cands(prog)
+        if not c or not re.search(r"\.write\(|open\(|write_text|write_bytes", prog):
+            return
+        ok, err, changed = sandbox.run(states, c, cwd_rel, "python", prog)
+        if ok and recorded_failure(how, helper):
+            # The sandbox run succeeded where the recorded one raised (e.g. the Bash tool handed the program `\` where
+            # the record shows `\\`, so an assert-replace failed): keep the files as they were. A program that fails
+            # after a first write is still reproduced, because then the sandbox run fails too.
+            log.append((how + "_diverged_discarded", sorted(changed)))
+            return
+        for p, b in changed.items():
+            if p in tracked:
+                states.put(p, b, how)
+        log.append((how if ok else how + "_failed", sorted(changed) if ok else err[-200:]))
+
+    for seg in segments(text):
+        hd = re.search(r"<<HEREDOC(\d+)", seg)
+        body = bodies[int(hd.group(1))] if hd else None
+        plain = re.sub(r"<<HEREDOC\d+", "", seg)
+        try:
+            argv = shlex.split(plain, posix=True)
+        except ValueError:
+            argv = plain.split()
+        assigns = []
+        while argv and re.match(r"^\w+=", argv[0]):  # VAR=value prefixes
+            assigns.append(argv[0])
+            argv = argv[1:]
+        if assigns and not argv:  # NAME=value on its own: a shell variable for the rest of the command
+            for a_ in assigns:
+                k, v = a_.split("=", 1)
+                if "$(" not in v and "`" not in v:
+                    shell_vars[k] = expand_vars(v)
+            continue
+        if shell_vars:
+            plain = expand_vars(plain)
+            argv = [expand_vars(x) for x in argv]
+        if argv and argv[0] in ("time", "export"):
+            argv = argv[1:]
+        if not argv:
+            continue
+        exe = os.path.basename(argv[0].replace("\\", "/")).lower()
+        if exe == "cd" and len(argv) > 1:
+            d = _abs(argv[1])
+            if re.match(r"[A-Za-z]:/", d):
+                root = repo_abs.lower()
+                cwd_rel = "" if d.lower().rstrip("/") == root else (d[len(repo_abs) + 1:] if d.lower().startswith(root + "/") else None)
+            elif cwd_rel is not None:
+                n = os.path.normpath(os.path.join(cwd_rel or ".", d)).replace("\\", "/")
+                cwd_rel = None if n.startswith("..") else ("" if n == "." else n)
+            continue
+        if exe == "git" and len(argv) > 1 and argv[1] in ("checkout", "switch", "stash", "reset", "restore", "merge", "rebase", "pull"):
+            if argv[1] in ("checkout", "restore") and "--" in argv:
+                ps = [repo_path(f, cwd_rel, repo_abs) for f in argv[argv.index("--") + 1:]]
+            else:
+                ps = list(states.touched)
+            for p in ps:
+                if p:
+                    states.put(p, None, "git_" + argv[1])
+            log.append(("git", argv[1]))
+            continue
+        if exe == "cat" and body is not None:
+            m = re.search(r"(>>?)\s*(\"[^\"]+\"|'[^']+'|[^\s<]+)", plain)
+            if m:
+                p = repo_path(m.group(2), cwd_rel, repo_abs)
+                if p is None and aux is not None and re.match(r"[A-Za-z]:/", _abs(m.group(2))):
+                    aux[_abs(m.group(2))] = body  # helper file outside the repo, run later
+                if p:
+                    t = (body + ("\n" if body and not body.endswith("\n") else "")).encode("utf-8")
+                    if m.group(1) == ">":
+                        states.put(p, t, "heredoc")
+                    else:
+                        cur = states.get(p)
+                        states.put(p, None if cur is None else (b"" if cur is states.ABSENT else cur) + t, "heredoc_append")
+                    log.append(("heredoc", p))
+            continue
+        if exe.startswith("python"):
+            a2 = [x for x in argv[1:] if x != "-I"]
+            if body is not None and a2[:1] == ["-"]:
+                run_python(body, "python_heredoc")
+            elif a2[:1] == ["-c"] and len(a2) > 1:
+                run_python(a2[1], "python_c")
+            elif a2 and aux is not None and _abs(a2[0]) in aux:
+                run_python(aux[_abs(a2[0])], "python_helper", helper=_abs(a2[0]))
+            continue
+        if exe == "perl" and any(re.match(r"^-\w*i", a_) for a_ in argv[1:]):
+            # perl -pi / -0pi edits are not reproduced: their files become unknown, so runs use the commit's text
+            files_ = []
+            skip = False
+            for a_ in argv[1:]:
+                if skip:
+                    skip = False
+                    continue
+                if a_ in ("-e", "-E"):
+                    skip = True
+                    continue
+                if not a_.startswith("-"):
+                    files_.append(a_)
+            for f_ in files_:
+                p_ = repo_path(f_, cwd_rel, repo_abs)
+                if p_:
+                    states.put(p_, None, "perl_edit_unknown")
+            log.append(("perl_edit_unknown", files_))
+            continue
+        if exe == "sed":
+            redirect = re.search(r"\s>\s*(\"[^\"]+\"|'[^']+'|[^\s;&|]+)\s*$", plain)
+            sargs = argv[1:]
+            if redirect:
+                try:
+                    sargs = shlex.split(plain[:redirect.start()], posix=True)[1:]
+                except ValueError:
+                    continue
+            has_e = "-e" in sargs
+            files = [a for i, a in enumerate(sargs) if not a.startswith("-") and not (i and sargs[i - 1] == "-e")]
+            files = files if has_e else files[1:]
+            ps = []
+            for f in files:
+                rp = repo_path(f, cwd_rel, repo_abs)
+                if rp and any(ch in rp for ch in "*?["):
+                    ps += sorted(t for t in tracked if fnmatch.fnmatch(t, rp))
+                elif rp:
+                    ps.append(rp)
+            if any(a.startswith("-i") for a in sargs) and ps:
+                ok, err, changed = sandbox.run(states, set(ps), cwd_rel, "sed", sargs)
+                for p in ps:
+                    if states.get(p) is not None and p in changed:
+                        states.put(p, changed[p], "sed")
+                log.append(("sed" if ok else "sed_failed", ps))
+            elif redirect and ps:
+                dst = repo_path(redirect.group(1), cwd_rel, repo_abs)
+                if dst:
+                    known = all(states.get(p) not in (None, states.ABSENT) for p in ps)
+                    ok, err, out = sandbox.run(states, set(ps), cwd_rel, "sed_stdout", sargs)
+                    states.put(dst, out if ok and known else None, "sed_redirect")
+                    log.append(("sed_redirect" if ok else "sed_redirect_failed", dst))
+            continue
+        if exe in ("cp", "mv") and len(argv) >= 3:
+            src = repo_path(argv[-2], cwd_rel, repo_abs)
+            dst = repo_path(argv[-1], cwd_rel, repo_abs)
+            if dst and (dst in tracked or (src and src in tracked)):
+                if argv[-1].endswith("/") or (src and "." in os.path.basename(src) and "." not in os.path.basename(dst)):
+                    dst = dst.rstrip("/") + "/" + os.path.basename(src or argv[-2])
+                states.put(dst, states.get(src) if src else None, exe)
+                if exe == "mv" and src:
+                    states.put(src, states.ABSENT, "mv")
+                log.append((exe, src, dst))
+            continue
+        m = re.search(r"(?:(?<![0-9&])>>?|\btee\s+(?:-a\s+)?|Set-Content\s+|Out-File\s+)\s*(\"[^\"]+\"|'[^']+'|[^\s;&|]+)", plain)
+        if m:
+            p = repo_path(m.group(1), cwd_rel, repo_abs)
+            if p and p in tracked:
+                states.put(p, None, "shell_write")
+                log.append(("unknown", p))
diff --git a/Dataset/ReplayScripts/ue_replay.py b/Dataset/ReplayScripts/ue_replay.py
new file mode 100644
index 0000000000000000000000000000000000000000..7bc14e72764a0b22b40148f922511ba4fc1ca5d5
--- /dev/null
+++ b/Dataset/ReplayScripts/ue_replay.py
@@ -0,0 +1,326 @@
+"""Unreal creation replay: rebuild a game from its first commit by re-running what its builder ran.
+
+  python ue_replay.py ledger  --game <game>                           windows, runs, script texts -> work/ledger.json
+  python ue_replay.py prepare --game ...                             isolated project at the first commit (+ truth)
+  python ue_replay.py run     --game ... [--until <window>]          execute the plan (resumable)
+  python ue_replay.py dump    --game ... --which replay|truth        structure dump (maps, assets) through the editor
+  python ue_replay.py verify  --game ...                             final state vs the final commit
+  python ue_replay.py derive  --game ...                             world ops from the per-run map exports
+  python ue_replay.py record  --game ...                             visible world replay + capture (GPU job)
+  python ue_replay.py status  --game ...
+  python ue_replay.py package --game ... [--force]                     deliverables/_replay/<game>/<sha8>/ (READY when complete)
+  python ue_replay.py live    --game ... [--log <file>] [--restart N] per-commit replay of a live game (background job)
+  python ue_replay.py live-status                                     every live game: HEAD, replayed windows, last result
+  python ue_replay.py truth   --game ...                              truth project at the final commit, editor built
+  python ue_replay.py release --game ...                              catch up, truth, dumps, verify, package
+
+See docs/ue-replay.md. Every engine process runs through <root>/tools/ue-heavy.ps1 (machine root: machine/lib/gfroot.py).
+--game is a game slug (its settings are <root>/games/<slug>/ReplayConfig.json, kept in the game's own repo) or a path to a
+settings file (e.g. a delivered ReplayScripts/game.json). Settings may use {root} for the machine root.
+"""
+import argparse
+import json
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(HERE, "..", "..", "machine", "lib"))
+
+
+def machine_root():
+    try:
+        import gfroot
+        r = gfroot.root()
+    except ImportError:  # outside the studio-tools checkout (a delivered ReplayScripts/): env GF_ROOT or ~/Work
+        r = os.environ.get("GF_ROOT") or os.path.join(os.path.expanduser("~"), "Work")
+    return r.replace("\\", "/")
+
+
+def out_root():
+    """Where packages go: machine/lib/gfroot.out() (env GF_OUT, config "out", else <root>/deliverables)."""
+    try:
+        import gfroot
+        return gfroot.out().replace("\\", "/")
+    except ImportError:
+        return (os.environ.get("GF_OUT") or machine_root() + "/deliverables").replace("\\", "/")
+
+
+def check_free(path, what):
+    """Stop before a disk-heavy step when the drive is below the free-space floor (env GF_MIN_FREE_GB, default 50 GB)."""
+    try:
+        import gfroot
+        return gfroot.check_free(path, what)
+    except ImportError:
+        import shutil
+        p = os.path.abspath(path)
+        while not os.path.exists(p) and os.path.dirname(p) != p:
+            p = os.path.dirname(p)
+        free, floor = shutil.disk_usage(p).free / 2 ** 30, float(os.environ.get("GF_MIN_FREE_GB") or 50)
+        if free < floor:
+            sys.exit("%s: only %.1f GB free (floor %.0f GB, GF_MIN_FREE_GB)" % (what, free, floor))
+        return free
+
+
+# Settings keys that describe what the RECORDING says (commands and paths of the machine the game was built on), not
+# places on this machine: they stay templates and are matched with recorded_regex().
+RECORDED_KEYS = ("match", "recorded")
+
+
+def machine_engine(project=None):
+    """The UE root for the game: its .uproject's EngineAssociation picks the install (gfroot.engine), so a game made on
+    an older engine replays on it; without a project, "engine" in the machine config. A dataset's ReplayScripts copy has
+    no gfroot: there the association of the project (or of the dataset's UEProject next to it) names the default
+    install folder, UE_<version>."""
+    try:
+        import gfroot
+        return gfroot.engine(project)
+    except ImportError:
+        pass
+    assoc = ""
+    for d in ([project, os.path.join(project, "..", "UEProject")] if project else []):
+        ups = sorted(f for f in os.listdir(d) if f.lower().endswith(".uproject")) if os.path.isdir(d) else []
+        if ups:
+            with open(os.path.join(d, ups[0]), encoding="utf-8-sig") as f:
+                assoc = str(json.load(f).get("EngineAssociation") or "")
+            break
+    return "C:/Program Files/Epic Games/UE_%s" % (assoc if re.fullmatch(r"\d+\.\d+", assoc) else "5.8")
+
+
+# {pipeline}: this checkout's tools/ue-pipeline folder, for run_patterns scripts that are pipeline tools (e.g.
+# "{pipeline}/scrub-import-paths.py"): a game's settings then name no tool repo, and the runner still takes the script's
+# version at the run time from that repo's history (runner.external_script).
+PIPELINE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "ue-pipeline").replace("\\", "/")
+
+
+def expand(v, root, project=None):
+    if isinstance(v, str):
+        if "{engine}" in v:
+            v = v.replace("{engine}", machine_engine(project))
+        v = v.replace("{pipeline}", PIPELINE)
+        return v.replace("{root}", root).replace("{home}", os.path.expanduser("~").replace("\\", "/"))
+    if isinstance(v, list):
+        return [expand(x, root, project) for x in v]
+    if isinstance(v, dict):
+        return {k: (x if k in RECORDED_KEYS else expand(x, root, project)) for k, x in v.items()}
+    return v
+
+
+def recorded_regex(template):
+    """A settings template for text in the recording, as a regex that matches it on any machine: {home} = any user
+    profile (C:/Users/<name>, C:\\Users\\<name>, /c/Users/<name>), {root} = any path prefix, * = one path component (in
+    "recorded" paths only), "/" = either slash; everything else literal."""
+    out, i = [], 0
+    while i < len(template):
+        if template.startswith("{home}", i):
+            out.append(r"(?:[A-Za-z]:|/[A-Za-z])[\\/]+Users[\\/]+[^\\/\s'\"]+")
+            i += 6
+        elif template.startswith("{root}", i):
+            out.append(r"(?:[A-Za-z]:|/[A-Za-z])(?:[\\/]+[^\\/\s'\"]+)*?")
+            i += 6
+        else:
+            out.append(re.escape(template[i]))
+            i += 1
+    return re.compile("".join(out), re.I)
+
+
+def recorded_path_regex(template):
+    """recorded_regex for a path: also * = one path component and / = any separator (/, \\, or an escaped \\\\)."""
+    sep = r"(?:/|\\{1,2})+"
+    out, i = [], 0
+    while i < len(template):
+        if template.startswith("{home}", i):
+            out.append(r"(?:[A-Za-z]:|/[A-Za-z])%sUsers%s[^\\/\s'\"]+" % (sep, sep))
+            i += 6
+        elif template.startswith("{root}", i):
+            out.append(r"(?:[A-Za-z]:|/[A-Za-z])(?:%s[^\\/\s'\"]+)*?" % sep)
+            i += 6
+        elif template.startswith("/**/", i):   # any number of components (also none)
+            out.append(r"(?:%s[^\\/\s'\"]+)*?%s" % (sep, sep))
+            i += 4
+        elif template[i] == "/":
+            out.append(sep)
+            i += 1
+        elif template[i] == "*":
+            out.append(r"[^\\/\s'\"]*")
+            i += 1
+        else:
+            out.append(re.escape(template[i]))
+            i += 1
+    return re.compile("".join(out), re.I)
+
+
+# Packaged copies of recorded data (ReplayScripts: ledger, script blobs, settings, reports) name the build machine's
+# per-session folders; those names are noise for a buyer and identify the session. They become neutral names that the
+# settings templates ({home}/AppData/Local/Temp/**/..., {home}/AppData/Roaming/**/...) still match.
+_SEP = r"([\\/]{1,2})"
+_UUID = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
+SESSION_PATH_RULES = [
+    # Temp/<tool>/<project-dir>/<session uuid>[/scratch-pad] (scratch, tasks, shell-snapshots ...) -> Temp/session[/scratch]
+    ("session_temp", re.compile(r"(?i)(?P<head>AppData(?P<s>[\\/]{1,2})Local(?P=s)Temp(?P=s))[^\\/\s'\"]+(?P=s)"
+                                r"[^\\/\s'\"]+(?P=s)(?:%s|[0-9a-f]{8}(?:-[0-9a-f]{0,12}){0,4}(?=[\"']|\\\"|$))"
+                                r"(?P<pad>(?P=s)scratc[h]pad(?![\w-]))?" % _UUID),   # also a uuid cut by a 2000-character command limit
+     lambda m: m.group("head") + "session" + ((m.group("s") + "scratch") if m.group("pad") else "")),
+    ("session_notes", re.compile(r"(?i)(AppData)%s(Roaming)%s[^\\/\s'\"]+%sside-sessio[n]-notes%slocal[_][0-9a-f]{8}-[0-9a-f]{4}-"
+                                 r"[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" % ((_SEP,) * 4)),
+     lambda m: "%s%s%s%ssession%snotes" % (m.group(1), m.group(2), m.group(3), m.group(4), m.group(4))),
+    ("session_id", re.compile(r"\blocal[_]%s\b" % _UUID), lambda m: "session"),
+]
+
+
+def neutral_session_paths(text, session_ids=()):
+    """(new text, {rule: count}) with the build machine's session folders and ids replaced (SESSION_PATH_RULES), and
+    the given session uuids (the recording's own session_id values) wherever they still stand alone. Other uuids
+    (Fab listing ids, asset guids) are content and stay."""
+    counts = {}
+    for rid, rx, f in SESSION_PATH_RULES:
+        text, n = rx.subn(f, text)
+        if n:
+            counts[rid] = n
+    if session_ids:
+        rx = re.compile(r"(?i)\b(?:%s)\b" % "|".join(re.escape(s) for s in session_ids))
+        text, n = rx.subn("session", text)
+        if n:
+            counts["session_uuid"] = n
+    return text, counts
+
+
+def recording_session_ids(cfg):
+    """The session uuids in a game's recording (actions.jsonl session_id), and the uuids of any Temp session folder the
+    recorded commands name: the ids neutral_session_paths replaces."""
+    ids = set()
+    p = os.path.join(cfg.get("recording", ""), "actions.jsonl")
+    if os.path.isfile(p):
+        rx = re.compile(r"(?i)Temp[\\/]{1,2}[^\\/\s'\"]+[\\/]{1,2}[^\\/\s'\"]+[\\/]{1,2}(%s)" % _UUID)
+        with open(p, encoding="utf-8", errors="replace") as f:
+            for line in f:
+                try:
+                    a = json.loads(line)
+                except ValueError:
+                    continue
+                if a.get("session_id"):
+                    ids.add(str(a["session_id"]).lower())
+                ids.update(m.group(1).lower() for m in rx.finditer(line))
+    return sorted(i for i in ids if re.fullmatch(_UUID, i))
+
+
+def has_recorded(match, text):
+    """Where the settings' match string occurs in a recorded command: a plain substring, or with {home}/{root} any
+    machine's path. Returns the start index or -1."""
+    if "{home}" not in match and "{root}" not in match:
+        return text.find(match)
+    m = recorded_regex(match).search(text)
+    return m.start() if m else -1
+
+
+def resolve_cfg(game):
+    """The settings file for --game: an existing path (absolute, or relative to the cwd or to this folder), else the
+    game repo's ReplayConfig.json under the machine root."""
+    for cand in (game, os.path.join(HERE, game)):
+        if os.path.isfile(cand):
+            return os.path.abspath(cand)
+    p = os.path.join(machine_root(), "games", game, "ReplayConfig.json")
+    if os.path.isfile(p):
+        return p
+    raise SystemExit("no replay settings for %r: expected %s (in the game's repo) or a path to a settings file" % (game, p))
+
+
+def load_cfg(path):
+    p = resolve_cfg(path)
+    with open(p, encoding="utf-8") as f:
+        raw = json.load(f)
+    cfg = expand(raw, machine_root(), os.path.dirname(p))   # the settings sit next to the game's .uproject
+    # "{engine}" settings follow the engine the project names at each replayed commit (runner.Ctx.engine_for): a game
+    # ported to a newer engine replays its early commits on the old one. The raw drops keep "{engine}" for that.
+    cfg["_engine_per_commit"] = "{engine}" in str(raw.get("engine", ""))
+    cfg["_raw_drops"] = raw.get("asset_drops", [])
+    cfg["root"] = machine_root()
+    cfg["_path"] = p
+    w = cfg["work_root"]
+    cfg.setdefault("project_dir", os.path.join(w, "project"))
+    cfg.setdefault("truth_dir", os.path.join(w, "truth"))
+    cfg.setdefault("work_dir", os.path.join(w, "work"))
+    os.makedirs(cfg["work_dir"], exist_ok=True)
+    return cfg
+
+
+def write_json(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        json.dump(obj, f, ensure_ascii=False, indent=1)
+        f.write("\n")
+
+
+def save_ledger(cfg, led, blobs):
+    bd = os.path.join(cfg["work_dir"], "blobs")
+    os.makedirs(bd, exist_ok=True)
+    for h, b in blobs.items():
+        p = os.path.join(bd, h)
+        if not os.path.exists(p):
+            with open(p, "wb") as f:
+                f.write(b)
+    write_json(os.path.join(cfg["work_dir"], "ledger.json"), led)
+
+
+def cmd_ledger(cfg, a):
+    import ledger
+    led, blobs = ledger.build(cfg)
+    save_ledger(cfg, led, blobs)
+    print(json.dumps(led["counts"], indent=1))
+    if a.verbose:
+        for w in led["windows"][1:]:
+            print("== %02d %s %s %s" % (w["index"], w["sha"][:7], w["time"][11:19], w["subject"][:70]))
+            print("   inputs %d, content %d, events %s, reconstruction %d/%d" % (
+                len(w["inputs"]), len(w["content"]), w["events"],
+                sum(1 for c in w["reconstruction"] if c["match"]), len(w["reconstruction"])))
+            for d in w["drops"]:
+                print("   drop", d["id"], d["time"][11:19])
+            for s in w["shell"]:
+                print("   shell", s["argv"], s["time"][11:19])
+            for r in w["runs"]:
+                print("   %s %s %-40s %-20s ro=%d ec=%s rows=%d unknown=%s" % (
+                    r["id"], r["start"][11:19], r["script"][-40:], r["script_version"], r["readonly"], r["exit_code"],
+                    len(r["rows"]), ",".join(os.path.basename(u) for u in r["unknown"])))
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("command")
+    ap.add_argument("--game", default=None)
+    ap.add_argument("--log", default=None)
+    ap.add_argument("--restart", type=int, default=None)   # live: replay again from window N+1 (project back to window N)
+    ap.add_argument("--verbose", "-v", action="store_true")
+    ap.add_argument("--until", type=int, default=None)
+    ap.add_argument("--which", default="replay")
+    ap.add_argument("--only", default=None)
+    ap.add_argument("--force", action="store_true")
+    ap.add_argument("--yes", action="store_true")
+    ap.add_argument("--speed", type=float, default=1.0)
+    a = ap.parse_args()
+    sys.stdout.reconfigure(encoding="utf-8")
+    if a.command == "live-status":
+        import live
+        return live.cmd_live_status(machine_root())
+    if not a.game:
+        ap.error("--game is required for " + a.command)
+    cfg = load_cfg(a.game)
+    fn = globals().get("cmd_" + a.command)
+    if fn is None:
+        import importlib
+        for mod in ("runner", "verify", "derive", "record", "package", "live"):
+            fn = getattr(importlib.import_module(mod), "cmd_" + a.command, None)
+            if fn:
+                break
+    if fn is None:
+        ap.error("unknown command " + a.command)
+    # disk-heavy steps refuse to start on a nearly full drive (a disk that filled mid-run corrupted a replay once)
+    if a.command in ("prepare", "run", "dump", "live", "truth", "release"):
+        check_free(cfg["work_root"], "ue_replay " + a.command)
+    elif a.command == "package":
+        check_free(out_root(), "ue_replay package")
+    return fn(cfg, a)
+
+
+if __name__ == "__main__":
+    sys.exit(main() or 0)
diff --git a/Dataset/ReplayScripts/verify.py b/Dataset/ReplayScripts/verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..990762ea79b8d9d683d470eddaa69ff51e417002
--- /dev/null
+++ b/Dataset/ReplayScripts/verify.py
@@ -0,0 +1,599 @@
+"""verify: the replayed project against the final commit (docs/ue-replay.md, 2.4).
+
+  files      every tracked file: identical bytes (sha256 for LFS objects, git blob id otherwise), differs, missing; extras
+  assets     dump-replay/assets.json vs dump-truth/assets.json: class and per-class digest per package
+  maps       per map: actors matched by class + label + folder (then nearest position); transform, components, settings,
+             game-class properties compared; references to other actors compared by their labels
+  rows       each replayed script run's workflow rows vs the original run's rows (op, target, status, params)
+  verdict    PASS / FAIL against the criteria below; the dataset is COMPLETE only with PASS
+Writes work/Verification/report.json and report.md.
+
+Pass criteria (all must hold; docs/ue-replay.md 2.4):
+  1. every tracked file outside Content/ is byte-identical to the final commit, none missing, no extra files except
+     git-ignored ones (e.g. __pycache__);
+  2. every asset of the final commit exists in the replay with the same class and the same structure digest;
+  3. every game map (settings map_roots) has the same actors (matched by class, label, folder) with the same
+     transform, components and properties, and the same world settings.
+Known differences that are not content are normalised before comparing, counted and listed in the report
+(NORMALISE); Content/ bytes are not compared for the verdict (Unreal writes random GUIDs into every saved package).
+"""
+import collections
+import json
+import math
+import os
+import re
+
+import runner
+
+IGNORED_DIRS = ("Binaries/", "Intermediate/", "Saved/", "DerivedDataCache/", ".git/", ".vs/", "Build/", "Packaged/")
+TOL = 0.011
+
+
+def close(a, b):
+    if isinstance(a, float) or isinstance(b, float):
+        try:
+            return math.isclose(float(a), float(b), rel_tol=1e-4, abs_tol=TOL)
+        except (TypeError, ValueError):
+            return a == b
+    if isinstance(a, list) and isinstance(b, list):
+        return len(a) == len(b) and all(close(x, y) for x, y in zip(a, b))
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(close(a[k], b[k]) for k in a)
+    return a == b
+
+
+def diff_keys(a, b, prefix=""):
+    out = []
+    if isinstance(a, dict) and isinstance(b, dict):
+        for k in sorted(set(a) | set(b)):
+            if k not in a or k not in b:
+                out.append(prefix + k)
+            elif not close(a[k], b[k]):
+                if isinstance(a[k], dict) and isinstance(b[k], dict):
+                    out += diff_keys(a[k], b[k], prefix + k + ".")
+                else:
+                    out.append(prefix + k)
+    elif not close(a, b):
+        out.append(prefix.rstrip(".") or "value")
+    return out
+
+
+# Known non-content differences, normalised before comparing (each counted in the report):
+NORMALISE = [
+    ("guid", "random GUIDs Unreal writes on save (ExpressionGUID, Guid=...)",
+     lambda s: re.sub(r"(?i)(guid=)[0-9a-f]{32}", r"\1<guid>", s)),
+    ("loc_key", "random localization keys Unreal generates for text properties (NSLOCTEXT(\"\", \"<32 hex>\", ...))",
+     lambda s: re.sub(r'NSLOCTEXT\(\\"([^"\\]*)\\", \\"[0-9A-Fa-f]{32}\\"', r'NSLOCTEXT(\\"\1\\", \\"<key>\\"', s)),
+    ("memory_address", "memory addresses in printed object values (delegates: '(0x00000801...)')",
+     lambda s: re.sub(r"\(0x[0-9A-Fa-f]+\)", "(0x)", s)),
+]
+
+
+def add_project_path_rule(cfg):
+    """Absolute paths under the project folder (import sources: FontFace source_filename, texture import data) name the
+    folder the editor ran in: the game repo for truth, the replay project for the replay, and the original user's
+    profile (or its scrubbed form). Compared as <project>/... ; counted as project_path."""
+    if any(r[0] == "project_path" for r in NORMALISE):
+        return
+    pats = []
+    for root in (cfg.get("repo"), cfg.get("project_dir"), cfg.get("truth_dir")):
+        if not root:
+            continue
+        parts = [p for p in root.replace("\\", "/").split("/") if p]
+        rx = []
+        for i, p in enumerate(parts):
+            # the profile folder after Users/ may hold any (or a scrubbed) user name
+            rx.append(r"[^/\\\"]+" if i > 0 and parts[i - 1].lower() == "users" else re.escape(p))
+        pats.append(r"(?:/|\\\\)+".join(rx))
+    big = re.compile("(?i)(?:%s)(?=/|\\\\)" % "|".join(pats))
+    # a whole string value naming a file inside the project, absolute ("C:\\...\\RawAssets\\x.ttf") or project-relative
+    # ("RawAssets/x.ttf", as the import-path scrub rewrites it): both as "RawAssets/x.ttf"
+    whole = re.compile(r'"<project>((?:(?:/|\\\\)+[^"/\\]+)+)"')
+
+    def rule(s):
+        s = big.sub("<project>", s)
+        return whole.sub(lambda m: '"' + re.sub(r"(?:/|\\\\)+", "/", m.group(1)).lstrip("/") + '"', s)
+    NORMALISE.append(("project_path", "paths into the folder the editor ran in (game repo vs replay project, user "
+                      "profile name; absolute or project-relative) in import-source fields", rule))
+
+
+DROP_KEYS = {
+    "tags.Compressed Size (KB)": ("derived_compression_size", "AnimSequence compressed size: derived data of the "
+                                  "compression codec run, not authored content"),
+}
+
+
+def norm_with(obj, rules):
+    s = json.dumps(obj, ensure_ascii=False, sort_keys=True)
+    for _, _, f in rules:
+        s = f(s)
+    return json.loads(s)
+
+
+def tolerant_diff(a, b, counts):
+    """diff_keys after the known non-content differences are taken out; counts[rule] += 1 for each rule that removed
+    a difference."""
+    dk = diff_keys(a, b)
+    if not dk:
+        return []
+    for k in list(dk):
+        if k in DROP_KEYS:
+            dk.remove(k)
+            counts[DROP_KEYS[k][0]] += 1
+    if not dk:
+        return []
+    na, nb = norm_with(a, NORMALISE), norm_with(b, NORMALISE)
+    rest = [k for k in diff_keys(na, nb) if k not in DROP_KEYS]
+    if len(rest) < len(dk):
+        # attribute to the first rule that alone removes some difference
+        for rid, _, f in NORMALISE:
+            if len([k for k in diff_keys(norm_with(a, [(rid, "", f)]), norm_with(b, [(rid, "", f)])) if k not in DROP_KEYS]) < len(dk):
+                counts[rid] += 1
+    return rest
+
+
+# ------------------------------------------------------------------------------------------------ files
+def verify_files(ctx, final):
+    ids = runner.tree_ids(ctx.proj, final)
+    have = {}
+    for dp, dns, fns in os.walk(ctx.proj):
+        rel_d = os.path.relpath(dp, ctx.proj).replace("\\", "/")
+        if rel_d != "." and (rel_d + "/").startswith(IGNORED_DIRS):
+            dns[:] = []
+            continue
+        for fn in fns:
+            rel = os.path.relpath(os.path.join(dp, fn), ctx.proj).replace("\\", "/")
+            have[rel] = os.path.join(dp, fn)
+    res = {"content": collections.Counter(), "other": collections.Counter(), "differs": [], "missing": [], "extra": []}
+    for p, ident in ids.items():
+        cat = "content" if p.startswith("Content/") else "other"
+        if p not in have:
+            res[cat]["missing"] += 1
+            res["missing"].append(p)
+        elif runner.file_matches(have[p], ident):
+            res[cat]["identical"] += 1
+        else:
+            res[cat]["differs"] += 1
+            res["differs"].append(p)
+    for p in have:
+        if p not in ids:
+            res["extra"].append(p)
+    res["content"] = dict(res["content"])
+    res["other"] = dict(res["other"])
+    return res
+
+
+# ------------------------------------------------------------------------------------------------ assets
+def verify_assets(rep, tru, counts=None):
+    counts = counts if counts is not None else collections.Counter()
+    a = {(x["package"], x["name"]): x for x in rep["assets"]}
+    b = {(x["package"], x["name"]): x for x in tru["assets"]}
+    by_class = collections.defaultdict(collections.Counter)
+    diffs, load_err = [], []
+    for k, t in b.items():
+        cls = t["class"]
+        if k not in a:
+            by_class[cls]["missing"] += 1
+            diffs.append({"asset": k[0], "class": cls, "result": "missing"})
+            continue
+        r = a[k]
+        if r["class"] != cls:
+            by_class[cls]["class_differs"] += 1
+            diffs.append({"asset": k[0], "class": cls, "result": "class", "replay_class": r["class"]})
+            continue
+        if r.get("error") or t.get("error"):
+            # an asset that cannot be loaded: equal only when it fails the same way on both sides
+            dk = [] if r.get("error") == t.get("error") else ["error"]
+            if not dk:
+                counts["asset_load_error_both"] += 1
+                load_err.append({"asset": k[0], "class": cls, "error": t.get("error")})
+        else:
+            dk = tolerant_diff(r.get("digest", {}), t.get("digest", {}), counts)
+        if dk:
+            by_class[cls]["differs"] += 1
+            diffs.append({"asset": k[0], "class": cls, "result": "differs", "keys": dk[:20]})
+        else:
+            by_class[cls]["same"] += 1
+    for k, r in a.items():
+        if k not in b:
+            by_class[r["class"]]["extra"] += 1
+            diffs.append({"asset": k[0], "class": r["class"], "result": "extra"})
+    total = collections.Counter()
+    for c in by_class.values():
+        total.update(c)
+    return {"total": dict(total), "by_class": {k: dict(v) for k, v in sorted(by_class.items())}, "diffs": diffs,
+            "load_error_both": load_err}
+
+
+# ------------------------------------------------------------------------------------------------ maps
+REF = re.compile(r"(/Game/[^\"' ]+\.[^:\"' ]+:PersistentLevel\.)([A-Za-z0-9_]+)")
+
+
+def normalize_refs(obj, names):
+    """Actor references (…:PersistentLevel.StaticMeshActor_12) by label, so spawn-name counters don't matter."""
+    s = json.dumps(obj, ensure_ascii=False, sort_keys=True)
+    s = REF.sub(lambda m: "<actor:%s>" % names.get(m.group(2).split(".")[0], m.group(2)) + ("" if "." not in m.group(2) else ""), s)
+    return json.loads(s)
+
+
+def actor_view(x, names):
+    v = {k: x.get(k) for k in ("class", "label", "folder", "location", "rotation", "scale", "tags", "hidden", "attach_parent", "ppv")}
+    comps = []
+    for c in x.get("components", []):
+        c = dict(c)
+        c.pop("name", None)  # component instance names (…_0, …_1) depend on creation counters
+        comps.append(c)
+    comps.sort(key=lambda c: json.dumps(c, sort_keys=True))
+    v["components"] = comps
+    if "props" in x:
+        p = {k: val for k, val in x["props"].items() if k not in ("root_component",)}
+        v["props"] = p
+    return normalize_refs(v, names)
+
+
+def match_actors(ra, ta):
+    """Pairs (replay, truth): same class + label + folder; within a group, nearest location first."""
+    groups = collections.defaultdict(lambda: ([], []))
+    for x in ra:
+        groups[(x["class"], x["label"], x["folder"])][0].append(x)
+    for x in ta:
+        groups[(x["class"], x["label"], x["folder"])][1].append(x)
+    pairs, missing, extra = [], [], []
+    for key, (rs, ts) in groups.items():
+        rs = list(rs)
+        for t in ts:
+            if not rs:
+                missing.append(t)
+                continue
+            best = min(rs, key=lambda r: sum((a - b) ** 2 for a, b in zip(r["location"], t["location"])))
+            rs.remove(best)
+            pairs.append((best, t))
+        extra += rs
+    return pairs, missing, extra
+
+
+def verify_map(rep, tru, counts=None):
+    counts = counts if counts is not None else collections.Counter()
+    rn = {x["name"]: x["label"] for x in rep["actors"]}
+    tn = {x["name"]: x["label"] for x in tru["actors"]}
+    pairs, missing, extra = match_actors(rep["actors"], tru["actors"])
+    exact, differs = 0, []
+    field_counts = collections.Counter()
+    for r, t in pairs:
+        dk = tolerant_diff(actor_view(r, rn), actor_view(t, tn), counts)
+        if dk:
+            differs.append({"label": t["label"], "class": t["class"].rsplit(".", 1)[-1], "fields": dk[:12]})
+            for k in dk:
+                field_counts[k.split(".")[0]] += 1
+        else:
+            exact += 1
+    return {"truth_actors": len(tru["actors"]), "replay_actors": len(rep["actors"]), "matched": len(pairs), "identical": exact,
+            "differs": len(differs), "missing": len(missing), "extra": len(extra),
+            "differing_fields": dict(field_counts.most_common()),
+            "world_settings_same": close(rep.get("world_settings"), tru.get("world_settings")),
+            "detail": {"differs": differs[:200], "missing": [(x["class"].rsplit(".", 1)[-1], x["label"]) for x in missing][:200],
+                       "extra": [(x["class"].rsplit(".", 1)[-1], x["label"]) for x in extra][:200]}}
+
+
+# ------------------------------------------------------------------------------------------------ rows
+def mask(v, roots):
+    s = json.dumps(v, ensure_ascii=False, sort_keys=True)
+    for r in roots:
+        s = s.replace(r, "<project>").replace(r.replace("/", "\\\\"), "<project>")
+    s = re.sub(r"\d+\.\d{3,}", lambda m: "%.2f" % float(m.group(0)), s)
+    return json.loads(s)
+
+
+def verify_rows(ctx, ledger):
+    orig = {}
+    with open(os.path.join(ctx.cfg["truth_dir"], "workflow.jsonl"), encoding="utf-8") as f:
+        for l in f:
+            if l.strip():
+                r = json.loads(l)
+                orig[r["id"]] = r
+    roots = [ctx.proj.replace("\\", "/"), ctx.cfg["repo"].replace("\\", "/")]
+    out = []
+    totals = collections.Counter()
+    for w in ledger["windows"]:
+        for run in w["runs"]:
+            p = os.path.join(ctx.work, "rows", run["id"] + ".jsonl")
+            if not os.path.exists(p):
+                continue
+            with open(p, encoding="utf-8") as f:
+                rep = [json.loads(l) for l in f if l.strip()]
+            org = [orig[i] for i in run["rows"] if i in orig]
+            key = lambda r: (r.get("op"), r.get("target"), r.get("status"))
+            same_ops = [key(r) for r in rep] == [key(r) for r in org]
+            same_params = same_ops and all(mask(a.get("params"), roots) == mask(b.get("params"), roots) for a, b in zip(rep, org))
+            res = "identical" if same_params else ("same_ops" if same_ops else "different")
+            if not org and not rep:
+                res = "none_logged"
+            totals[res] += 1
+            out.append({"run": run["id"], "script": run["script"], "result": res, "replayed": len(rep), "original": len(org),
+                        "replayed_ops": [key(r) for r in rep][:30], "original_ops": [key(r) for r in org][:30]})
+    return {"totals": dict(totals), "runs": out}
+
+
+# ------------------------------------------------------------------------------------------------ verdict
+def verdict(report, ctx, counts):
+    f = report["files"]
+    extra = f.get("extra", [])
+    ignored = set()
+    if extra:
+        try:
+            out = runner.git(ctx.proj, "check-ignore", "--stdin", inp=("\n".join(extra) + "\n").encode("utf-8"), check=False)
+            ignored = set(l.strip() for l in (out or "").splitlines() if l.strip())
+        except Exception:
+            ignored = set()
+    extra_real = [p for p in extra if p not in ignored]
+    other_missing = [p for p in f.get("missing", []) if not p.startswith("Content/")]
+    other_diff = [p for p in f.get("differs", []) if not p.startswith("Content/")]
+    crit = []
+    crit.append({"id": "files", "text": "every tracked file outside Content/ byte-identical; none missing; no extra files except git-ignored ones",
+                 "pass": not other_missing and not other_diff and not extra_real,
+                 "result": "%d identical, %d differ, %d missing; %d extra (%d git-ignored)" % (
+                     f["other"].get("identical", 0), len(other_diff), len(other_missing), len(extra), len(ignored)),
+                 "failures": (other_diff + other_missing + extra_real)[:50]})
+    if "assets" in report:
+        t = report["assets"]["total"]
+        bad = [d for d in report["assets"]["diffs"]]
+        crit.append({"id": "assets", "text": "every asset of the final commit present with the same class and structure digest",
+                     "pass": not bad, "result": "%d same, %d differ, %d missing, %d extra, %d class changed" % (
+                         t.get("same", 0), t.get("differs", 0), t.get("missing", 0), t.get("extra", 0), t.get("class_differs", 0)),
+                     "failures": [(d["asset"], d["result"], d.get("keys")) for d in bad][:50]})
+        mfail, msum = [], []
+        for m, v in report["maps"].items():
+            if "truth_actors" not in v:
+                mfail.append((m, v.get("result")))
+                continue
+            ok = v["missing"] == 0 and v["extra"] == 0 and v["differs"] == 0 and v["world_settings_same"]
+            msum.append("%s %d/%d" % (m.rsplit("/", 1)[-1], v["identical"], v["truth_actors"]))
+            if not ok:
+                mfail.append((m, "differs %d, missing %d, extra %d, world settings %s" % (v["differs"], v["missing"], v["extra"],
+                                                                                          "same" if v["world_settings_same"] else "differ")))
+        crit.append({"id": "maps", "text": "every game map: same actors (class, label, folder) with the same transform, components, "
+                                           "properties and world settings", "pass": not mfail and bool(report["maps"]),
+                     "result": "; ".join(msum) or "no maps", "failures": mfail[:50]})
+    else:
+        crit.append({"id": "assets", "text": "structure dumps of replay and truth", "pass": False, "result": "no structure dumps",
+                     "failures": ["run dump --which replay and --which truth"]})
+    exclusions = {
+        "content_bytes": {"what": "Content/ .uasset/.umap bytes: Unreal writes a random PersistentGuid into every saved package; "
+                                  "compared by structure instead (criteria assets, maps)",
+                          "count": f["content"].get("differs", 0)},
+        "maps_not_compared": {"what": (report.get("maps_excluded") or {}).get("reason", ""),
+                              "maps": (report.get("maps_excluded") or {}).get("maps", [])},
+        "git_ignored_extra_files": sorted(ignored),
+    }
+    if ctx.cfg.get("dump_exclusions"):
+        # folders left out of the structure dump (settings dump_exclusions: loading them crashes the editor, in the
+        # final commit too); their files are still compared byte for byte under criterion files / Content bytes
+        exclusions["structure_dump_excluded"] = {"what": "; ".join("%s: %s" % (d["path"], d["reason"]) for d in ctx.cfg["dump_exclusions"]),
+                                                 "count": len(ctx.cfg["dump_exclusions"])}
+    for rid, what, _ in NORMALISE:
+        exclusions[rid] = {"what": what, "count": counts.get(rid, 0)}
+    for k, (rid, what) in DROP_KEYS.items():
+        exclusions[rid] = {"what": what + " (key %s)" % k, "count": counts.get(rid, 0)}
+    if counts.get("asset_load_error_both"):
+        exclusions["asset_load_error_both"] = {"what": "assets that fail to load the same way in truth and replay (the "
+                                               "final commit's own content): compared by class and error only",
+                                               "count": counts["asset_load_error_both"]}
+    rows = report.get("rows", {}).get("totals", {})
+    return {"pass": all(c["pass"] for c in crit), "criteria": crit, "exclusions": exclusions,
+            "informational": {"workflow_rows_per_run": rows,
+                              "note": "row comparison is informational: rows carry times, ids and per-run counts"}}
+
+
+# ------------------------------------------------------------------------------------------------ report
+def deviations(ctx, report):
+    """Every place the replay departs from the raw recording, for buyers: what, which runs/items, which commit, why."""
+    cfg, led = ctx.cfg, ctx.ledger
+    runs = [dict(r, _w=w) for w in led["windows"] for r in w["runs"]]
+    out = []
+
+    def add(kind, what, items, reason=None):
+        if items:
+            out.append({"kind": kind, "what": what, "items": items, **({"reason": reason} if reason else {})})
+
+    for u in cfg.get("use_commit_text", []):
+        hit = [r for r in runs if r["script"] == u["script"] and r["_w"]["index"] in u.get("windows", [r["_w"]["index"]])]
+        add("commit_text_substituted", "script text taken from the commit instead of the recorded edits",
+            [{"script": u["script"], "window": w, "commit": next(r["_w"]["sha"] for r in hit if r["_w"]["index"] == w),
+              "runs": [r["id"] for r in hit if r["_w"]["index"] == w]} for w in sorted(set(r["_w"]["index"] for r in hit))],
+            u.get("reason"))
+    forced = set((u["script"], wi) for u in cfg.get("use_commit_text", []) for wi in u.get("windows", []))
+    other = [r for r in runs if r.get("script_version") == "unknown_use_commit" and (r["script"], r["_w"]["index"]) not in forced]
+    add("commit_text_unrebuildable", "script text the recording could not rebuild (e.g. perl -i edits, edits outside "
+        "the recording): the window's commit text is used", [{"script": r["script"], "window": r["_w"]["index"],
+                                                              "commit": r["_w"]["sha"], "run": r["id"]} for r in other])
+    ro_scripts = set(cfg.get("not_readonly", []))
+    add("readonly_script_replayed", "scripts a read-only pattern matches, replayed because a later run reads what they write",
+        [{"script": r["script"], "run": r["id"], "reason": next((n.get("reason") for n in cfg.get("not_readonly_runs", [])
+                                                                 if n.get("tool_use_id") == r.get("action_tool_use_id")), "settings not_readonly")}
+         for r in runs if not r.get("readonly") and (os.path.basename(r["script"]) in ro_scripts or
+                                                     any(n.get("tool_use_id") == r.get("action_tool_use_id") for n in cfg.get("not_readonly_runs", [])))])
+    add("runs_not_replayed", "runs listed in the recording that never started (settings not_run, or the wrapper logged no start)",
+        [{"script": r["script"], "run": r["id"], "reason": r.get("not_run") or "no wrapper row and no exit code: the command stopped before it"}
+         for r in runs if r.get("not_run") or (r.get("via_wrapper") and r.get("wrapper_rows") == 0 and r.get("exit_code") is None)])
+    add("runs_from_rows", "runs the recorded actions missed (a gap in the recording), rebuilt from the workflow row the "
+        "run wrapper wrote (settings runs_from_rows): script, time, duration and mode from the row",
+        [{"script": r["script"], "run": r["id"], "row": r["from_row"], "window": r["_w"]["index"],
+          "script_version": r.get("script_version")} for r in runs if r.get("from_row")])
+    add("readonly_runs_skipped", "probes/checks (settings readonly_patterns) listed but not replayed",
+        [{"script": r["script"], "run": r["id"]} for r in runs if r.get("readonly")])
+    add("shell_steps", "shell commands of the builder replayed from settings (delete, move-merge, host-python), each matched "
+        "to its recorded command", [{"match": s["match"], "argv": s["argv"], "reason": s.get("reason")} for s in cfg.get("shell_replay", [])])
+    add("asset_drops", "store packs and downloads restored into the project where the builder copied them in",
+        [{"id": d["id"], "packs": [it.get("pack") or it.get("to") for it in d["items"]], "reason": d.get("reason")} for d in cfg.get("asset_drops", [])])
+    add("external_sources_rebuilt", "external source folders rebuilt from library archives (the builder's scratch folder is gone)",
+        [{"id": e["id"], "rebuild": e["rebuild"], "reason": e.get("role")} for e in cfg.get("external_sources", []) if e.get("rebuild")])
+    retried = [json.loads(l) for l in open(os.path.join(ctx.work, "runs.jsonl"), encoding="utf-8")] \
+        if os.path.exists(os.path.join(ctx.work, "runs.jsonl")) else []
+    add("script_paths_remapped", "absolute paths in the builder's scripts to a file outside the project (on the machine "
+        "the game was built on) pointed at its copy on this machine for the run, then put back",
+        [{"source": e["id"], "recorded": e["recorded"], "copy": e.get("path") or "rebuilt",
+          "runs": [x.get("run") for x in retried if x.get("script_paths_remapped")]}
+         for e in cfg.get("external_sources", []) if e.get("remap_scripts")
+         and any(x.get("script_paths_remapped") for x in retried)], None)
+    add("engine_switch", "commits where the project moved to another engine (a port): from that window on the replay "
+        "builds and runs on the engine the commit names, with the old engine's build output cleared",
+        [{"window": x.get("window"), "commit": (x.get("commit") or "")[:10], "from": os.path.basename(x.get("from", "")),
+          "to": os.path.basename(x.get("to", ""))} for x in retried if x.get("kind") == "engine_switch"])
+    add("code_at_run_time", "runs replayed with the C++ as it stood when they started (the window's commit has later "
+        "code; the editor is rebuilt between runs)",
+        [{"run": x.get("run"), "script": x.get("script"), "code": x["code_at_run_time"]} for x in retried
+         if x.get("code_at_run_time") and not str(x["code_at_run_time"]).startswith("commit code")])
+    add("code_at_run_time_not_buildable", "runs whose run-time C++ did not compile here: they got the window's commit code",
+        [{"run": x.get("run"), "script": x.get("script"), "detail": x["code_at_run_time"]} for x in retried
+         if str(x.get("code_at_run_time") or "").startswith("commit code (")])
+    add("code_at_run_time_unknown", "runs whose C++ at that moment the recording cannot rebuild (a shell edit it cannot "
+        "follow): they got the window's commit code", [{"run": r["id"], "script": r["script"], "files": r["code_unknown"]}
+                                                      for r in runs if r.get("code_unknown") and not r.get("readonly")])
+    add("runs_retried_after_engine_crash", "runs the engine crashed in before the script finished, run once more",
+        [{"run": x.get("run"), "script": x.get("script"), "retries": x["retried_after_engine_crash"]} for x in retried if x.get("retried_after_engine_crash")])
+    add("structure_dump_excluded", "folders left out of the structure dump (loading them crashes the editor, in the final commit too)",
+        cfg.get("dump_exclusions", []))
+    add("assets_failing_to_load", "assets that fail to load the same way in both projects (compared by class and error only)",
+        (report.get("assets") or {}).get("load_error_both", []))
+    return out
+
+
+def cmd_report(cfg, a):
+    """Refresh an existing verification report without verifying again (the replay project may be gone): recompute
+    the deviations from the current settings and re-render report.md. Verdict, criteria and counts stay as verified."""
+    ctx = runner.Ctx(cfg)
+    vdir = os.path.join(ctx.work, "Verification")
+    report = runner.jload(os.path.join(vdir, "report.json"), None)
+    if not report:
+        raise SystemExit("no Verification/report.json to refresh: run verify")
+    add_project_path_rule(cfg)
+    report["deviations"] = deviations(ctx, report)
+    report["report_refreshed"] = runner.now()
+    runner.jdump(os.path.join(vdir, "report.json"), report)
+    with open(os.path.join(vdir, "report.md"), "w", encoding="utf-8", newline="\n") as f:
+        f.write(render_md(report, ctx))
+    print("report refreshed: %d deviation kinds; verdict %s (as verified %s)" % (
+        len(report["deviations"]), "PASS" if report["verdict"]["pass"] else "FAIL", report.get("time")))
+    print("VERDICT: %s" % ("PASS" if report["verdict"]["pass"] else "FAIL"))
+    return 0 if report["verdict"]["pass"] else 1
+
+
+def cmd_verify(cfg, a):
+    ctx = runner.Ctx(cfg)
+    final = ctx.ledger["final"]
+    add_project_path_rule(cfg)
+    vdir = os.path.join(ctx.work, "Verification")
+    os.makedirs(vdir, exist_ok=True)
+    rep_d, tru_d = os.path.join(ctx.work, "dump-replay"), os.path.join(ctx.work, "dump-truth")
+    report = {"schema": "ue-replay.verification/v1", "game": cfg["game"], "final_commit": final, "time": runner.now()}
+    report["files"] = verify_files(ctx, final)
+    counts = collections.Counter()
+    if os.path.exists(os.path.join(rep_d, "assets.json")) and os.path.exists(os.path.join(tru_d, "assets.json")):
+        report["assets"] = verify_assets(runner.jload(os.path.join(rep_d, "assets.json")), runner.jload(os.path.join(tru_d, "assets.json")), counts)
+        maps, excluded = {}, []
+        roots = [r.rstrip("/") + "/" for r in cfg.get("map_roots", [])]
+        for fn in sorted(os.listdir(os.path.join(tru_d, "maps"))):
+            if not fn.endswith(".json"):
+                continue
+            t = runner.jload(os.path.join(tru_d, "maps", fn))
+            # Only the game's own maps: store packs ship demo/showcase levels the builder never made (settings map_roots).
+            if roots and t["map"].startswith("/Game/") and not any(t["map"].startswith(r) for r in roots):
+                excluded.append(t["map"])
+                continue
+            rp = os.path.join(rep_d, "maps", fn)
+            maps[t["map"]] = verify_map(runner.jload(rp), t, counts) if os.path.exists(rp) else {"result": "map missing in replay"}
+        report["maps"] = maps
+        report["maps_excluded"] = {"reason": "outside the game's map roots %s: demo/showcase levels shipped inside store packs, "
+                                             "not built by the game's creator" % cfg.get("map_roots", []), "maps": excluded}
+    report["rows"] = verify_rows(ctx, ctx.ledger)
+    report["windows"] = [json.loads(l) for l in open(os.path.join(ctx.work, "windows.jsonl"), encoding="utf-8")] \
+        if os.path.exists(os.path.join(ctx.work, "windows.jsonl")) else []
+    for w in report["windows"]:
+        w.pop("detail", None)
+    report["verdict"] = verdict(report, ctx, counts)
+    report["deviations"] = deviations(ctx, report)
+    runner.jdump(os.path.join(vdir, "report.json"), report)
+    md = render_md(report, ctx)
+    with open(os.path.join(vdir, "report.md"), "w", encoding="utf-8", newline="\n") as f:
+        f.write(md)
+    print(md[:6000])
+    print("VERDICT: %s" % ("PASS" if report["verdict"]["pass"] else "FAIL"))
+    return 0 if report["verdict"]["pass"] else 1
+
+
+def render_deviations(devs):
+    """Markdown: every place the replay departs from the raw recording (also used by package.py's README)."""
+    L = ["## Deviations from the recording", ""]
+    if not devs:
+        return L + ["None: every step was replayed from the recording as recorded.", ""]
+    L += ["Everything below is done from the game's replay settings (`game.json`) rather than straight from the recorded",
+          "actions; each entry says why.", ""]
+    for d in devs:
+        L.append("### %s (%d)" % (d["kind"], len(d["items"])))
+        L += ["", d["what"] + (". Why: " + d["reason"] if d.get("reason") else "."), ""]
+        for it in d["items"][:60]:
+            if isinstance(it, dict):
+                L.append("- " + "; ".join("%s: %s" % (k, ", ".join(map(str, v)) if isinstance(v, list) else
+                                                      (v[:12] if k == "commit" and isinstance(v, str) else v))
+                                          for k, v in it.items() if v not in (None, "", [])))
+            else:
+                L.append("- %s" % it)
+        if len(d["items"]) > 60:
+            L.append("- ... %d more (report.json)" % (len(d["items"]) - 60))
+        L.append("")
+    return L
+
+
+def render_md(r, ctx):
+    L = ["# Replay verification: %s at %s" % (r["game"], r["final_commit"][:10]), ""]
+    v = r.get("verdict")
+    if v:
+        L += ["## Verdict: %s" % ("PASS" if v["pass"] else "FAIL"), "", "| criterion | result | pass |", "|---|---|---|"]
+        for c in v["criteria"]:
+            L.append("| %s | %s | %s |" % (c["text"], c["result"], "yes" if c["pass"] else "**no**"))
+        L += ["", "Known differences that are not content (normalised or not compared):", ""]
+        for k, e in v["exclusions"].items():
+            if isinstance(e, dict):
+                L.append("- %s: %s%s" % (k, e.get("what", ""), (" (%d)" % e["count"]) if "count" in e else
+                                         (" (%d maps: %s)" % (len(e.get("maps", [])), ", ".join(m.rsplit("/", 1)[-1] for m in e.get("maps", []))))))
+            else:
+                L.append("- %s: %d file(s)" % (k, len(e)))
+        L.append("")
+    L += render_deviations(r.get("deviations") or [])
+    f = r["files"]
+    L += ["## Files against the final commit", "",
+          "| | identical | differs | missing |", "|---|---:|---:|---:|",
+          "| outside Content/ | %d | %d | %d |" % (f["other"].get("identical", 0), f["other"].get("differs", 0), f["other"].get("missing", 0)),
+          "| Content/ | %d | %d | %d |" % (f["content"].get("identical", 0), f["content"].get("differs", 0), f["content"].get("missing", 0)),
+          "", "Files in the replay project that the commit does not have: %d." % len(f["extra"]), ""]
+    if "assets" in r:
+        t = r["assets"]["total"]
+        L += ["## Assets (structure dump)", "",
+              "Same class and digest: %d; differs: %d; missing: %d; extra: %d." % (t.get("same", 0), t.get("differs", 0), t.get("missing", 0), t.get("extra", 0)), "",
+              "| class | same | differs | missing | extra |", "|---|---:|---:|---:|---:|"]
+        for c, v in r["assets"]["by_class"].items():
+            L.append("| %s | %d | %d | %d | %d |" % (c, v.get("same", 0), v.get("differs", 0), v.get("missing", 0), v.get("extra", 0)))
+        L += ["", "## Maps (actor structure)", "",
+              "| map | actors (truth / replay) | matched | identical | differs | missing | extra | fields that differ |",
+              "|---|---|---:|---:|---:|---:|---:|---|"]
+        ex = r.get("maps_excluded") or {}
+        if ex.get("maps"):
+            L.insert(len(L) - 2, "Not compared (%d): %s." % (len(ex["maps"]), ex["reason"]))
+            L.insert(len(L) - 2, "")
+        for m, v in r["maps"].items():
+            if "truth_actors" not in v:
+                L.append("| %s | %s | | | | | | |" % (m, v.get("result")))
+                continue
+            L.append("| %s | %d / %d | %d | %d | %d | %d | %d | %s |" % (
+                m.rsplit("/", 1)[-1], v["truth_actors"], v["replay_actors"], v["matched"], v["identical"], v["differs"], v["missing"],
+                v["extra"], ", ".join("%s %d" % kv for kv in list(v["differing_fields"].items())[:6])))
+    rt = r["rows"]["totals"]
+    L += ["", "## Script runs: workflow rows replayed vs original", "",
+          ", ".join("%s %d" % kv for kv in sorted(rt.items())), ""]
+    if r["windows"]:
+        L += ["## Windows", "", "| # | commit | runs | seconds | fallback | exact | differs | missing | extra |", "|---:|---|---:|---:|---:|---:|---:|---:|---:|"]
+        for w in r["windows"]:
+            c = w["content"]
+            L.append("| %d | %s | %d | %.0f | %d | %d | %d | %d | %d |" % (w["window"], w["commit"][:7], w["runs"], w["seconds"], c.get("fallback", 0),
+                                                                  c.get("exact", 0), c.get("differs", 0), c.get("missing", 0), c.get("extra", 0)))
+    return "\n".join(L) + "\n"
