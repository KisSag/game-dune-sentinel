+--- /dev/null
++++ b/Source/DuneSentinel/AutoPlay/AutoPlaySubsystem.cpp
+@@ -0,0 +1,859 @@
++// AutoPlay: see AutoPlaySubsystem.h.
++#include "AutoPlaySubsystem.h"
++
++#include "AudioDevice.h"
++#include "ISubmixBufferListener.h"
