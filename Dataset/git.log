++        FVector Pos(FMath::Cos(Angle)*850000.f,FMath::Sin(Angle)*850000.f,Bomber?100000.f:130000.f+I*6000);
++        const FRotator Facing=(AirportLocation+FVector(0,0,65000)-Pos).Rotation();
