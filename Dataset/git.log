diff --git a/Dataset/ReplayScripts/ledger.py b/Dataset/ReplayScripts/ledger.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab0972d646539a935502666f0d48a90834ceb817
--- /dev/null
+++ b/Dataset/ReplayScripts/ledger.py
@@ -0,0 +1,711 @@
+"""Ledger: what the builder of a game ran, window by window, from three records.
+
+  git history          the commits on the first-parent chain up to the final commit (the windows' boundaries)
+  actions.jsonl        the agent's tool calls: editor-script runs (command lines), Write/Edit of files, shell commands
+  workflow.jsonl       the rows each script run logged (op, target, status, params) at the final commit
+
+Output (work/ledger.json, schema ue-replay.ledger/v1):
+  windows[]   one per commit: sha, parent, time, subject, inputs (paths changed outside Content/ and in Content/),
+              runs[] (editor-script runs in order, each with the reconstructed text of every script file at that
+              moment), drops[] and shell[] (from the game settings), reconstruction checks at the boundary
+  blobs       sha256 -> file text, stored by the caller in work/blobs/
+"""
+import collections
+import datetime
+import fnmatch
+import hashlib
+import json
+import os
+import re
+import shlex
+import subprocess
+
+import shellfx
+import ue_replay
+
+SCHEMA = "ue-replay.ledger/v1"
+
+
+def sha256(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def git(repo, *args, binary=False):
+    out = subprocess.run(["git", "-C", repo, "-c", "core.quotepath=off"] + list(args), capture_output=True, check=True)
+    return out.stdout if binary else out.stdout.decode("utf-8")
+
+
+def parse_time(s):
+    return datetime.datetime.fromisoformat(s)
+
+
+def norm_text(b):
+    """Text as stored in git (LF); scripts are compared and replayed with LF line ends."""
+    return b.replace(b"\r\n", b"\n")
+
+
+# ----------------------------------------------------------------------------------------------- commits
+def first_parent_chain(repo, final):
+    rows = git(repo, "log", "--first-parent", "--reverse", "--format=%H%x09%P%x09%cI%x09%s", final).splitlines()
+    out = []
+    for r in rows:
+        sha, parents, ctime, subject = r.split("\t", 3)
+        out.append({"sha": sha, "parents": parents.split(), "time": ctime, "subject": subject})
+    return out
+
+
+def changed_paths(repo, parent, sha):
+    """[(status, path)] of sha against its first parent (renames as delete + add)."""
+    if parent is None:
+        names = git(repo, "ls-tree", "-r", "--name-only", sha).splitlines()
+        return [("A", p) for p in names]
+    out = []
+    for line in git(repo, "diff", "--no-renames", "--name-status", parent, sha).splitlines():
+        st, p = line.split("\t", 1)
+        out.append((st[0], p))
+    return out
+
+
+def blob_at(repo, sha, path):
+    try:
+        return git(repo, "show", "%s:%s" % (sha, path), binary=True)
+    except subprocess.CalledProcessError:
+        return None
+
+
+# ----------------------------------------------------------------------------------------------- actions
+RUN_PATTERNS = [
+    # Scripts/ue.ps1 script -Script Scripts/x.py   (the game's wrapper)
+    re.compile(r"ue\.ps1\s+script\b[^|;&\n]*?-Script\s+(?P<script>[^\s'\"|;&]+)"),
+    # UnrealEditor-Cmd <proj> -run=pythonscript '-script=<path> --args'
+    re.compile(r"-run=pythonscript\s+['\"]?-script=(?P<script>[^'\"\s]+)(?P<args>[^'\"]*)['\"]?"),
+]
+# "exit code N (S s)" (Scripts/ue.ps1) or "exit=N seconds=S" (a game's shell wrapper)
+EXIT_RE = re.compile(r"exit code (-?\d+)(?: \((\d+) s\))?|exit=(-?\d+)(?: seconds=(\d+))?|\bexit (-?\d+)(?: log ue-| seconds (\d+))")
+
+
+# UE log line timestamps ([2026.10.12-18.19.52:086], UTC by default) in a command's output: the end of an editor run
+UE_TS = re.compile(r"\[(\d{4})\.(\d{2})\.(\d{2})-(\d{2})\.(\d{2})\.(\d{2}):(\d{3})\]")
+
+
+def log_end_time(resp, action_time):
+    """The latest UE log timestamp in a command's output, as an ISO time in the action's offset, when it lies before the
+    action's own end (the tool call went on after the editor exited: output filtering, a commit made meanwhile); else
+    None. UTC first (UE's default), then local time."""
+    stamps = UE_TS.findall(resp)
+    if not stamps:
+        return None
+    t_act = parse_time(action_time)
+    last = max(stamps)
+    naive = datetime.datetime(*[int(x) for x in last[:6]], int(last[6]) * 1000)
+    for tz in (datetime.timezone.utc, t_act.tzinfo):
+        t = naive.replace(tzinfo=tz)
+        lag = (t_act - t).total_seconds()
+        if 2 < lag < 2 * 3600:
+            return t.astimezone(t_act.tzinfo).isoformat(timespec="milliseconds")
+        if -2 <= lag <= 2:
+            return None
+    return None
+
+
+# a shell command that exited non-zero still ran: its file edits and editor runs happened
+RAN_EVENTS = ("PostToolUse", "PostToolUseFailure")
+
+
+def _param_expand(val, op, pat):
+    """${v%%pat} ${v%pat} ${v##pat} ${v#pat} with glob patterns."""
+    n = len(val)
+    if op == "%%":
+        return next((val[:i] for i in range(0, n + 1) if fnmatch.fnmatchcase(val[i:], pat)), val)
+    if op == "%":
+        return next((val[:i] for i in range(n, -1, -1) if fnmatch.fnmatchcase(val[i:], pat)), val)
+    if op == "##":
+        return next((val[i:] for i in range(n, -1, -1) if fnmatch.fnmatchcase(val[:i], pat)), val)
+    return next((val[i:] for i in range(0, n + 1) if fnmatch.fnmatchcase(val[:i], pat)), val)
+
+
+def subst_var(text, var, val):
+    v = re.escape(var)
+    text = re.sub(r"\$\{" + v + r"(%%|%|##|#)([^}]*)\}", lambda m: _param_expand(val, m.group(1), m.group(2)), text)
+    return re.sub(r"\$(?:\{" + v + r"\}|" + v + r"\b)", lambda m: val, text)
+
+
+def expand_loops(cmd, pats=None, spans=False):
+    """`for v in a "b c" d; do ... $v ...; done` (on one line or several) around an editor run: one run per value
+    (${v}, ${v%%pat} and ${v##pat} forms included)."""
+    m = re.search(r"\bfor (\w+) in ([^;\n]+?)\s*(?:;|\n)\s*do\b(.*?)(?:;|\n)\s*done\b", cmd, re.S)
+    if m:
+        try:
+            values = shlex.split(m.group(2), posix=True)
+        except ValueError:
+            values = m.group(2).split()
+    else:
+        # PowerShell: foreach ($v in "a", "b") { ... $v ... }
+        m = re.search(r"\bforeach\s*\(\s*\$(\w+)\s+in\s+([^)]+)\)\s*\{(.*?)\}", cmd, re.S | re.I)
+        if not m:
+            return [cmd]
+        values = [v.strip().strip("'\"") for v in m.group(2).split(",") if v.strip()]
+    var, body = m.group(1), m.group(3)
+    out = [cmd[:m.start()] + subst_var(body, var, v) + cmd[m.end():] for v in values]
+    if not any(p.search(subst_var(body, var, v)) for v in values for p in (pats or RUN_PATTERNS)):
+        return [cmd]
+    if spans:
+        # copy k > 0 repeats the text around the loop: only its loop body counts (no duplicate runs outside the loop).
+        # Positions map back to the original command: before the loop as is, iteration k's body inside the loop's span
+        # in iteration order (bodies differ in length with the value), after the loop shifted back
+        n, lo0, hi0 = len(values), m.start(), m.end()
+
+        def mapper(k, blen):
+            def f(p):
+                if p < lo0:
+                    return p
+                if p < lo0 + blen:
+                    return lo0 + (k + (p - lo0) / max(blen, 1)) / n * (hi0 - lo0)
+                return p - (lo0 + blen) + hi0
+            return f
+        res = []
+        for k, c in enumerate(out):
+            blen = len(subst_var(body, var, values[k]))
+            res.append((c, 0, len(c), mapper(k, blen)) if k == 0 else (c, lo0, lo0 + blen, mapper(k, blen)))
+        return res
+    return out
+
+
+# NAME=literal at the start of a simple command (not after && / ||: conditional)
+ASSIGN_RE = re.compile(r"(?:^|[;\n(]|\bdo\b|\bthen\b)[ \t]*(?:export[ \t]+)?([A-Za-z_]\w*)="
+                       r"(\"[^\"$`]*\"|'[^']*'|[^\s;&|)$`'\"]*)(?=[\s;&|)]|$)")
+
+
+def subst_assigned(cmd, pos, text):
+    """$NAME in text, for a NAME the command assigned a literal value before pos (the last such assignment)."""
+    vals = {}
+    for m in ASSIGN_RE.finditer(cmd[:pos]):
+        vals[m.group(1)] = m.group(2).strip("\"'")
+    for k in sorted(vals, key=len, reverse=True):
+        text = subst_var(text, k, vals[k])
+    return text
+
+
+def editor_runs(actions, repo_abs, extra_patterns=()):
+    """Editor-script runs found in shell commands, in order. Each: time (end of the tool call), approximate start,
+    script (repo-relative or absolute), args, exit code / duration when the output says so."""
+    # extra patterns: a regex (named groups script, args, mode, reason), or {"pattern": regex, "script": template,
+    # "args": template, "mode": ...} for a host-side wrapper that starts the editor itself with a fixed script
+    # (rally: Scripts/scrub_paths.py --mode apply -> the factory's scrub-import-paths.py --apply); templates take
+    # {name} for the pattern's named groups
+    templates = {}
+    pats = list(RUN_PATTERNS)
+    for x in extra_patterns:
+        if isinstance(x, dict):
+            templates[len(pats)] = x
+            pats.append(re.compile(x["pattern"]))
+        else:
+            pats.append(re.compile(x))
+    runs = []
+    # Older recordings lack a start time and assumed sequential calls per session. Native calls can overlap,
+    # including agents sharing a session: an intervening completed call is not the editor run's lower bound.
+    prev_by_session = {}
+    for a in actions:
+        sid = a.get("session_id")
+        prev, prev_by_session[sid] = prev_by_session.get(sid), a["time"]
+        if a.get("tool") not in ("Bash", "PowerShell") or a.get("event") not in RAN_EVENTS:
+            continue
+        cmd = a.get("input", {}).get("command", "")
+        # heredoc bodies are file contents (e.g. a wrapper script being written), not commands; loops are expanded
+        # first, so a run written as `for s in ...; do wrapper "Scripts/${s%%|*}"; done` is found
+        expanded = expand_loops(shellfx.protect_heredocs(cmd)[0], pats, spans=True)
+        if isinstance(expanded[0], str):
+            expanded = [(c, 0, len(c), lambda p: p) for c in expanded]
+        if not any(p.search(c) for c, _, _, _ in expanded for p in pats):
+            continue
+        resp = a.get("response") or ""
+        raw_resp = resp if isinstance(resp, str) else json.dumps(resp)
+        if isinstance(resp, str) and resp.lstrip().startswith("{"):
+            try:   # a JSON-encoded tool response: read its stdout/stderr as text (escaped newlines broke \b matches)
+                resp = json.loads(resp)
+            except ValueError:
+                pass
+        if isinstance(resp, dict):
+            resp = "%s\n%s" % (resp.get("stdout") or "", resp.get("stderr") or "")
+        elif not isinstance(resp, str):
+            resp = json.dumps(resp)
+        exits = [(x[0] or x[2] or x[4], x[1] or x[3] or x[5] or None) for x in EXIT_RE.findall(resp)]
+        found = []
+        for k, (c, lo_k, hi_k, posmap) in enumerate(expanded):
+            for pi, pat in enumerate(pats):
+                for m in pat.finditer(c):
+                    if not (lo_k <= m.start() < hi_k):
+                        continue
+                    g = {k2: (v or "") for k2, v in m.groupdict().items()}
+                    if pi in templates:
+                        tp = templates[pi]
+                        g["script"] = tp["script"].format(**g)
+                        g["args"] = tp.get("args", "{args}" if "args" in g else "").format(**g)
+                        g["mode"] = tp.get("mode", g.get("mode") or "commandlet")
+                    g = {k2: (v if v != "" else None) for k2, v in g.items()}
+                    reason = g.get("reason") if g.get("reason") is not None else g.get("reason_sq")
+                    env = run_env(c, m.start())
+                    if g.get("env_args"):
+                        # a wrapper that takes "--env K=V" pairs and hands them to the script (stealth's ue_run*.py)
+                        try:
+                            toks = shlex.split(subst_assigned(c, m.start(), g["env_args"]), posix=True)
+                        except ValueError:
+                            toks = g["env_args"].split()
+                        for ti, tok in enumerate(toks):
+                            kv = toks[ti + 1] if tok == "--env" and ti + 1 < len(toks) else tok[6:] if tok.startswith("--env=") else None
+                            if kv and "=" in kv:
+                                ek, ev = kv.split("=", 1)
+                                env[ek] = ev
+                    found.append(((posmap(m.start()), k), subst_assigned(c, m.start(), g["script"]),
+                                  subst_assigned(c, m.start(), (g.get("args") or "").strip()), env,
+                                  reason if reason is not None else run_reason(c, m.start()), g.get("mode") or "commandlet",
+                                  pi >= len(RUN_PATTERNS)))
+        found.sort()
+        # one run in the command: its editor's last log line dates the run's end better than the tool call's end
+        log_end = log_end_time(resp, a["time"]) if len(found) == 1 else None
+        for i, ((pos, _), script, args, env, reason, mode, via_wrapper) in enumerate(found):
+            ex = exits[i] if i < len(exits) and len(exits) == len(found) else None
+            s = script.replace("\\", "/")
+            if re.match(r"^[A-Za-z]:/", s) and s.lower().startswith(repo_abs.lower().rstrip("/") + "/"):
+                s = s[len(repo_abs.rstrip("/")) + 1:]
+            runs.append({
+                "time": a["time"], "action_tool_use_id": a.get("tool_use_id"), "script": s, "args": args,
+                "exit_code": int(ex[0]) if ex else None, "duration_s": int(ex[1]) if ex and ex[1] else None,
+                # started in the background: by the tool, or with a shell `&` (rows then arrive after the call ends)
+                "background": bool(re.search(r'"backgroundTaskId"', raw_resp)) or bool(re.search(r"[^&]&[ \t]*(?:\n|$|;|echo\b|wait\b|disown\b)", c)),
+                "after": a.get("start_time") or prev,
+                "env": env, "reason": reason, "mode": mode, "via_wrapper": via_wrapper, "pos": pos,
+                "command": cmd,   # in full: the recorded command is data, never cut
+            })
+            if log_end:
+                runs[-1]["log_end"] = log_end
+    return runs
+
+
+def run_env(cmd, pos):
+    """VAR=value assignments in front of the simple command that holds position pos (and earlier `export`s)."""
+    start, q = -1, None   # last command separator before pos, outside quotes
+    for i in range(pos):
+        ch = cmd[i]
+        if q:
+            if ch == q:
+                q = None
+        elif ch in "'\"":
+            q = ch
+        elif ch in ";|\n" or cmd.startswith("&&", i):
+            start = i
+    env = {}
+    for m in re.finditer(r"(?:^|\s)(?:export\s+)?([A-Z][A-Z0-9_]+)=(\"[^\"]*\"|'[^']*'|[^\s;&|]+)", cmd[:pos]):
+        if m.group(1) in ("MSYS_NO_PATHCONV", "PATH", "PY", "W", "L", "D", "S", "T"):
+            continue
+        if m.start() >= start or "export" in m.group(0):
+            env[m.group(1)] = m.group(2).strip("\"'")
+    return env
+
+
+def run_reason(cmd, pos):
+    m = re.search(r"-Reason\s+(\"[^\"]*\"|'[^']*'|\S+)", cmd[pos:pos + 2000].split("\n")[0])
+    return m.group(1).strip("\"'") if m else None
+
+
+def repo_rel(path, repo_abs):
+    p = path.replace("\\", "/")
+    root = repo_abs.replace("\\", "/").rstrip("/") + "/"
+    if p.lower().startswith(root.lower()):
+        return p[len(root):]
+    return None
+
+
+ABSENT = object()  # sentinel: the file does not exist yet
+
+
+def is_code(path):
+    """Files an editor build compiles from (the runner rebuilds when one of them changes)."""
+    return (path.startswith(("Source/", "Plugins/")) and path.endswith((".cpp", ".h", ".inl", ".cs"))) or \
+        path.endswith((".uproject", ".uplugin"))
+
+
+TEXT_EXT = (".py", ".ps1", ".sh", ".bat", ".cpp", ".h", ".inl", ".cs", ".uplugin", ".ini", ".json", ".md", ".uproject", ".txt", ".gitignore",
+            ".gitattributes", ".csv", ".tsv")
+
+
+class FileStates:
+    """Text of repo files as the agent's Write/Edit calls and shell edits left them. None = unknown."""
+
+    ABSENT = None  # set below
+
+    def __init__(self, repo, start_sha):
+        self.repo = repo
+        self.base_sha = start_sha
+        self.state = {}       # path -> bytes | None (unknown) | ABSENT
+        self.touched = set()  # paths written or edited since the last boundary
+        self.how = {}         # path -> last kind of write
+        self.tracked = None   # paths reported at boundaries (set by the caller)
+        self.mismatch = {}    # sha256 -> reconstructed text that did not match its commit
+
+    def get(self, path):
+        """Current text; ABSENT when the file does not exist yet, None when unknown."""
+        if path not in self.state:
+            b = blob_at(self.repo, self.base_sha, path)
+            self.state[path] = norm_text(b) if b is not None else ABSENT
+        return self.state[path]
+
+    def write(self, path, content):
+        self.state[path] = norm_text(content.encode("utf-8"))
+        self.touched.add(path)
+
+    def edit(self, path, old, new, replace_all):
+        cur = self.get(path)
+        self.touched.add(path)
+        if cur is None or cur is ABSENT:
+            self.state[path] = None
+            return False
+        o, n = norm_text(old.encode("utf-8")), norm_text(new.encode("utf-8"))
+        if o not in cur:
+            self.state[path] = None
+            return False
+        self.state[path] = cur.replace(o, n) if replace_all else cur.replace(o, n, 1)
+        return True
+
+    def put(self, path, content, how):
+        if content is not None and content is not ABSENT:
+            content = norm_text(content)
+        self.state[path] = content
+        self.touched.add(path)
+        self.how[path] = how
+
+    def boundary(self, sha):
+        """Compare what Write/Edit left with the commit, then reset to the commit."""
+        checks = []
+        for p in sorted(self.touched):
+            if self.tracked is not None and p not in self.tracked:
+                continue
+            st = self.state.get(p)
+            b = blob_at(self.repo, sha, p)
+            blob = norm_text(b) if b is not None else None
+            c = {"path": p, "reconstructed": st is not None, "how": self.how.get(p),
+                 "match": st is not None and (st == blob if blob is not None else st is ABSENT)}
+            if not c["match"] and isinstance(st, bytes):
+                c["sha256"] = sha256(st)
+                self.mismatch[c["sha256"]] = st
+            checks.append(c)
+        self.state = {}
+        self.touched = set()
+        self.how = {}
+        self.base_sha = sha
+        return checks
+
+
+FileStates.ABSENT = ABSENT
+
+
+# ----------------------------------------------------------------------------------------------- build
+def build(cfg):
+    repo = cfg["repo"]
+    repo_abs = repo.replace("\\", "/")
+    final = git(repo, "rev-parse", cfg["final"]).strip()
+    chain = first_parent_chain(repo, final)
+    # fold_commits: commits that hold only part of the work done before them (e.g. a README-only commit while the
+    # scripts and C++ those runs used came a commit later) are not window boundaries; their work goes to the next one
+    fold = [f.lower() for f in cfg.get("fold_commits", [])]
+    chain = [c for c in chain if c["sha"] == final or not any(c["sha"].lower().startswith(f) for f in fold)]
+    with open(os.path.join(cfg["recording"], "actions.jsonl"), encoding="utf-8") as action_file:
+        actions = [json.loads(l) for l in action_file]
+    actions.sort(key=lambda a: a["time"])
+    t_final = parse_time(chain[-1]["time"])
+    actions = [a for a in actions if parse_time(a["time"]) <= t_final + datetime.timedelta(seconds=60)]
+    wf_rows = [json.loads(l) for l in git(repo, "show", "%s:workflow.jsonl" % final).splitlines() if l.strip()]
+
+    runs = editor_runs(actions, repo_abs, cfg.get("run_patterns", []))
+    # runs_from_rows: runs the recording missed (a gap in the action hooks; rts-command 03:55-04:46 recorded no tool
+    # call while three editor scripts ran), rebuilt from the workflow row the run wrapper wrote when the run ended
+    # ({"row": "<id>", "mode": "gui"?, "args": ""?, "reason": ...}): script from source.script or target, end time from
+    # the row, duration from params seconds/duration_s, mode from params.mode (ExecutePythonScript = full editor).
+    # Each becomes a pseudo-action at that time, so it lands in its window like a recorded command.
+    rows_by_id = {r.get("id"): r for r in wf_rows}
+    for item in cfg.get("runs_from_rows", []):
+        row = rows_by_id.get(item["row"])
+        if not row:
+            raise SystemExit("runs_from_rows: no workflow row %s at the final commit" % item["row"])
+        p = row.get("params") or {}
+        script = ((row.get("source") or {}).get("script") or str(row.get("target") or "").split(" ")[0]).replace("\\", "/")
+        secs = p.get("seconds") if p.get("seconds") is not None else p.get("duration_s")
+        mode = item.get("mode") or ("gui" if "ExecutePythonScript" in str(p.get("mode") or "") else "commandlet")
+        tid = "row:" + item["row"]
+        runs.append({"time": row["time"], "action_tool_use_id": tid, "script": script, "args": item.get("args", ""),
+                     "exit_code": p.get("exit_code"), "duration_s": int(secs) if secs is not None else None,
+                     "background": False, "after": None, "env": item.get("env", {}), "reason": item.get("reason") or row.get("reason"),
+                     "mode": mode, "via_wrapper": False, "pos": 0, "from_row": item["row"],
+                     "command": "(not in the recorded actions: rebuilt from workflow row %s)" % item["row"]})
+        actions.append({"time": row["time"], "tool": "Bash", "event": "PostToolUse", "tool_use_id": tid, "input": {"command": ""},
+                        "session_id": "runs_from_rows"})
+    # A run whose editor finished before a commit that the tool call itself outlived (rts-command: s07_ui_audio's log
+    # ends 14:19:52, the commit holding its output is 14:20:02, the call ended 14:20:28) belongs before that commit:
+    # it is attached at its log end through a pseudo-action, like a recorded command
+    commit_times = [parse_time(c["time"]) for c in chain]
+    for k, r in enumerate(runs):
+        if r.get("log_end") and any(parse_time(r["log_end"]) < t <= parse_time(r["time"]) for t in commit_times):
+            r["attach_id"] = "logend:%d:%s" % (k, r.get("action_tool_use_id"))
+            actions.append({"time": r["log_end"], "tool": "Bash", "event": "PostToolUse", "tool_use_id": r["attach_id"],
+                            "input": {"command": ""}, "session_id": "log_end"})
+    actions.sort(key=lambda a: a["time"])
+    ro = cfg.get("readonly_patterns", [])
+    for r in runs:
+        base = os.path.basename(r["script"])
+        # not_readonly: scripts a read-only pattern matches that still write something a later run reads
+        # (horror: probe_clip_speeds.py writes Saved/clip_speeds.json for fix_anim_rates.py)
+        r["readonly"] = any(fnmatch.fnmatch(base, p) for p in ro) and base not in cfg.get("not_readonly", [])
+        # not_readonly_runs: single runs of a read-only-looking script whose side effect a later run needs, where other
+        # runs of it are slow and needed by nothing ({tool_use_id, script, reason}; stealth: the first
+        # inspect_pack_meshes.py creates Saved/PackMeshes, which prune_packs.py writes into)
+        if any(n.get("tool_use_id") == r["action_tool_use_id"] and (not n.get("script") or n["script"] in r["script"])
+               for n in cfg.get("not_readonly_runs", [])):
+            r["readonly"] = False
+        if r["duration_s"] is not None and not r["background"]:
+            r["start"] = (parse_time(r["time"]) - datetime.timedelta(seconds=r["duration_s"])).isoformat(timespec="milliseconds")
+        else:
+            r["start"] = r["time"]
+
+    # windows by commit time (the first commit has no window: it is the starting point)
+    win_of = lambda t: next((i for i, c in enumerate(chain) if parse_time(c["time"]) >= parse_time(t)), None)
+    windows = []
+    for i, c in enumerate(chain):
+        parent = chain[i - 1]["sha"] if i else None
+        ch = changed_paths(repo, parent, c["sha"])
+        windows.append({
+            "index": i, "sha": c["sha"], "parent": parent, "time": c["time"], "subject": c["subject"],
+            "merge_parents": c["parents"][1:],
+            "inputs": [{"status": s, "path": p} for s, p in ch if not p.startswith("Content/")],
+            "content": [{"status": s, "path": p} for s, p in ch if p.startswith("Content/")],
+            "scripts_changed": sorted(p for s, p in ch if p.startswith("Scripts/")),
+            "runs": [], "drops": [], "shell": [], "reconstruction": [], "events": collections.Counter(),
+        })
+
+    # walk actions in time order: file states, runs (with script texts), drops, shell steps
+    fs = FileStates(repo, chain[0]["sha"])
+    blobs = {}
+    script_paths = set(p for w in windows for p in w["scripts_changed"])
+    tracked = set(x["path"] for w in windows for x in w["inputs"]
+                  if x["path"].endswith(TEXT_EXT) and x["path"] != "workflow.jsonl")
+    sandbox = shellfx.Sandbox(repo_abs)
+    fs.tracked = tracked
+    aux = {}  # helper files the agent wrote outside the repo (absolute path -> text)
+    run_by_tool = collections.defaultdict(list)
+    for r in runs:
+        run_by_tool[r.get("attach_id") or r["action_tool_use_id"]].append(r)
+    drops = {d["id"]: d for d in cfg.get("asset_drops", [])}
+    shells = cfg.get("shell_replay", [])
+    seen_tool = set()
+    commit_code = {}   # (sha, path) -> code text at that commit (ABSENT when not in it)
+    cur_w = 1
+    run_seq = 0
+
+    def close_until(t):
+        nonlocal cur_w
+        while cur_w < len(windows) and parse_time(windows[cur_w]["time"]) < parse_time(t):
+            windows[cur_w]["reconstruction"] = fs.boundary(windows[cur_w]["sha"])
+            cur_w += 1
+
+    def close_through(k):
+        nonlocal cur_w
+        while cur_w <= k and cur_w < len(windows):
+            windows[cur_w]["reconstruction"] = fs.boundary(windows[cur_w]["sha"])
+            cur_w += 1
+
+    commit_rx = re.compile(r"\bgit\b(?:\s+-c\s+\S+)*\s+commit\b")
+    for a in actions:
+        # A command with `git commit` in it did its work around its own commits: close only the windows whose commits
+        # came before the command started (after the session's previous tool call), so its edits and runs land in the
+        # window the next commit closes. A run that comes after n of the command's own commits in the command text
+        # lands after the n-th of them (fps-breach: "commit && build && run build_level_S1 && commit" lost the run).
+        cmd_text = (a.get("input") or {}).get("command", "") if a.get("tool") in ("Bash", "PowerShell") else ""
+        cmd_commit_pos, cmd_windows = [], []
+        if "git commit" in cmd_text and run_by_tool.get(a.get("tool_use_id")):
+            first = run_by_tool[a["tool_use_id"]][0]
+            t_start = first.get("after") or first.get("start") or a["time"]
+            close_until(t_start)
+            cmd_commit_pos = [m.start() for m in commit_rx.finditer(shellfx.protect_heredocs(cmd_text)[0])]
+            cmd_windows = [k for k in range(cur_w, len(windows))
+                           if parse_time(t_start) <= parse_time(windows[k]["time"]) <= parse_time(a["time"])]
+            # more commits in that span than the command makes: the earlier ones are not its own (the end-of-turn WIP
+            # commit between two turns), so they close before its work
+            extra = len(cmd_windows) - len(cmd_commit_pos)
+            if extra > 0:
+                close_through(cmd_windows[extra - 1])
+                cmd_windows = cmd_windows[extra:]
+        else:
+            close_until(a["time"])
+        if cur_w >= len(windows):
+            break
+        w = windows[cur_w]
+        tool = a.get("tool")
+        if a.get("event") != "PostToolUse" and not (tool in ("Bash", "PowerShell") and a.get("event") in RAN_EVENTS):
+            continue
+        inp = a.get("input") or {}
+        if tool in ("Bash", "PowerShell") and inp.get("command"):
+            fx = []
+            shellfx.apply_command(a, fs, sandbox, tracked, fx, aux)
+            if fx:
+                w["events"]["shell_edits"] += len(fx)
+                for e in fx:
+                    if e[0].endswith("failed"):
+                        w["events"]["shell_edit_failed"] += 1
+        if tool == "Write" and not repo_rel(inp.get("file_path", ""), repo_abs):
+            aux[inp.get("file_path", "").replace("\\", "/")] = inp.get("content", "")
+        if tool == "Write":
+            p = repo_rel(inp.get("file_path", ""), repo_abs)
+            if p:
+                fs.write(p, inp.get("content", ""))
+                w["events"]["write"] += 1
+        elif tool == "Edit":
+            p = repo_rel(inp.get("file_path", ""), repo_abs)
+            if p:
+                ok = fs.edit(p, inp.get("old_string", ""), inp.get("new_string", ""), inp.get("replace_all", False))
+                w["events"]["edit" if ok else "edit_unapplied"] += 1
+        elif tool in ("Bash", "PowerShell"):
+            cmd = inp.get("command", "")
+            for d in drops.values():
+                # match strings may hold {root}/{home}: the recording's own paths, on whatever machine it was made
+                if d.get("match") and ue_replay.has_recorded(d["match"], cmd) >= 0 and d["id"] not in seen_tool:
+                    seen_tool.add(d["id"])
+                    w["drops"].append(dict(d, time=a["time"]))
+            for s in shells:
+                if ue_replay.has_recorded(s["match"], cmd) >= 0 and ("shell", s["match"]) not in seen_tool:
+                    seen_tool.add(("shell", s["match"]))
+                    w["shell"].append(dict(s, time=a["time"], pos=ue_replay.has_recorded(s["match"], shellfx.protect_heredocs(cmd)[0])))
+            # runs in this command, at the command's position in time (texts as of before the command's own writes)
+            for r in run_by_tool.get(a.get("tool_use_id"), []):
+                if cmd_windows and cmd_commit_pos:
+                    n = sum(1 for p in cmd_commit_pos if p < (r.get("pos") or 0))
+                    if n:
+                        close_through(cmd_windows[min(n, len(cmd_windows)) - 1])
+                        if cur_w >= len(windows):
+                            continue   # after the last commit: not part of the replayed history
+                        w = windows[cur_w]
+                run_seq += 1
+                # every script file the window changes, as it stood when the run started
+                texts, unknown, absent = {}, [], []
+                for p in w["scripts_changed"]:
+                    st = fs.get(p)
+                    if st is None:
+                        unknown.append(p)
+                    elif st is ABSENT:
+                        absent.append(p)
+                    else:
+                        h = sha256(st)
+                        blobs[h] = st
+                        texts[p] = h
+                # use_commit_text: script texts in a window the recording cannot rebuild although it seems to (rally w17:
+                # build_track_v3.py was rewritten by a helper script from the builder's scratch folder; only the earlier cp
+                # was seen, and the boundary check shows the mismatch): runs use the window's commit text instead
+                for u in cfg.get("use_commit_text", []):
+                    if u["script"] in texts and w["index"] in u.get("windows", [w["index"]]):
+                        del texts[u["script"]]
+                        unknown.append(u["script"])
+                rr = dict(r, id="R%04d" % run_seq, window=w["index"], texts=texts, unknown=unknown, absent=absent)
+                if cfg.get("code_at_run_time", True):
+                    # the C++ as it stood when the run started, where it differs from the window's commit: a run before
+                    # a mid-window code change ran with the earlier code (stealth L02: built with the commit's C++, the
+                    # level got duplicate actors). The runner writes these files and rebuilds before the run.
+                    code, code_unknown = {}, []
+                    for x in w["inputs"]:
+                        p = x["path"]
+                        if not is_code(p):
+                            continue
+                        st = fs.get(p)
+                        if st is None:
+                            code_unknown.append(p)
+                            continue
+                        key = (w["sha"], p)
+                        if key not in commit_code:
+                            b = blob_at(repo, w["sha"], p)
+                            commit_code[key] = norm_text(b) if b is not None else ABSENT
+                        if st is ABSENT and commit_code[key] is ABSENT:
+                            continue
+                        if st is not ABSENT and commit_code[key] is not ABSENT and st == commit_code[key]:
+                            continue
+                        if st is ABSENT:
+                            code[p] = "absent"
+                        else:
+                            h = sha256(st)
+                            blobs[h] = st
+                            code[p] = h
+                    if code_unknown:
+                        # some file's text at that moment is unknown (a shell edit the ledger cannot follow): a mix of
+                        # earlier and commit texts may not compile, so the run keeps the commit's code
+                        rr["code_unknown"] = code_unknown
+                    elif code:
+                        rr["code"] = code
+                if not r["script"].startswith("Scripts/"):
+                    rr["script_version"] = "external"
+                elif r["script"] in texts:
+                    rr["script_version"] = "reconstructed" if r["script"] in fs.touched else "as_of_parent"
+                elif r["script"] in unknown or r["script"] in absent:
+                    rr["script_version"] = "unknown_use_commit"
+                else:
+                    rr["script_version"] = "unchanged"
+                w["runs"].append(rr)
+    close_until("9999-12-31T00:00:00+00:00")
+    sandbox.close()
+    blobs.update(fs.mismatch)
+
+    # rows each run logged (by script and time window)
+    by_script = collections.defaultdict(list)
+    wrapper_by_script = collections.defaultdict(list)
+    wrapper_ops = set(cfg.get("wrapper_row_ops", []))   # rows a game's run wrapper logs around each run (not the script's)
+    for row in wf_rows:
+        if row.get("op") in wrapper_ops:
+            # a wrapper names the script it ran in source.script (siege) or in target (tower-defense: source.script is
+            # the wrapper itself); index the row under both, and under the target's first word when the target carries
+            # the script's arguments ("Tools/scrub-import-paths.py --apply")
+            tgt = str(row.get("target") or "").replace("\\", "/")
+            for s in {((row.get("source") or {}).get("script") or "").replace("\\", "/"), tgt, tgt.split(" ")[0]}:
+                m = re.search(r"(?:^|/)(Scripts/.+\.py)$", s)
+                if s:
+                    wrapper_by_script[m.group(1) if m and (s.startswith("..") or re.match(r"^[A-Za-z]:/|^/", s)) else s].append(row)
+            continue
+        s = (row.get("source") or {}).get("script")
+        if s:
+            # a script that passed a relative path to the recorder ("Scripts/x.py" resolved against the editor's
+            # working directory) logged "../../…/Engine/Binaries/Win64/Scripts/x.py"
+            m = re.search(r"(?:^|/)(Scripts/[^/]+\.py)$", s.replace("\\", "/"))
+            by_script[m.group(1) if m and s.startswith("..") else s].append(row)
+    all_runs = [r for w in windows for r in w["runs"]]
+    for k, r in enumerate(all_runs):
+        nxt = next((x for x in all_runs[k + 1:] if x["script"] == r["script"]), None)
+        # Native recordings provide the actual call start; older records fall back to the previous call's end.
+        lo = lo_cmd = parse_time(r["after"] or r["start"]) - datetime.timedelta(seconds=1)
+        prev_same = next((x for x in reversed(all_runs[:k]) if x["script"] == r["script"] and x["time"] == r["time"]), None)
+        n_same = sum(1 for x in all_runs[:k] if x["script"] == r["script"] and x["time"] == r["time"])
+        if prev_same:  # the same script twice in one command: split at the first run's estimated end
+            lo = max(lo, parse_time(prev_same["time"]))
+        hi = parse_time(nxt["start"]) if nxt else parse_time(r["time"]) + datetime.timedelta(hours=2)
+        hi = min(hi, parse_time(r["time"]) + datetime.timedelta(seconds=5)) if not r["background"] else hi
+        r["rows"] = [x["id"] for x in by_script.get(r["script"], []) if lo <= parse_time(x["time"]) <= hi]
+        for nr in cfg.get("not_run", []):
+            # runs the records show never happened (a loop stopped, a refused start, a withdrawn GPU wait)
+            if nr.get("tool_use_id") == r.get("action_tool_use_id") and (not nr.get("script") or nr["script"] in r["script"]):
+                r["not_run"] = nr.get("reason", "listed in settings not_run")
+        if wrapper_ops and r.get("via_wrapper"):
+            # the game's run wrapper logs a row before every run it starts: none means the command never got there
+            # (an earlier step of the same command failed), so the run did not happen
+            if prev_same:
+                # the same script started again in one command: its row is the n-th wrapper row of that command
+                in_cmd = [x for x in wrapper_by_script.get(r["script"], []) if lo_cmd <= parse_time(x["time"]) <= hi]
+                r["wrapper_rows"] = 1 if len(in_cmd) > n_same else 0
+            else:
+                r["wrapper_rows"] = sum(1 for x in wrapper_by_script.get(r["script"], []) if lo <= parse_time(x["time"]) <= hi)
+    for w in windows:
+        w["events"] = dict(w["events"])
+    return {"schema": SCHEMA, "game": cfg["game"], "final": final, "first": chain[0]["sha"],
+            "windows": windows, "counts": {
+                "windows": len(windows) - 1, "runs": len(all_runs),
+                "runs_readonly": sum(1 for r in all_runs if r["readonly"]),
+                "script_version": dict(collections.Counter(r["script_version"] for r in all_runs)),
+                "runs_with_unknown_helper": sum(1 for r in all_runs if r["unknown"]),
+                "runs_with_earlier_code": sum(1 for r in all_runs if r.get("code")),
+                "runs_with_unknown_code": sum(1 for r in all_runs if r.get("code_unknown")),
+                "reconstruction_checks": sum(len(w["reconstruction"]) for w in windows),
+                "reconstruction_match": sum(1 for w in windows for c in w["reconstruction"] if c["match"]),
+                "reconstruction_unknown": sum(1 for w in windows for c in w["reconstruction"] if not c["reconstructed"]),
+            }}, blobs
diff --git a/Dataset/ReplayScripts/live.py b/Dataset/ReplayScripts/live.py
new file mode 100644
index 0000000000000000000000000000000000000000..03afbb5323c90266e9f0eb54a85c87b247bac27a
--- /dev/null
+++ b/Dataset/ReplayScripts/live.py
@@ -0,0 +1,771 @@
+"""live: the creation replay while a game is being built (docs/ue-replay.md, section 3).
+
+  python ue_replay.py live --game <slug>       catch the replay up with the game repo's HEAD, check what the new
+                                               commits did, write findings for the game session (background job)
+  python ue_replay.py live-status              every live game: head, replayed windows, last result
+  python ue_replay.py truth --game <slug>      the truth project at the settings' final commit, editor built
+  python ue_replay.py release --game <slug>    at release: catch up, truth, full dumps, verify, package (minutes when
+                                               the live replay kept up)
+
+A game takes part when its ReplayConfig.json has "live": true. Its post-commit hook (live-hook.ps1, installed by
+machine/install-git-hook.ps1) starts `live` in the background after every commit and prints the last job's findings,
+so the game session sees them at its next commit. The job:
+
+  1. builds the ledger up to HEAD and compares it with the ledger already replayed; when history was rewritten (an
+     amend, a rebase) or the settings changed a replayed window, the replay project goes back to the last unchanged
+     commit (that commit's tree; listed as a deviation) and replays from there;
+  2. replays the new windows into the persistent replay project (runner.cmd_run: resumable, work/STOP pauses it);
+     every engine process runs through ue-heavy.ps1 -Low (yields to every other job, below-normal priority);
+  3. checks them: each run against its original (exit code, workflow rows), each window's content against its commit,
+     and the assets and maps the new commits touched against the truth project at HEAD (structure dumps);
+  4. reads the recording for work the replay cannot redo (editor runs it does not recognise, custom commandlets,
+     scripts outside the repo or naming the live project folder, runs that log no workflow row);
+  5. writes work/live/reports/<sha8>.md/.json, work/live/status.json and, when something needs the builder's attention,
+     work/live/feedback.md, which the hook prints once.
+
+One job per game (work/live/lock); a commit made while it runs is picked up before it exits.
+"""
+import collections
+import ctypes
+import glob
+import json
+import os
+import re
+import shutil
+import sys
+import time
+import traceback
+
+import ledger
+import runner
+import ue_replay
+
+SCHEMA = "ue-replay.live/v1"
+KEEP_DUMPS = 3
+
+
+# ------------------------------------------------------------------------------------------------ helpers
+def live_dir(cfg):
+    return os.path.join(cfg["work_dir"], "live")
+
+
+def pid_alive(pid):
+    try:
+        pid = int(pid)
+    except (TypeError, ValueError):
+        return False
+    if os.name == "nt":
+        k = ctypes.windll.kernel32
+        h = k.OpenProcess(0x1000, False, pid)   # PROCESS_QUERY_LIMITED_INFORMATION
+        if not h:
+            return False
+        code = ctypes.c_ulong()
+        ok = k.GetExitCodeProcess(h, ctypes.byref(code))
+        k.CloseHandle(h)
+        return bool(ok) and code.value == 259   # STILL_ACTIVE
+    try:
+        os.kill(pid, 0)
+        return True
+    except OSError:
+        return False
+
+
+class Lock:
+    """work/live/lock: one live or release job per game; a lock whose process is gone is taken over."""
+
+    def __init__(self, cfg):
+        self.path = os.path.join(live_dir(cfg), "lock")
+        self.held = False
+
+    def acquire(self):
+        os.makedirs(os.path.dirname(self.path), exist_ok=True)
+        for _ in range(2):
+            try:
+                fd = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+            except FileExistsError:
+                try:
+                    with open(self.path, encoding="utf-8") as f:
+                        info = json.load(f)
+                except (OSError, ValueError):
+                    info = {}
+                if pid_alive(info.get("pid")):
+                    return False
+                try:
+                    os.remove(self.path)
+                except OSError:
+                    return False
+                continue
+            os.write(fd, json.dumps({"pid": os.getpid(), "time": runner.now()}).encode())
+            os.close(fd)
+            self.held = True
+            return True
+        return False
+
+    def release(self):
+        if self.held:
+            try:
+                os.remove(self.path)
+            except OSError:
+                pass
+            self.held = False
+
+
+def head_of(cfg):
+    return runner.git(cfg["repo"], "rev-parse", cfg.get("live_ref") or "HEAD").strip()
+
+
+def fingerprint(w):
+    """What a replayed window depends on: its commit, its runs (scripts, texts, code, flags), drops and shell steps."""
+    runs = [[r["id"], r["script"], r.get("args"), r.get("texts"), r.get("unknown"), r.get("code"), r.get("code_unknown"),
+             r.get("readonly"), r.get("not_run"), r.get("mode"), r.get("env")] for r in w["runs"]]
+    drops = [[d["id"], [[it.get("from"), it.get("to"), it.get("from_git"), it.get("ref")] for it in d["items"]]] for d in w["drops"]]
+    return json.dumps([w["sha"], runs, drops, [s.get("argv") for s in w["shell"]]], sort_keys=True)
+
+
+def last_unchanged(old, new, done):
+    """The last window k <= done whose windows 1..k are unchanged in the new ledger; -1 when the first commit differs."""
+    if not old or old["windows"][0]["sha"] != new["windows"][0]["sha"]:
+        return -1
+    for i in range(1, done + 1):
+        if i >= len(new["windows"]) or i >= len(old["windows"]) or fingerprint(old["windows"][i]) != fingerprint(new["windows"][i]):
+            return i - 1
+    return done
+
+
+def trim_jsonl(path, keep):
+    if not os.path.exists(path):
+        return
+    with open(path, encoding="utf-8") as f:
+        lines = [l for l in f if l.strip()]
+    out = []
+    for l in lines:
+        try:
+            if keep(json.loads(l)):
+                out.append(l)
+        except ValueError:
+            out.append(l)
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        f.write("".join(out))
+
+
+def reset_to(cfg, old, new, k, why):
+    """Put the replay project at window k's commit (the new first commit when k == -1) and forget later windows."""
+    ctx = runner.Ctx(cfg)
+    k0 = max(k, 0)
+    sha = new["windows"][k0]["sha"]
+    runner.git(ctx.proj, "checkout", "-q", "-f", "--detach", sha)
+    # Store packs dropped in windows 1..k0 may never have been committed (staged, then pruned): git clean must not take
+    # them (rts-command: s05_data and s08 lost KT_SmartMat_Vol_4 and CityPark after a reset), and files of theirs that
+    # a later window deleted come back (copied only where missing, so later edits of kept files stay as they are)
+    drops = [d for w in new["windows"][1:k0 + 1] for d in w["drops"]]
+    excl = []
+    for d in drops:
+        for it in d["items"]:
+            excl += ["-e", "/" + (it.get("from_git") or it["to"]).strip("/") + "/"]
+    runner.git(ctx.proj, "clean", "-fdq", *excl)
+    restored = 0
+    for d in drops:
+        for it in d["items"]:
+            if it.get("from_git"):
+                continue   # restored from git by the drop itself when a later window needs it again
+            src, dst = it["from"], ctx.p(it["to"])
+            if os.path.isfile(src):
+                if not os.path.exists(dst):
+                    os.makedirs(os.path.dirname(dst), exist_ok=True)
+                    shutil.copy2(src, dst)
+                    restored += 1
+                continue
+            for dp, _, fns in os.walk(src):
+                for fn in fns:
+                    t = os.path.join(dst, os.path.relpath(os.path.join(dp, fn), src))
+                    if not os.path.exists(t):
+                        os.makedirs(os.path.dirname(t), exist_ok=True)
+                        shutil.copy2(os.path.join(dp, fn), t)
+                        restored += 1
+    runner.fix_lfs_pointers(ctx, ["Content"])
+    dropped = [r["id"] for w in (old or {"windows": []})["windows"][k0 + 1:] for r in w["runs"]]
+    for rid in dropped:
+        p = os.path.join(ctx.work, "rows", rid + ".jsonl")
+        if os.path.exists(p):
+            os.remove(p)
+        shutil.rmtree(os.path.join(ctx.work, "mapdumps", rid), ignore_errors=True)
+    trim_jsonl(os.path.join(ctx.work, "windows.jsonl"), lambda r: r.get("window", 0) <= k0)
+    trim_jsonl(os.path.join(ctx.work, "runs.jsonl"), lambda r: r.get("window", 0) <= k0)
+    ctx.state.update({"window": k0, "done": [], "code_dirty": True, "code_applied": {},
+                      "provenance": {p: "git:" + sha[:10] for p in runner.scan(ctx.proj)}})
+    ctx.save()
+    ev = {"time": runner.now(), "kind": "replay_restarted_from_commit", "window": k0, "commit": sha, "reason": why,
+          "dropped_runs": len(dropped), "drops_kept": [d["id"] for d in drops], "drop_files_restored": restored}
+    runner.jappend(os.path.join(live_dir(cfg), "events.jsonl"), ev)
+    print("reset: replay project at window %d (%s): %s" % (k0, sha[:8], why), flush=True)
+    return ev
+
+
+class RunArgs:
+    until = None
+    force = False
+
+
+# ------------------------------------------------------------------------------------------------ findings
+def finding(level, kind, msg, **where):
+    return dict({"level": level, "kind": kind, "message": msg}, **{k: v for k, v in where.items() if v is not None})
+
+
+def live_tree_regex(cfg):
+    parts = [p for p in cfg["repo"].replace("\\", "/").split("/") if p]
+    return re.compile(r"(?i)" + r"(?:/|\\{1,2})".join(re.escape(p) for p in parts) + r"(?![\w-])")
+
+
+def editor_wrappers(cfg, sha):
+    """Scripts in the repo (at sha) that start the editor with a Python script: the commands that should yield runs."""
+    names = []
+    for p in runner.git(cfg["repo"], "ls-tree", "-r", "--name-only", sha, "--", "Scripts").splitlines():
+        if not p.endswith((".sh", ".ps1", ".bat", ".cmd", ".py")):
+            continue
+        try:
+            t = runner.git(cfg["repo"], "show", "%s:%s" % (sha, p))
+        except RuntimeError:
+            continue
+        if "UnrealEditor" in t and re.search(r"(?i)pythonscript|ExecutePythonScript", t):
+            names.append(os.path.basename(p))
+    return names
+
+
+def recording_findings(cfg, led, wins):
+    """Commands in the new windows that started the editor without a run the ledger recognises."""
+    out = []
+    path = os.path.join(cfg["recording"], "actions.jsonl")
+    if not wins or not os.path.exists(path):
+        return out
+    ws = [led["windows"][i] for i in wins]
+    lo = ue_replay_time(led["windows"][wins[0] - 1]["time"]) if wins[0] > 0 else None
+    hi = ue_replay_time(ws[-1]["time"])
+    run_tools = set(r.get("action_tool_use_id") for w in ws for r in w["runs"])
+    wrappers = editor_wrappers(cfg, ws[-1]["sha"])
+    # a wrapper called with a script argument (not cat/grep/sed of it): "<wrapper> [-Opt ...] Scripts/x.py"
+    call = (r"(?:^|[;&|(\n]\s*|(?:^|[\s;&|(])(?:sh|bash|source|\.)\s+|-File\s+|&\s*)['\"]?(?:[\w./\\:$~{}-]*[/\\])?"
+            r"(?:%s)['\"]?\s+(?:-{1,2}[\w-]+\s+)*['\"]?[\w./\\${}-]+\.py\b")
+    wrap_rx = re.compile(call % "|".join(re.escape(n) for n in wrappers)) if wrappers else None
+    quoted = re.compile(r"\"(?:[^\"\\]|\\.){40,}\"|'[^']{40,}'")
+    # commit messages and workflow-row reasons (long quoted prose) name wrappers and editor flags without calling them;
+    # quoted program paths ("C:/Program Files/Epic Games/...") have fewer spaces
+    unprose = lambda s: quoted.sub(lambda q: '""' if q.group(0).count(" ") >= 4 else q.group(0), s)
+    direct_rx = re.compile(r"(?i)UnrealEditor(?:-Cmd)?(?:\.exe)?['\"]?\s[^\n]*?(?:-run=(\w+)|-ExecutePythonScript)")
+    import shellfx
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            try:
+                a = json.loads(line)
+            except ValueError:
+                continue
+            if a.get("tool") not in ("Bash", "PowerShell") or a.get("event") not in ("PostToolUse", "PostToolUseFailure"):
+                continue
+            t = ue_replay_time(a["time"])
+            if (lo and t <= lo) or t > hi:
+                continue
+            cmd = shellfx.protect_heredocs((a.get("input") or {}).get("command", ""))[0]
+            if re.search(r"(?i)(?:^|\s)-game\b|autoplay", cmd):
+                continue   # game launches and AutoPlay runs change no project files
+            bare = unprose(cmd)
+            w = next((x["index"] for x in ws if ue_replay_time(x["time"]) >= t), ws[-1]["index"])
+            short = re.sub(r"\s+", " ", cmd)[:160]
+            ms = list(direct_rx.finditer(bare))
+            lets = sorted(set(m.group(1) for m in ms if m.group(1) and m.group(1).lower() != "pythonscript"))
+            for name in lets:   # even next to a recognised run in the same command
+                out.append(finding("error", "commandlet_not_replayable",
+                                   "a custom commandlet ran (-run=%s): the replay runs Python editor scripts only; do this "
+                                   "work in a Scripts/*.py editor script (it can call C++ through a BlueprintCallable "
+                                   "function) and run that instead" % name, window=w, command=short))
+            if lets or a.get("tool_use_id") in run_tools:
+                continue
+            if ms or (wrap_rx and wrap_rx.search(bare)):
+                out.append(finding("error", "editor_run_not_recognised",
+                                   "this command started an editor script, but the replay found no run in it: run editor "
+                                   "scripts through a wrapper whose call matches a ReplayConfig.json run_patterns entry, with "
+                                   "the script as a literal Scripts/<name>.py argument", window=w, command=short))
+    return out
+
+
+def ue_replay_time(s):
+    return ledger.parse_time(s)
+
+
+def versioned_external(run):
+    """An absolute script path in a git repo with a commit of it before the run (runner.external_script can replay it)."""
+    p = run["script"]
+    if not os.path.isabs(p) or not os.path.isfile(p):
+        return False
+    d = os.path.dirname(p)
+    try:
+        top = runner.git(d, "rev-parse", "--show-toplevel").strip()
+        rel = os.path.relpath(p, top).replace("\\", "/")
+        return bool(runner.git(top, "log", "-1", "--format=%H", "--before=" + run["start"], "--", rel).strip())
+    except (RuntimeError, ValueError):
+        return False
+
+
+def ledger_findings(cfg, led, wins):
+    out = []
+    live_rx = live_tree_regex(cfg)
+    chdir_rx = re.compile(r"os\.chdir\(\s*r?['\"](?:[A-Za-z]:|/)")
+    seen = set()
+    for i in wins:
+        w = led["windows"][i]
+        for r in w["runs"]:
+            if r.get("not_run") or r.get("readonly"):
+                continue   # never replayed: nothing to fix
+            where = {"window": i, "run": r["id"], "script": r["script"]}
+            if r.get("script_version") == "external":
+                # a versioned tool outside the game (the factory's own pipeline scripts) is taken from its git history
+                if not versioned_external(r):
+                    out.append(finding("error", "script_outside_repo", "%s is not in the game repo (nor in any git history "
+                                       "the replay can read): commit every editor script under Scripts/ and run it from "
+                                       "there" % r["script"], **where))
+                continue
+            if r.get("script_version") == "unknown_use_commit" and (i, r["script"]) not in seen:
+                seen.add((i, r["script"]))
+                out.append(finding("warn", "script_text_unknown", "the text %s had when it ran is not in the recording "
+                                   "(edited with a shell command, or outside this session): edit scripts with the Write/Edit "
+                                   "tools, or write a new version (name_v2.py) instead of changing one that already ran" % r["script"], **where))
+            for p, h in (r.get("texts") or {}).items():
+                key = (p, h)
+                if key in seen:
+                    continue
+                seen.add(key)
+                try:
+                    with open(os.path.join(cfg["work_dir"], "blobs", h), encoding="utf-8", errors="replace") as f:
+                        txt = f.read()
+                except OSError:
+                    continue
+                if live_rx.search(txt) or chdir_rx.search(txt):
+                    out.append(finding("error", "absolute_project_path", "%s names a folder by its absolute path (the game "
+                                       "folder, or an os.chdir): a replay in another folder would read or write the live "
+                                       "project; use paths relative to the project (unreal.Paths.project_dir(), "
+                                       "Path(__file__).resolve().parents[1])" % p, window=i, script=p))
+            if not r.get("rows") and r.get("exit_code") in (0, None) and not r.get("via_wrapper"):
+                out.append(finding("warn", "no_workflow_rows", "%s logged no workflow.jsonl row: every editor-script "
+                                   "run logs at least one row (op, target, status, params, source.script)" % r["script"], **where))
+    return out
+
+
+def run_findings(cfg, wins):
+    """Each replayed run against the original, each window's content against its commit (runs.jsonl, windows.jsonl)."""
+    out = []
+    work = cfg["work_dir"]
+    ws = set(wins)
+    for path, kind in ((os.path.join(work, "runs.jsonl"), "run"), (os.path.join(work, "windows.jsonl"), "window")):
+        if not os.path.exists(path):
+            continue
+        with open(path, encoding="utf-8") as f:
+            recs = [json.loads(l) for l in f if l.strip()]
+        prev_extra = set()
+        for x in recs:
+            if kind == "window":
+                # an extra file is reported in the window it appears in, not again in every later window
+                extra_now = set((x.get("detail") or {}).get("extra") or [])
+                new_extra, prev_extra = sorted(extra_now - prev_extra), extra_now
+            if x.get("window") not in ws:
+                continue
+            if kind == "window":
+                d = dict(x.get("detail") or {}, extra=new_extra)
+                fb = d.get("fallback") or []
+                if fb:
+                    out.append(finding("warn", "content_not_replayed", "%d Content file(s) in commit %s were made by no "
+                                       "replayed step (taken from the commit). Store packs copied in need an asset_drops "
+                                       "entry in ReplayConfig.json (docs/ue-replay.md); anything else was made in the editor "
+                                       "GUI, by a script that is not committed or not recognised, or by a probe whose name "
+                                       "marks it read-only (readonly_patterns). e.g. %s" % (len(fb), x["commit"][:8], ", ".join(
+                                           f["path"] for f in fb[:5])), window=x["window"]))
+                if d.get("extra"):
+                    out.append(finding("warn", "content_extra", "the replay has %d Content file(s) that commit %s does not "
+                                       "(a run whose output was not committed, or files deleted by hand), e.g. %s" % (
+                                           len(d["extra"]), x["commit"][:8], ", ".join(d["extra"][:5])), window=x["window"]))
+                continue
+            if x.get("kind") == "build" and x.get("exit_code") not in (0, None):
+                out.append(finding("error", "build_failed", "the editor build failed in the replay (log %s)" % x.get("log"),
+                                   window=x["window"]))
+            if x.get("kind") != "run" or x.get("skipped"):
+                continue
+            where = {"window": x["window"], "run": x.get("run"), "script": x.get("script")}
+            # UnrealEditor-Cmd exits 1 whenever the engine logs an error (a missing navmesh...), so an exit code alone
+            # says little: a run failed when it also did less than the original (fewer workflow rows)
+            short = x.get("rows_replayed", 0) < len(x.get("rows_original") or [])
+            if short and x.get("exit_code") not in (0, None) and x.get("exit_code") != x.get("exit_code_original"):
+                out.append(finding("error", "run_failed", "%s exited %s in the replay (original %s) and logged %d of %d "
+                                   "workflow rows: it may depend on something outside the repo (an absolute path, an "
+                                   "uncommitted file, the live project). %s" % (
+                                       x.get("script"), x.get("exit_code"), x.get("exit_code_original"), x.get("rows_replayed", 0),
+                                       len(x.get("rows_original") or []), first_errors(os.path.join(work, x.get("log") or ""))), **where))
+            elif short:
+                out.append(finding("warn", "rows_short", "%s logged %d workflow row(s) in the replay, %d originally" % (
+                    x.get("script"), x.get("rows_replayed", 0), len(x.get("rows_original") or [])), **where))
+            if str(x.get("code_at_run_time") or "").startswith("commit code ("):
+                out.append(finding("info", "code_at_run_time_not_buildable", "the C++ as it stood when %s ran did not "
+                                   "compile here; the run used the commit's code" % x.get("script"), **where))
+    return out
+
+
+def first_errors(log):
+    """The script's own errors first (Python), engine errors only when there are none."""
+    try:
+        with open(log, encoding="utf-8", errors="replace") as f:
+            lines = [l.strip() for l in f]
+    except OSError:
+        return ""
+    errs = [l for l in lines if "LogPython: Error" in l or "Traceback" in l][:2] or \
+        [l for l in lines if re.search(r"\bError: |Fatal error|Assertion failed", l)][:2]
+    return ("First error: " + " | ".join(re.sub(r"^\[[^\]]*\]\[[^\]]*\]", "", e)[-200:] for e in errs)) if errs else ""
+
+
+# ------------------------------------------------------------------------------------------------ structure check
+def touched_packages(cfg, led, wins, head):
+    """/Game packages (and maps) the new windows added or changed that exist at head, under the content roots."""
+    in_head = set(runner.git(cfg["repo"], "ls-tree", "-r", "--name-only", head, "--", "Content").splitlines())
+    roots = [r.rstrip("/") + "/" for r in cfg.get("content_roots", ["/Game"])]
+    mroots = [r.rstrip("/") + "/" for r in cfg.get("map_roots", cfg.get("content_roots", ["/Game"]))]
+    pk, maps = set(), set()
+    for i in wins:
+        for x in led["windows"][i]["content"]:
+            p = x["path"]
+            if x["status"] == "D" or p not in in_head or not p.endswith((".uasset", ".umap")):
+                continue
+            pkg = "/Game/" + os.path.splitext(p[len("Content/"):])[0]
+            if not any(pkg.startswith(r) or r == "/Game/" for r in roots):
+                continue
+            pk.add(pkg)
+            if p.endswith(".umap") and any(pkg.startswith(r) or r == "/Game/" for r in mroots):
+                maps.add(pkg)
+    return sorted(pk), sorted(maps)
+
+
+def sync_truth(cfg, sha):
+    """The truth project (a shared clone of the game repo) at sha; True when it was cloned now."""
+    t = cfg["truth_dir"]
+    if runner.clone_at(cfg, t, sha):
+        return True
+    if runner.git(t, "rev-parse", "HEAD").strip() != sha:
+        runner.git(t, "checkout", "-q", "-f", "--detach", sha)
+        runner.git(t, "clean", "-fdq")
+    return False
+
+
+def build_truth(cfg, label, since=None, sha=None):
+    """Build the truth project's editor unless no code changed since the last truth build (since -> sha)."""
+    if since and sha and since != sha:
+        changed = runner.git(cfg["repo"], "diff", "--name-only", since, sha).splitlines()
+        if not any(ledger.is_code(p) for p in changed):
+            return 0, 0.0, None
+    elif since and since == sha:
+        return 0, 0.0, None
+    ctx = runner.Ctx(cfg)
+    ctx.uproject = os.path.join(cfg["truth_dir"], cfg["uproject"])
+    # the engine the truth commit names; build output of another engine (truth checked out across a port) goes first
+    eng = ctx.engine_for(ctx.uproject)
+    ctx.set_engine(eng)
+    marker = os.path.join(cfg["truth_dir"], "Saved", "replay-truth-engine.txt")
+    old = open(marker, encoding="utf-8").read().strip() if os.path.exists(marker) else None
+    if old and old != eng:
+        for d in ("Binaries", "Intermediate"):
+            shutil.rmtree(os.path.join(cfg["truth_dir"], d), ignore_errors=True)
+    code, secs, log = runner.build_editor(ctx, label)
+    if code == 0:
+        os.makedirs(os.path.dirname(marker), exist_ok=True)
+        with open(marker, "w", encoding="utf-8") as f:
+            f.write(eng + "\n")
+    return code, secs, log
+
+
+def structure_check(cfg, led, wins, head, lst):
+    pkgs, maps = touched_packages(cfg, led, wins, head)
+    if not pkgs:
+        return None, []
+    ctx = runner.Ctx(cfg)
+    res = {"packages": len(pkgs), "maps": maps}
+    sync_truth(cfg, head)
+    code, secs, log = build_truth(cfg, "truth_%s" % head[:8], lst.get("truth_built"), head)
+    if code != 0:
+        return res, [finding("error", "truth_build_failed", "the game's own commit %s does not build its editor target "
+                             "(log %s)" % (head[:8], log))]
+    lst["truth_built"] = head
+    base = os.path.join(live_dir(cfg), "dumps", head[:8])
+    shutil.rmtree(base, ignore_errors=True)
+    rd, td = os.path.join(base, "replay"), os.path.join(base, "truth")
+    c1, _ = runner.dump_maps(ctx, maps, rd, assets=True, t3d=False, label="live_dump_replay_" + head[:8], packages=pkgs)
+    c2, _ = runner.dump_maps(ctx, maps, td, assets=True, t3d=False, label="live_dump_truth_" + head[:8],
+                             project=cfg["truth_dir"], packages=pkgs)
+    out = []
+    if not (os.path.exists(os.path.join(rd, "assets.json")) and os.path.exists(os.path.join(td, "assets.json"))):
+        return res, [finding("warn", "dump_failed", "the structure dump did not finish (exit %s / %s): see %s" % (c1, c2, ctx.logs))]
+    import verify
+    verify.add_project_path_rule(cfg)
+    counts = collections.Counter()
+    a = verify.verify_assets(runner.jload(os.path.join(rd, "assets.json")), runner.jload(os.path.join(td, "assets.json")), counts)
+    res["assets"] = a["total"]
+    bad = [d for d in a["diffs"] if d["result"] != "extra" or d["asset"] in pkgs]
+    if bad:
+        out.append(finding("warn", "assets_differ", "%d of %d touched asset(s) differ from commit %s after the replay: %s" % (
+            len(bad), len(pkgs), head[:8], "; ".join("%s %s%s" % (d["asset"], d["result"], (" " + ",".join(d.get("keys", [])[:4])) if d.get("keys") else "")
+                                                   for d in bad[:6]))))
+    res["maps_result"] = {}
+    for m in maps:
+        fn = m.replace("/Game/", "").replace("/", "__") + ".json"
+        rp, tp = os.path.join(rd, "maps", fn), os.path.join(td, "maps", fn)
+        if not os.path.exists(tp):
+            continue
+        if not os.path.exists(rp):
+            out.append(finding("warn", "map_differs", "map %s is missing in the replay" % m))
+            continue
+        v = verify.verify_map(runner.jload(rp), runner.jload(tp), counts)
+        res["maps_result"][m] = {k: v[k] for k in ("truth_actors", "replay_actors", "identical", "differs", "missing", "extra")}
+        if v["differs"] or v["missing"] or v["extra"] or not v["world_settings_same"]:
+            out.append(finding("warn", "map_differs", "map %s after the replay: %d actor(s) differ, %d missing, %d extra "
+                               "(of %d in commit %s)%s" % (m, v["differs"], v["missing"], v["extra"], v["truth_actors"], head[:8],
+                                                          ("; e.g. " + ", ".join(str(x) for x in (v["detail"]["missing"] + v["detail"]["extra"])[:4]))
+                                                          if v["missing"] or v["extra"] else "")))
+    res["normalised"] = dict(counts)
+    # keep the last few dumps
+    dumps = sorted(glob.glob(os.path.join(live_dir(cfg), "dumps", "*")), key=os.path.getmtime)
+    for d in dumps[:-KEEP_DUMPS]:
+        shutil.rmtree(d, ignore_errors=True)
+    return res, out
+
+
+# ------------------------------------------------------------------------------------------------ report
+def render(rep):
+    lines = ["# Live replay: %s at %s" % (rep["game"], rep["head"][:8]), "",
+             "- Time: %s (%.0f s)" % (rep["time"], rep.get("seconds", 0)),
+             "- Replayed windows: %s of %d; this job: %s" % (rep["replayed_to"], rep["total_windows"],
+                                                             ", ".join("w%02d" % i for i in rep["windows"]) or "none"),
+             "- Result: **%s**" % rep["result"]]
+    if rep.get("reset"):
+        lines.append("- Restarted from commit %s (window %d): %s" % (rep["reset"]["commit"][:8], rep["reset"]["window"], rep["reset"]["reason"]))
+    if rep.get("error"):
+        lines.append("- Error: %s" % rep["error"])
+    st = rep.get("structure")
+    if st:
+        lines.append("- Structure check: %d touched package(s), maps %s; assets %s" % (st["packages"], ", ".join(st["maps"]) or "none",
+                                                                                     st.get("assets")))
+    lines += ["", "## Findings", ""]
+    if not rep["findings"]:
+        lines.append("None.")
+    for f in rep["findings"]:
+        where = ", ".join("%s %s" % (k, f[k]) for k in ("window", "run", "script") if f.get(k) is not None)
+        lines.append("- [%s] %s: %s%s" % (f["level"], f["kind"], f["message"], (" (%s)" % where) if where else ""))
+        if f.get("command"):
+            lines.append("  - command: `%s`" % f["command"].replace("`", "'"))
+    return "\n".join(lines) + "\n"
+
+
+def feedback(rep, report_md):
+    act = [f for f in rep["findings"] if f["level"] in ("error", "warn")]
+    if not act:
+        return None
+    lines = ["# Replay feedback: %s at %s (%s)" % (rep["game"], rep["head"][:8], rep["time"][:16]), "",
+             "The background creation replay of your latest commits found %d thing(s) that keep the dataset from being "
+             "replayed exactly. Fix them in your next commits (game-session skill, \"Replay-friendly work\"):" % len(act), ""]
+    for f in act[:20]:
+        where = ", ".join("%s %s" % (k, f[k]) for k in ("window", "script") if f.get(k) is not None)
+        lines.append("- [%s] %s%s" % (f["level"], f["message"], (" (%s)" % where) if where else ""))
+    if len(act) > 20:
+        lines.append("- ... %d more" % (len(act) - 20))
+    lines += ["", "Full report: %s" % report_md]
+    return "\n".join(lines) + "\n"
+
+
+def write_report(cfg, rep):
+    d = live_dir(cfg)
+    os.makedirs(os.path.join(d, "reports"), exist_ok=True)
+    stem = os.path.join(d, "reports", rep["head"][:8])
+    runner.jdump(stem + ".json", rep)
+    with open(stem + ".md", "w", encoding="utf-8", newline="\n") as f:
+        f.write(render(rep))
+    status = {k: rep[k] for k in ("game", "head", "time", "result", "replayed_to", "total_windows")}
+    status["findings"] = dict(collections.Counter(f["level"] for f in rep["findings"]))
+    status["report"] = stem + ".md"
+    runner.jdump(os.path.join(d, "status.json"), status)
+    # the session hears about a finding once: a window replayed again after a reset (or a historical commandlet) gives
+    # the same findings, which stay in the report but not in the feedback
+    seen_p = os.path.join(d, "reported.json")
+    seen = set(runner.jload(seen_p, []) or [])
+    key = lambda f: "%s|%s|%s|%s" % (f["kind"], f.get("window"), f.get("script"), re.sub(r"\d+", "#", f["message"])[:160])
+    fresh = [f for f in rep["findings"] if key(f) not in seen]
+    runner.jdump(seen_p, sorted(seen | set(key(f) for f in rep["findings"])))
+    fb = feedback(dict(rep, findings=fresh), (stem + ".md").replace("\\", "/"))
+    fbp = os.path.join(d, "feedback.md")
+    if fb:
+        with open(fbp, "w", encoding="utf-8", newline="\n") as f:
+            f.write(fb)
+    elif os.path.exists(fbp) and rep["result"] == "ok":
+        os.remove(fbp)   # nothing open any more
+
+
+# ------------------------------------------------------------------------------------------------ job
+def catch_up(cfg, lst):
+    """One pass: ledger to HEAD, reset when needed, replay, checks. Returns the report."""
+    t0 = time.time()
+    head = head_of(cfg)
+    cfg = dict(cfg, final=head)
+    old = runner.jload(os.path.join(cfg["work_dir"], "ledger.json"))
+    new, blobs = ledger.build(cfg)
+    rep = {"schema": SCHEMA, "game": cfg["game"], "head": head, "time": runner.now(), "windows": [], "findings": [],
+           "total_windows": len(new["windows"]) - 1}
+    ctx = runner.Ctx(cfg)
+    have_project = os.path.isdir(os.path.join(cfg["project_dir"], ".git"))
+    done = ctx.state.get("window", 0) if have_project else 0
+    k = last_unchanged(old, new, done) if have_project else done
+    forced = lst.pop("restart", None)
+    if forced is not None and have_project and forced < k:
+        k = forced
+    ue_replay.save_ledger(cfg, new, blobs)
+    if not have_project:
+        runner.cmd_prepare(cfg, RunArgs)
+    elif k < done:
+        why = ("the first commit changed" if k < 0 else
+               "replay again from window %d (requested: --restart)" % (k + 1) if forced is not None and k == forced else
+               "window %d changed (history rewritten, or the settings or recording changed what it replays)" % (k + 1))
+        rep["reset"] = reset_to(cfg, old, new, k, why)
+    w0 = runner.Ctx(cfg).state.get("window", 0)
+    rep["result"] = "ok"
+    try:
+        rc = runner.cmd_run(cfg, RunArgs)
+        if rc == 3:
+            rep["result"] = "paused"
+    except SystemExit as e:
+        rep["result"], rep["error"] = "stopped", str(e.code)
+    except Exception as e:   # noqa: BLE001 - a job error becomes a finding, the lock is released by the caller
+        rep["result"], rep["error"] = "error", "%s: %s" % (type(e).__name__, e)
+        traceback.print_exc()
+    w1 = runner.Ctx(cfg).state.get("window", 0)
+    rep["windows"] = list(range(w0 + 1, w1 + 1))
+    rep["replayed_to"] = w1
+    if rep.get("error"):
+        rep["findings"].append(finding("error", "replay_stopped", "the replay stopped in window %d: %s" % (w1 + 1, rep["error"])))
+    rep["findings"] += ledger_findings(cfg, new, rep["windows"])
+    rep["findings"] += recording_findings(cfg, new, rep["windows"])
+    rep["findings"] += run_findings(cfg, rep["windows"])
+    if rep["windows"] and cfg.get("live_structure", True) and rep["result"] == "ok" and w1 == len(new["windows"]) - 1:
+        try:
+            rep["structure"], more = structure_check(cfg, new, rep["windows"], head, lst)
+            rep["findings"] += more
+        except Exception as e:   # noqa: BLE001
+            rep["findings"].append(finding("warn", "structure_check_failed", "%s: %s" % (type(e).__name__, e)))
+            traceback.print_exc()
+    if rep["result"] == "ok" and any(f["level"] in ("error", "warn") for f in rep["findings"]):
+        rep["result"] = "issues"
+    rep["seconds"] = round(time.time() - t0, 1)
+    if rep["windows"] or rep.get("reset") or rep.get("error") or not os.path.exists(os.path.join(live_dir(cfg), "status.json")):
+        write_report(cfg, rep)
+    print("live %s %s: %s, windows %s, %d finding(s), %.0f s" % (cfg["game"], head[:8], rep["result"], rep["windows"] or "-",
+                                                                 len(rep["findings"]), rep["seconds"]), flush=True)
+    return rep
+
+
+def cmd_live(cfg, a):
+    if getattr(a, "log", None):
+        os.makedirs(os.path.dirname(a.log), exist_ok=True)
+        sys.stdout = sys.stderr = open(a.log, "a", encoding="utf-8", buffering=1)
+    if not cfg.get("live") and not a.force:
+        raise SystemExit("%s: ReplayConfig.json has no \"live\": true (--force runs it anyway)" % cfg["game"])
+    os.environ["GF_HEAVY_LOW"] = "1"   # every engine process yields to the game sessions' own jobs
+    lock = Lock(cfg)
+    if not lock.acquire():
+        print("live %s: another job holds %s; it picks up the new commit" % (cfg["game"], lock.path), flush=True)
+        return 0
+    lst_path = os.path.join(live_dir(cfg), "state.json")
+    lst = runner.jload(lst_path, {})
+    if getattr(a, "restart", None) is not None:
+        # replay again from window N+1 (the project goes back to window N's commit), e.g. after a tool fix
+        lst["restart"] = int(a.restart)
+    try:
+        print("== %s live job (pid %d)" % (runner.now(), os.getpid()), flush=True)
+        while True:
+            # settings as committed now: a ReplayConfig.json change (asset_drops, run_patterns) made while this job
+            # ran must reach the next pass, which then replays the windows it changes
+            cfg = ue_replay.load_cfg(cfg["_path"])
+            rep = catch_up(cfg, lst)
+            lst.update({"head": rep["head"], "result": rep["result"], "time": rep["time"]})
+            runner.jdump(lst_path, lst)
+            if rep["result"] in ("paused", "stopped", "error") or head_of(cfg) == rep["head"]:
+                break
+    finally:
+        lock.release()
+    return 0
+
+
+def cmd_truth(cfg, a):
+    """The truth project at the settings' final commit (HEAD for a live game), editor built."""
+    sha = runner.git(cfg["repo"], "rev-parse", cfg["final"]).strip()
+    made = sync_truth(cfg, sha)
+    print("truth %s at %s (%s)" % (cfg["truth_dir"], sha[:8], "cloned" if made else "checked out"), flush=True)
+    code, secs, log = build_truth(cfg, "truth")
+    print("truth editor build: exit %s (%.0f s) %s" % (code, secs, log or ""), flush=True)
+    return code
+
+
+def cmd_release(cfg, a):
+    """Release: the live replay caught up (normal priority), truth at the final commit, full dumps, verify, package."""
+    import package
+    import verify
+    lock = Lock(cfg)
+    if not lock.acquire():
+        raise SystemExit("a live job runs for %s (work/live/lock): run release when it is done" % cfg["game"])
+    lst = runner.jload(os.path.join(live_dir(cfg), "state.json"), {})
+    try:
+        final = runner.git(cfg["repo"], "rev-parse", cfg["final"]).strip()
+        rcfg = dict(cfg, live_ref=final, live_structure=False)
+        rep = catch_up(rcfg, lst)
+        if rep["result"] not in ("ok", "issues") or rep["replayed_to"] != rep["total_windows"]:
+            raise SystemExit("release: the replay did not reach %s (%s): see %s" % (final[:8], rep["result"], live_dir(cfg)))
+        rcfg = dict(cfg, final=final)
+        sync_truth(rcfg, final)
+        code, secs, log = build_truth(rcfg, "truth_release")
+        if code:
+            raise SystemExit("release: truth editor build failed (%s)" % log)
+        # the replay project's editor too: a replay whose last windows needed no build (or whose engine switched at a
+        # port) has no module binaries for its final code, and its dump stops at "game module could not be found"
+        # (metro-runner)
+        rctx = runner.Ctx(rcfg)
+        rctx.set_engine(rctx.engine_for(rctx.uproject))
+        code, secs, log = runner.build_editor(rctx, "replay_release")
+        if code:
+            raise SystemExit("release: replay editor build failed (%s)" % log)
+        for which in ("truth", "replay"):
+            runner.cmd_dump(rcfg, type("A", (), {"which": which, "only": None}))
+        v = verify.cmd_verify(rcfg, a)
+        if v != 0:
+            if not getattr(a, "force", False):
+                raise SystemExit("release: verification FAIL (work/Verification/report.md); --force packages it anyway")
+            # --force: ReplayScripts/ with the FAIL report (no READY): the replay is there, and its verdict says how far
+            # it matches the game
+            print("release: verification FAIL; --force: packaging ReplayScripts/ with the FAIL report (no READY)")
+        return package.cmd_package(rcfg, a)
+    finally:
+        lock.release()
+
+
+def cmd_live_status(root):
+    rows = []
+    for p in sorted(glob.glob(os.path.join(root, "games", "*", "ReplayConfig.json"))):
+        try:
+            with open(p, encoding="utf-8") as f:
+                c = json.load(f)
+        except (OSError, ValueError):
+            continue
+        if not c.get("live"):
+            continue
+        cfg = ue_replay.load_cfg(p)
+        st = runner.jload(os.path.join(live_dir(cfg), "status.json"), {}) or {}
+        lock = runner.jload(os.path.join(live_dir(cfg), "lock"), None) if os.path.exists(os.path.join(live_dir(cfg), "lock")) else None
+        try:
+            head = head_of(cfg)
+        except RuntimeError:
+            head = "?"
+        rows.append((cfg["game"], head[:8], (st.get("head") or "-")[:8], "%s/%s" % (st.get("replayed_to", "-"), st.get("total_windows", "-")),
+                     st.get("result", "never run"), json.dumps(st.get("findings", {})),
+                     "running" if lock and pid_alive(lock.get("pid")) else "idle", st.get("time", "")[:16]))
+    print("%-16s %-9s %-9s %-8s %-9s %-26s %-8s %s" % ("game", "HEAD", "replayed", "windows", "result", "findings", "job", "time"))
+    for r in rows:
+        print("%-16s %-9s %-9s %-8s %-9s %-26s %-8s %s" % r)
+    if not rows:
+        print("(no game has \"live\": true in its ReplayConfig.json)")
+    return 0
diff --git a/Dataset/ReplayScripts/package.py b/Dataset/ReplayScripts/package.py
new file mode 100644
index 0000000000000000000000000000000000000000..22787687fc9ada11cb8542ea52f5c85ab1801043
--- /dev/null
+++ b/Dataset/ReplayScripts/package.py
@@ -0,0 +1,201 @@
+"""package: assemble the replay deliverable (docs/ue-replay.md, 2.6) for the dataset packager.
+
+Output: <root>/deliverables/_replay/<game>/<final sha8>/
+  ReplayScripts/            the replay tooling (unchanged; it runs outside the studio-tools checkout), the game's
+                            settings, ledger, initial-assets manifest, reconstructed script texts, verification
+  verification.json         summary: windows, verify report
+  READY                     written last, only when every window was replayed and the verification verdict is PASS
+                            (verify.py pass criteria; the packager waits for it)
+
+There is no video: the dataset carries the replay scripts only (layout v1.1). Unscrubbed: tools/package-dataset.ps1
+-ReplayScripts <...>/ReplayScripts copies and scrubs it (package-game.ps1 -ScrubDir). --force assembles an incomplete
+copy without READY (for checks only).
+"""
+import datetime
+import hashlib
+import json
+import os
+import shutil
+
+import runner
+import ue_replay
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+# record.py / editor/ue_world_replay.py (the optional editor timelapse) are not part of the dataset
+TOOLS = ["ue_replay.py", "runner.py", "ledger.py", "derive.py", "verify.py", "shellfx.py", "package.py", "live.py"]
+EDITOR = ["ue_dump.py"]
+
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def total_windows(led):
+    """Windows to replay: the ledger's list starts with window 0, the first commit itself."""
+    return (led.get("counts") or {}).get("windows", max(0, len(led.get("windows", [])) - 1))
+
+
+def copytree(src, dst, skip_ext=()):
+    n = 0
+    for root, _dirs, files in os.walk(src):
+        for fn in files:
+            if fn.lower().endswith(skip_ext):
+                continue
+            s = os.path.join(root, fn)
+            d = os.path.join(dst, os.path.relpath(s, src))
+            os.makedirs(os.path.dirname(d), exist_ok=True)
+            shutil.copy2(s, d)
+            n += 1
+    return n
+
+
+def readme(cfg, led, state, parts, report):
+    win_total = total_windows(led) if led else 0
+    ver = os.path.basename(cfg.get("engine", "").rstrip("/\\")).replace("UE_", "") or "5.8"   # the game's own engine
+    lines = [
+        "# ReplayScripts: creation replay of %s" % cfg["game"], "",
+        "Replays how the game was built, from its git history, the builder's recorded actions and `workflow.jsonl`,",
+        "in an isolated copy of the project, and checks the result against the final commit. The supplied project is",
+        "not changed.", "",
+        "## What is observed and what is derived", "",
+        "- Observed: the commits (code, scripts, config, source art), the exact script texts at the moment they ran",
+        "  (rebuilt from the recorded writes and edits, `Blobs/`), the editor-script runs in their original order with",
+        "  their workflow rows, and the store packs copied in (`initial-assets.manifest.json`).",
+        "- Verified: the replayed project against the final commit (`Verification/`: report, per-window checks, JSON",
+        "  structure dumps of both projects).", "",
+        "## How to replay", "",
+        "Requirements: Windows, Unreal Engine %s, Visual Studio 2022 (C++), Python 3.11+, git with Git LFS, and the game" % ver,
+        "repository. Set the machine root (`GF_ROOT`) and point `game.json` at the repository, then:", "",
+        "```",
+        "python ue_replay.py ledger  --game game.json   # windows, runs, script texts",
+        "python ue_replay.py prepare --game game.json   # isolated project at the first commit + truth project",
+        "python ue_replay.py run     --game game.json   # every window headless; resumable",
+        "python ue_replay.py verify  --game game.json   # final state vs the final commit",
+        "```", "",
+        "## Results", "",
+        "- Windows replayed: %d of %d (first commit `%s`, final `%s`)." % (state.get("window", 0), win_total,
+                                                                           (led or {}).get("first", "?")[:8], (led or {}).get("final", "?")[:8]),
+    ]
+    if report:
+        summ = report.get("summary") or {k: v for k, v in report.items() if not isinstance(v, (list, dict))}
+        lines.append("- Verification (`Verification/report.md`): " + ", ".join("%s %s" % (k, v) for k, v in list(summ.items())[:12]) + ".")
+    missing = [k for k, v in parts.items() if not v]
+    if missing:
+        lines.append("- Not included yet: " + ", ".join(missing) + ".")
+    if report:
+        import verify
+        lines += [""] + verify.render_deviations(report.get("deviations") or [])
+    return "\n".join(lines) + "\n"
+
+
+def cmd_package(cfg, a):
+    ctx = runner.Ctx(cfg)
+    led = ctx.ledger
+    if not led:
+        raise SystemExit("no ledger: run `ue_replay.py ledger` first")
+    work = ctx.work
+    final = led["final"]
+    out = os.path.join(ue_replay.out_root(), "_replay", cfg["game"], final[:8]).replace("/", os.sep)
+    rs = os.path.join(out, "ReplayScripts")
+    src = {
+        "windows complete": ctx.state.get("window", 0) >= total_windows(led) > 0,
+        "Verification/report.json": os.path.isfile(os.path.join(work, "Verification", "report.json")),
+        "verification PASS": bool((runner.jload(os.path.join(work, "Verification", "report.json"), {}) or {}).get("verdict", {}).get("pass")),
+    }
+    complete = all(src.values())
+    for k, v in src.items():
+        print("  %-36s %s" % (k, "ok" if v else "MISSING"))
+    if not complete and not a.force:
+        raise SystemExit("incomplete: nothing written (--force assembles a copy without READY, for checks)")
+    if os.path.isdir(out):
+        shutil.rmtree(out)
+    os.makedirs(os.path.join(rs, "editor"))
+    for f in TOOLS:
+        shutil.copy2(os.path.join(HERE, f), os.path.join(rs, f))
+    for f in EDITOR:
+        shutil.copy2(os.path.join(HERE, "editor", f), os.path.join(rs, "editor", f))
+    # Preserve portable placeholders, but pin the copy to the verified ledger. A live config's HEAD/branch can
+    # advance after delivery; rebuilding its ledger must still target the commit named by this package/report.
+    with open(cfg["_path"], encoding="utf-8") as config_file:
+        export_cfg = json.load(config_file)
+    export_cfg["final"] = final
+    runner.jdump(os.path.join(rs, "game.json"), export_cfg)
+    # The derived world ops (world-ops.jsonl, one T3D block per actor, ~1 GB) and the T3D map exports only fed the
+    # optional editor video; they are not needed to replay or verify, so they stay out of ReplayScripts/.
+    for name, dst in (("ledger.json", "ledger.json"), ("initial-assets.manifest.json", "initial-assets.manifest.json")):
+        if os.path.isfile(os.path.join(work, name)):
+            shutil.copy2(os.path.join(work, name), os.path.join(rs, dst))
+    nblobs = copytree(os.path.join(work, "blobs"), os.path.join(rs, "Blobs")) if os.path.isdir(os.path.join(work, "blobs")) else 0
+    vdir = os.path.join(rs, "Verification")
+    os.makedirs(vdir)
+    for name in ("report.md", "report.json"):
+        p = os.path.join(work, "Verification", name)
+        if os.path.isfile(p):
+            shutil.copy2(p, os.path.join(vdir, name))
+    if os.path.isfile(os.path.join(work, "windows.jsonl")):
+        shutil.copy2(os.path.join(work, "windows.jsonl"), os.path.join(vdir, "windows.jsonl"))
+    for d in ("dump-replay", "dump-truth"):
+        if os.path.isdir(os.path.join(work, d)):
+            copytree(os.path.join(work, d), os.path.join(vdir, d), skip_ext=(".t3d",))
+    report = runner.jload(os.path.join(work, "Verification", "report.json"), None)
+    with open(os.path.join(rs, "README.md"), "w", encoding="utf-8", newline="\n") as f:
+        f.write(readme(cfg, led, ctx.state, src, report))
+    # the build machine's per-session folders and ids in the recorded data become neutral names (ue_replay.
+    # SESSION_PATH_RULES); the settings templates still match them, so a replay from this folder works the same
+    neutral = {}
+    sids = ue_replay.recording_session_ids(cfg)
+    for dp, _, fns in os.walk(rs):
+        for fn in fns:
+            if not fn.lower().endswith((".json", ".jsonl", ".md", ".py", ".txt", ".tsv", ".csv", ".ini", ".sh", ".ps1")):
+                continue
+            fp = os.path.join(dp, fn)
+            with open(fp, "rb") as f:
+                b = f.read()
+            t = b.decode("utf-8", "surrogateescape")
+            t2, c = ue_replay.neutral_session_paths(t, sids)
+            if c:
+                with open(fp, "wb") as f:
+                    f.write(t2.encode("utf-8", "surrogateescape"))
+                for k, v in c.items():
+                    neutral[k] = neutral.get(k, 0) + v
+    summary = {
+        "schema": "ue-replay.package/v1", "game": cfg["game"], "first_commit": led.get("first"), "final_commit": final,
+        "created": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "complete": complete, "parts": src,
+        "windows": {"done": ctx.state.get("window", 0), "total": total_windows(led)}, "blobs": nblobs,
+        "verdict": (report or {}).get("verdict"), "verify": report, "session_paths_neutralised": neutral,
+    }
+    runner.jdump(os.path.join(out, "verification.json"), summary)
+    if complete:
+        with open(os.path.join(out, "READY"), "w", encoding="utf-8", newline="\n") as f:
+            f.write(summary["created"] + "\n")
+    print("%s %s -> %s" % ("READY" if complete else "INCOMPLETE (no READY)", cfg["game"], out))
+    return 0 if complete else 1
+
+
+def cmd_clean(cfg, a):
+    """Free the disk a finished replay holds: the replay project, the truth project and the work files the package
+    copied (dumps, blobs, rows, logs). Only after `package` wrote READY for the settings' final commit; lists what it
+    would remove unless --yes is given. The ledger, state and verification report stay in work/."""
+    final = runner.Ctx(cfg).ledger["final"]
+    out = os.path.join(ue_replay.out_root(), "_replay", cfg["game"], final[:8])
+    if not os.path.exists(os.path.join(out, "READY")):
+        raise SystemExit("no READY replay package at %s: nothing removed" % out)
+    work = cfg["work_dir"]
+    targets = [cfg["project_dir"], cfg["truth_dir"]] + [os.path.join(work, d) for d in
+                                                         ("blobs", "rows", "logs", "mapdumps", "dump-replay", "dump-truth")]
+    targets = [t for t in targets if os.path.exists(t)]
+    total = 0
+    for t in targets:
+        size = sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(t) for f in fs)
+        total += size
+        print("  %-8s %7.2f GB  %s" % ("remove" if a.yes else "would rm", size / 1e9, t))
+        if a.yes:
+            def writable(fn, p, _exc):   # git objects are read-only on Windows
+                os.chmod(p, 0o666)
+                fn(p)
+            shutil.rmtree(t, onerror=writable)
+    print("%s %.2f GB for %s" % ("freed" if a.yes else "would free (add --yes)", total / 1e9, cfg["game"]))
diff --git a/Dataset/ReplayScripts/runner.py b/Dataset/ReplayScripts/runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..506a0f2794108c8145acd11d8795f9242c5e9bc4
--- /dev/null
+++ b/Dataset/ReplayScripts/runner.py
@@ -0,0 +1,1057 @@
+"""prepare / run / dump / status for the Unreal creation replay (see docs/ue-replay.md).
+
+The replay project is a private clone of the game repo (objects shared, Git LFS reading the game's own store), checked
+out at the first commit. `run` walks the ledger's windows: inputs from the commit, script texts as they were when each
+script ran, initial-asset drops and shell steps at their recorded positions, an editor build when the code changed,
+every editor-script run headless through ue-heavy.ps1, then the boundary check. Resumable: work/state.json; a
+work/STOP file pauses it cleanly between steps.
+"""
+import datetime
+import glob
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+import ue_replay
+
+HEAVY = os.path.join(ue_replay.machine_root(), "tools", "ue-heavy.ps1")   # GF_ROOT, the machine config, else ~/Work
+HERE = os.path.dirname(os.path.abspath(__file__))
+DUMP = os.path.join(HERE, "editor", "ue_dump.py").replace("\\", "/")
+
+
+# ------------------------------------------------------------------------------------------------ helpers
+def now():
+    return datetime.datetime.now().astimezone().isoformat(timespec="milliseconds")
+
+
+def jdump(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        json.dump(obj, f, ensure_ascii=False, indent=1)
+        f.write("\n")
+
+
+def jappend(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "a", encoding="utf-8", newline="\n") as f:
+        f.write(json.dumps(obj, ensure_ascii=False) + "\n")
+
+
+def jload(path, default=None):
+    if not os.path.exists(path):
+        return default
+    with open(path, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def git(repo, *args, check=True, binary=False, env=None, inp=None):
+    e = dict(os.environ)
+    if env:
+        e.update(env)
+    r = subprocess.run(["git", "-C", repo, "-c", "core.quotepath=off", "-c", "core.autocrlf=false"] + list(args),
+                       capture_output=True, env=e, input=inp)
+    if check and r.returncode != 0:
+        raise RuntimeError("git %s: %s" % (" ".join(args[:3]), r.stderr.decode("utf-8", "replace")[-800:]))
+    return r.stdout if binary else r.stdout.decode("utf-8", "replace")
+
+
+def ps_quote(s):
+    return "'" + str(s).replace("'", "''") + "'"
+
+
+def heavy_script():
+    """ue-heavy.ps1 and its extra switches. GF_HEAVY_LOW=1 (the live per-commit replay): low priority, -Low, which the
+    installed copy may not know yet; this checkout's machine/tools copy shares its machine-wide slots."""
+    if os.environ.get("GF_HEAVY_LOW") != "1":
+        return HEAVY, ""
+    for p in (HEAVY, os.path.join(HERE, "..", "..", "machine", "tools", "ue-heavy.ps1")):
+        try:
+            if "[switch]$Low" in open(p, encoding="utf-8-sig").read():
+                return os.path.abspath(p), " -Low"
+        except OSError:
+            pass
+    return HEAVY, ""
+
+
+def heavy(label, argv, log_path=None, env=None):
+    """Run one engine process through ue-heavy.ps1 (machine-wide slots); returns (exit code, seconds)."""
+    script, extra = heavy_script()
+    cmd = "& %s -Label %s%s -- %s; exit $LASTEXITCODE" % (ps_quote(script), ps_quote(label), extra, " ".join(ps_quote(a) for a in argv))
+    e = dict(os.environ)
+    if env:
+        e.update(env)
+    t0 = time.time()
+    out = open(log_path + ".console", "wb") if log_path else subprocess.DEVNULL
+    try:
+        r = subprocess.run(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", cmd],
+                           stdout=out, stderr=subprocess.STDOUT, env=e)
+    finally:
+        if log_path:
+            out.close()
+    return r.returncode, round(time.time() - t0, 1)
+
+
+def sha256_file(p):
+    h = hashlib.sha256()
+    with open(p, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def git_blob_sha1_file(p):
+    with open(p, "rb") as f:
+        data = f.read()
+    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()
+
+
+def scan(root, sub="Content"):
+    """{repo path: (size, mtime_ns)} of every file under root/sub."""
+    out = {}
+    base = os.path.join(root, sub)
+    for dp, _, files in os.walk(base):
+        for fn in files:
+            fp = os.path.join(dp, fn)
+            st = os.stat(fp)
+            out[os.path.relpath(fp, root).replace("\\", "/")] = (st.st_size, st.st_mtime_ns)
+    return out
+
+
+def diff_scan(a, b):
+    added = sorted(p for p in b if p not in a)
+    deleted = sorted(p for p in a if p not in b)
+    changed = sorted(p for p in b if p in a and a[p] != b[p])
+    return added, changed, deleted
+
+
+def tree_ids(repo, sha, prefix=""):
+    """{path: ('lfs', sha256) | ('git', sha1)} for files of a commit (LFS pointers resolved to their oid)."""
+    out = {}
+    small = []
+    for line in git(repo, "ls-tree", "-r", "-l", sha, "--", prefix or ".").splitlines():
+        meta, path = line.split("\t", 1)
+        mode, typ, oid, size = meta.split()
+        if typ != "blob":
+            continue
+        out[path] = ("git", oid)
+        if size != "-" and int(size) < 300:
+            small.append((path, oid))
+    if small:
+        data = git(repo, "cat-file", "--batch", inp="\n".join(o for _, o in small).encode() + b"\n", binary=True)
+        pos = 0
+        for path, oid in small:
+            nl = data.index(b"\n", pos)
+            hdr = data[pos:nl].split()
+            n = int(hdr[2])
+            body = data[nl + 1:nl + 1 + n]
+            pos = nl + 1 + n + 1
+            if body.startswith(b"version https://git-lfs.github.com/spec/v1"):
+                for ln in body.split(b"\n"):
+                    if ln.startswith(b"oid sha256:"):
+                        out[path] = ("lfs", ln[len(b"oid sha256:"):].decode())
+    return out
+
+
+def file_matches(fp, ident):
+    if not os.path.exists(fp):
+        return False
+    kind, oid = ident
+    return (sha256_file(fp) if kind == "lfs" else git_blob_sha1_file(fp)) == oid
+
+
+# ------------------------------------------------------------------------------------------------ paths
+class Ctx:
+    def __init__(self, cfg):
+        self.cfg = cfg
+        self.repo = cfg["repo"]
+        self.proj = cfg["project_dir"]
+        self.work = cfg["work_dir"]
+        self.uproject = os.path.join(self.proj, cfg["uproject"])
+        self.ledger = jload(os.path.join(self.work, "ledger.json"))
+        self.state_path = os.path.join(self.work, "state.json")
+        self.state = jload(self.state_path, {"window": 0, "done": [], "built": None, "provenance": {}})
+        # the engine in use: the one the replay project was last built with (state), else the one its .uproject names
+        self.set_engine(self.state.get("engine") or self.engine_for(self.proj))
+        self.logs = os.path.join(self.work, "logs")
+        os.makedirs(self.logs, exist_ok=True)
+
+    def engine_for(self, project):
+        """The engine for a project folder (or .uproject) as it stands on disk: with "{engine}" settings the install its
+        EngineAssociation names (a ported game's early commits name the older engine); a literal "engine" is used as is."""
+        if self.cfg.get("_engine_per_commit") and project and os.path.exists(project):
+            return ue_replay.machine_engine(project)
+        return self.cfg["engine"]
+
+    def set_engine(self, engine):
+        self.engine = engine.replace("\\", "/").rstrip("/")
+        self.editor_cmd = os.path.join(self.engine, "Engine", "Binaries", "Win64", "UnrealEditor-Cmd.exe")
+
+    def save(self):
+        jdump(self.state_path, self.state)
+
+    def p(self, rel):
+        return os.path.join(self.proj, rel)
+
+
+# ------------------------------------------------------------------------------------------------ prepare
+def clone_at(cfg, dest, sha):
+    if os.path.exists(os.path.join(dest, ".git")):
+        return False
+    repo = cfg["repo"]
+    os.makedirs(os.path.dirname(dest), exist_ok=True)
+    subprocess.run(["git", "clone", "-q", "--shared", "--no-checkout", repo, dest], check=True)
+    for k, v in (("core.autocrlf", "false"), ("core.eol", "lf"), ("lfs.storage", repo.replace("\\", "/") + "/.git/lfs"),
+                 ("lfs.fetchrecentalways", "false"), ("remote.origin.url", repo.replace("\\", "/"))):
+        git(dest, "config", k, v)
+    git(dest, "checkout", "-q", "--detach", sha)
+    return True
+
+
+def external_dir(ctx, e):
+    return os.path.join(ctx.work, "external", e["id"])
+
+
+def build_externals(ctx):
+    """External sources with a "rebuild" recipe (the builder unpacked library archives into a scratch folder that no
+    longer exists): {"unzip": [{"zip": "<glob>", "to": "<subdir>", "exclude": ["*Cavity*", ...]}]} rebuilds the folder
+    under work/external/<id>/; runs whose env names the recorded folder get this one (map_external_env)."""
+    import fnmatch
+    import glob
+    import zipfile
+    for e in ctx.cfg.get("external_sources", []):
+        rb = e.get("rebuild")
+        if not rb:
+            continue
+        d = external_dir(ctx, e)
+        if os.path.isdir(d):
+            continue
+        tmp = d + ".partial"
+        shutil.rmtree(tmp, ignore_errors=True)
+        n = 0
+        for u in rb.get("unzip", []):
+            zips = sorted(glob.glob(u["zip"]))
+            if not zips:
+                sys.exit("external source %s: no archive matches %s" % (e["id"], u["zip"]))
+            for z in zips:
+                with zipfile.ZipFile(z) as zf:
+                    for m in zf.namelist():
+                        if m.endswith("/") or any(fnmatch.fnmatch(m, x) for x in u.get("exclude", [])):
+                            continue
+                        zf.extract(m, os.path.join(tmp, u.get("to", "")))
+                        n += 1
+        os.replace(tmp, d)
+        print("external source %s rebuilt: %d files -> %s" % (e["id"], n, d))
+
+
+def external_target(ctx, e):
+    """Where an external source is on this machine: its rebuilt folder, else its settings path."""
+    return (external_dir(ctx, e) if e.get("rebuild") else e.get("path") or "").replace("\\", "/")
+
+
+def map_external_env(ctx, env):
+    """Env values naming an external source's recorded location (settings "recorded": a template with {home}/{root}/*,
+    as the recording has it on the machine the game was built on) point at the source on this machine."""
+    for e in ctx.cfg.get("external_sources", []):
+        if not e.get("recorded"):
+            continue
+        rx = ue_replay.recorded_path_regex(e["recorded"])
+        loc = external_target(ctx, e)
+        for k, v in env.items():
+            m = rx.match(v)
+            if m:
+                env[k] = loc + v[m.end():].replace("\\", "/")
+    return env
+
+
+def remap_script_paths(ctx):
+    """External sources with "remap_scripts": recorded scripts that open the recorded location by an absolute path
+    (island: import_art_v1.py reads the scout's path map from a notes folder) get this machine's location for the run.
+    Returns [(file, original bytes)] to put back after the run (files outside Content are compared byte for byte)."""
+    srcs = [(ue_replay.recorded_path_regex(e["recorded"]), external_target(ctx, e))
+            for e in ctx.cfg.get("external_sources", []) if e.get("remap_scripts") and e.get("recorded")]
+    if not srcs:
+        return []
+    changed = []
+    for dp, dns, fns in os.walk(ctx.p("Scripts")):
+        dns[:] = [d for d in dns if d != "__pycache__"]
+        for fn in fns:
+            if not fn.endswith(".py"):
+                continue
+            fp = os.path.join(dp, fn)
+            with open(fp, "rb") as f:
+                b = f.read()
+            t = b.decode("utf-8", "replace")
+            t2 = t
+            for rx, loc in srcs:
+                t2 = rx.sub(lambda m: loc, t2)
+            if t2 != t:
+                with open(fp, "wb") as f:
+                    f.write(t2.encode("utf-8"))
+                changed.append((fp, b))
+    return changed
+
+
+def cmd_prepare(cfg, a):
+    ctx = Ctx(cfg)
+    if ctx.ledger is None:
+        sys.exit("run `ledger` first")
+    first = ctx.ledger["first"]
+    t0 = time.time()
+    made = clone_at(cfg, ctx.proj, first)
+    st = git(ctx.proj, "status", "--short")
+    print("project %s at %s (%s, %.0f s); status: %s" % (ctx.proj, first[:10], "cloned" if made else "exists",
+                                                          time.time() - t0, st.strip() or "clean"))
+    if made or not ctx.state.get("provenance"):
+        prov = {p: "git:" + first[:10] for p in scan(ctx.proj)}
+        ctx.state["provenance"] = prov
+        ctx.save()
+    build_externals(ctx)
+    manifest = initial_assets_manifest(cfg, ctx)
+    jdump(os.path.join(ctx.work, "initial-assets.manifest.json"), manifest)
+    print("initial assets: %d files, %.2f GB" % (manifest["counts"]["files"], manifest["counts"]["bytes"] / 1e9))
+
+
+def initial_assets_manifest(cfg, ctx):
+    """Store packs dropped in and external source files the scripts read, with sha256 per file."""
+    files = []
+    for d in cfg.get("asset_drops", []):
+        for it in d["items"]:
+            if it.get("from_git"):
+                ref = it.get("ref") or ctx.ledger["final"]
+                for fp, size, sha in git_tree_files(cfg["repo"], ref, it["from_git"]):
+                    files.append({"role": "store_pack", "drop": d["id"], "pack": it.get("pack"), "path": fp, "bytes": size,
+                                  "sha256": sha, "source": "commit %s (git/LFS)" % ref[:10]})
+                continue
+            if os.path.isfile(it["from"]):
+                files.append({"role": "store_pack", "drop": d["id"], "pack": it.get("pack"), "path": it["to"],
+                              "bytes": os.path.getsize(it["from"]), "sha256": sha256_file(it["from"])})
+                continue
+            for dp, _, fns in os.walk(it["from"]):
+                for fn in fns:
+                    fp = os.path.join(dp, fn)
+                    rel = os.path.relpath(fp, it["from"]).replace("\\", "/")
+                    files.append({"role": "store_pack", "drop": d["id"], "pack": it.get("pack"), "path": it["to"] + "/" + rel,
+                                  "bytes": os.path.getsize(fp), "sha256": sha256_file(fp)})
+    ext = []
+    for e in cfg.get("external_sources", []):
+        ext.append({"id": e["id"], "role": e["role"], "root": "<external:%s>" % e["id"],
+                    **({"rebuild": e["rebuild"]} if e.get("rebuild") else {})})
+        d = external_dir(ctx, e)
+        if e.get("rebuild") and os.path.isdir(d):
+            for dp, _, fns in os.walk(d):
+                for fn in fns:
+                    fp = os.path.join(dp, fn)
+                    files.append({"role": "external_source", "source": e["id"],
+                                  "path": "<external:%s>/%s" % (e["id"], os.path.relpath(fp, d).replace("\\", "/")),
+                                  "bytes": os.path.getsize(fp), "sha256": sha256_file(fp)})
+    return {"schema": "ue-replay.initial-assets/v1", "game": cfg["game"], "first_commit": ctx.ledger["first"],
+            "drops": [{k: v for k, v in d.items() if k != "match"} for d in cfg.get("asset_drops", [])],
+            "external_sources": ext, "files": files,
+            "counts": {"files": len(files), "bytes": sum(f["bytes"] for f in files)}}
+
+
+# ------------------------------------------------------------------------------------------------ steps
+def apply_inputs(ctx, w):
+    """Files outside Content/ as the commit has them (adds/modifies via checkout, deletes removed)."""
+    am = [x["path"] for x in w["inputs"] if x["status"] in "AMT" and x["path"] != "workflow.jsonl"]
+    dl = [x["path"] for x in w["inputs"] if x["status"] == "D"]
+    if am:
+        git(ctx.proj, "checkout", w["sha"], "--pathspec-from-file=-", inp="\n".join(am).encode("utf-8"))
+        fix_lfs_pointers(ctx, am)
+    for p in dl:
+        fp = ctx.p(p)
+        if os.path.exists(fp):
+            os.remove(fp)
+    # workflow.jsonl: the commit's version (scripts append to it; their rows are cut out per run)
+    if any(x["path"] == "workflow.jsonl" for x in w["inputs"]):
+        data = git(ctx.proj, "show", "%s:workflow.jsonl" % w["sha"], binary=True)
+        with open(ctx.p("workflow.jsonl"), "wb") as f:
+            f.write(data)
+    return len(am), len(dl)
+
+
+def code_changed(w):
+    return any(x["path"].startswith(("Source/", "Plugins/")) or x["path"].endswith((".uproject", ".Build.cs", ".Target.cs"))
+               for x in w["inputs"])
+
+
+def apply_run_code(ctx, w, want):
+    """Make the project's code files what the run needs: the ledger's run-time texts (want: path -> blob sha256 or
+    "absent") over the window's commit; files an earlier run changed and this one does not go back to the commit.
+    Returns True when a file changed (the editor must be rebuilt)."""
+    have = ctx.state.get("code_applied") or {}
+    if want == have:
+        return False
+    in_tree = None
+    for p in sorted(set(have) | set(want)):
+        fp = ctx.p(p)
+        if p in want:
+            if want[p] == "absent":
+                if os.path.exists(fp):
+                    os.remove(fp)
+            else:
+                with open(os.path.join(ctx.work, "blobs", want[p]), "rb") as f:
+                    data = f.read()
+                os.makedirs(os.path.dirname(fp), exist_ok=True)
+                with open(fp, "wb") as f:
+                    f.write(data)
+        else:
+            if in_tree is None:
+                in_tree = set(git(ctx.proj, "ls-tree", "-r", "--name-only", w["sha"]).splitlines())
+            if p in in_tree:
+                git(ctx.proj, "checkout", w["sha"], "--", p)
+            elif os.path.exists(fp):
+                os.remove(fp)
+    ctx.state["code_applied"] = dict(want)
+    ctx.state["code_dirty"] = True
+    ctx.save()
+    return True
+
+
+def build_editor(ctx, label, sha=None):
+    cfg = ctx.cfg
+    log = os.path.join(ctx.logs, "build_%s.log" % label)
+    bat = os.path.join(ctx.logs, "build_%s.bat" % label)
+    # UBT's own log goes to a file of this build (-Log=): the default %LOCALAPPDATA%\UnrealBuildTool\Log.txt is shared
+    # by every UBT on the machine, and a second build starting while one runs fails moving it ("being used by another
+    # process"; rts-command w10)
+    ubt_log = os.path.join(ctx.logs, "ubt_%s.txt" % label)
+    with open(bat, "w", encoding="utf-8") as f:
+        f.write('@echo off\r\ncall "%s\\Engine\\Build\\BatchFiles\\Build.bat" %s Win64 Development -Project="%s" -WaitMutex '
+                '-NoHotReloadFromIDE -Log="%s" > "%s" 2>&1\r\nexit /b %%ERRORLEVEL%%\r\n' % (
+                    ctx.engine.replace("/", "\\"), cfg["editor_target"], ctx.uproject.replace("/", "\\"), ubt_log, log))
+    code, secs = heavy("ue-replay %s build %s" % (cfg["game"], label), [bat])
+    if code != 0 and "being used by another process" in open(log, encoding="utf-8", errors="replace").read():
+        # a file another build holds (UBT logs, makefiles): once more after a pause
+        time.sleep(60)
+        os.replace(log, log[:-4] + ".locked.log")
+        code, secs2 = heavy("ue-replay %s build %s (retry)" % (cfg["game"], label), [bat])
+        secs += secs2
+    if code != 0 and re.search(r": (?:fatal )?error C\d{4}", open(log, encoding="utf-8", errors="replace").read()):
+        # Compile errors the original build did not have. UBT's adaptive unity build compiles the files git reports as
+        # modified on their own and the rest in unity blobs. The replay project's HEAD is the game's first commit, so
+        # nearly every file counts as modified there; the session building the game had HEAD at the previous commit,
+        # and only the files it was editing were. Which grouping a file needs differs: rts-command w06 broke in a
+        # unity blob (a global of another .cpp shadows a local, C4459), battle-boats w25 alone (an include another
+        # file supplied in the blob). So: (1) the session's working set: HEAD and index at the window's parent for this
+        # build only (the working tree is not touched); (2) every file in unity blobs (-DisableAdaptiveUnity).
+        # -DisableUnity is not an option on an installed engine (a unique build environment the engine's own modules
+        # cannot be rebuilt for), and UBT reads no project-level BuildConfiguration.xml for builds.
+        parent = None
+        if sha:
+            try:
+                parent = git(ctx.proj, "rev-parse", "%s^" % sha).strip()
+            except Exception:
+                parent = None
+        attempts = ([("_workset", [], parent)] if parent else []) + [("_unity", ["-DisableAdaptiveUnity"], None),
+                                                                       ("_nounity", [], "build.cs")]
+        for suffix, extra, base in attempts:
+            # (3) every file of the game's module on its own: bUseUnity = false in the module's .Build.cs for this build
+            # only (a module rule, not a target one, so no unique build environment), restored afterwards
+            buildcs, buildcs_old = None, None
+            if base == "build.cs":
+                base = None
+                mod = cfg.get("module") or cfg["editor_target"].replace("Editor", "")
+                buildcs = os.path.join(ctx.proj, "Source", mod, mod + ".Build.cs")
+                if not os.path.isfile(buildcs):
+                    continue
+                buildcs_old = open(buildcs, "rb").read()
+                txt = buildcs_old.decode("utf-8", "surrogateescape")
+                m = re.search(r"(:\s*base\s*\(\s*\w+\s*\)\s*\{)", txt)
+                if not m:
+                    continue
+                with open(buildcs, "wb") as f:
+                    f.write((txt[:m.end()] + "\n\t\tbUseUnity = false;   // replay build only" + txt[m.end():]).encode("utf-8", "surrogateescape"))
+            nu_label = label + suffix
+            nu_log = os.path.join(ctx.logs, "build_%s.log" % nu_label)
+            nu_bat = os.path.join(ctx.logs, "build_%s.bat" % nu_label)
+            with open(nu_bat, "w", encoding="utf-8") as f:
+                f.write('@echo off\r\ncall "%s\\Engine\\Build\\BatchFiles\\Build.bat" %s Win64 Development -Project="%s" -WaitMutex '
+                        '-NoHotReloadFromIDE %s-Log="%s" > "%s" 2>&1\r\nexit /b %%ERRORLEVEL%%\r\n' % (
+                            ctx.engine.replace("/", "\\"), cfg["editor_target"], ctx.uproject.replace("/", "\\"),
+                            "".join(x + " " for x in extra), os.path.join(ctx.logs, "ubt_%s.txt" % nu_label), nu_log))
+            saved_head = saved_index = None
+            index = os.path.join(ctx.proj, ".git", "index")
+            if base:
+                saved_head = git(ctx.proj, "rev-parse", "HEAD").strip()
+                saved_index = index + ".replay-saved"
+                shutil.copy2(index, saved_index)
+                git(ctx.proj, "update-ref", "--no-deref", "HEAD", base)
+                git(ctx.proj, "read-tree", base)
+            how = ("with the session's working set (HEAD at %s)" % base[:8] if base else
+                   "with every file of the module on its own" if buildcs else "with every file in unity blobs")
+            print("build %s: compile errors; once more %s" % (label, how), flush=True)
+            try:
+                code, secs2 = heavy("ue-replay %s build %s (%s)" % (cfg["game"], label, suffix.strip("_")), [nu_bat])
+            finally:
+                if base:
+                    git(ctx.proj, "update-ref", "--no-deref", "HEAD", saved_head)
+                    os.replace(saved_index, index)
+                if buildcs_old is not None:
+                    with open(buildcs, "wb") as f:
+                        f.write(buildcs_old)
+            secs += secs2
+            log = nu_log
+            if code == 0:
+                break
+    return code, secs, log
+
+
+def materialize_scripts(ctx, run):
+    """Script files as they stood when the run started (ledger texts); unknown ones keep the commit's version."""
+    n = 0
+    for p, h in run["texts"].items():
+        src = os.path.join(ctx.work, "blobs", h)
+        with open(src, "rb") as f:
+            data = f.read()
+        fp = ctx.p(p)
+        os.makedirs(os.path.dirname(fp), exist_ok=True)
+        with open(fp, "wb") as f:
+            f.write(data)
+        n += 1
+    # files the recording cannot rebuild at this point (e.g. after a perl -i edit) get the window's commit text; left
+    # alone they kept whatever an earlier run of the window had written (stealth: build_level_L01.py imported the
+    # pre-perl level_kit.py, whose spawn() fails, and L01 got 16 of its 150 actors)
+    sha = run.get("window_sha") or ctx.state.get("window_sha")
+    for p in run.get("unknown") or []:
+        if not sha:
+            break
+        try:
+            data = git(ctx.proj, "show", "%s:%s" % (sha, p), binary=True)
+        except Exception:
+            continue
+        fp = ctx.p(p)
+        os.makedirs(os.path.dirname(fp), exist_ok=True)
+        with open(fp, "wb") as f:
+            f.write(data)
+        n += 1
+    return n
+
+
+def external_script(ctx, run):
+    """A script outside the game repo (e.g. a pipeline tool): its version at the run time from its own git history."""
+    path = run["script"]
+    d = os.path.dirname(path)
+    top = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
+    if top.returncode != 0:
+        return path, "current_file"
+    top = top.stdout.strip()
+    rel = os.path.relpath(path, top).replace("\\", "/")
+    sha = git(top, "log", "-1", "--format=%H", "--before=" + run["start"], "--", rel).strip()
+    if not sha:
+        return path, "current_file"
+    data = git(top, "show", "%s:%s" % (sha, rel), binary=True)
+    out = os.path.join(ctx.work, "external", sha[:10], os.path.basename(rel))
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    with open(out, "wb") as f:
+        f.write(data)
+    return out.replace("\\", "/"), "%s@%s" % (rel, sha[:10])
+
+
+def run_editor_script(ctx, run):
+    cfg = ctx.cfg
+    if run["script"].startswith("Scripts/") or not os.path.isabs(run["script"]):
+        script = ctx.p(run["script"]).replace("\\", "/")
+        version = run["script_version"]
+    else:
+        script, version = external_script(ctx, run)
+    env = {k: v.replace("{project}", ctx.proj) for k, v in cfg.get("script_env", {}).items()}
+    # values the builder's shell expanded ($USERPROFILE, %USERPROFILE%, ...) as the recording machine had them
+    env.update({k: os.path.expandvars(v) for k, v in (run.get("env") or {}).items()})
+    build_externals(ctx)
+    map_external_env(ctx, env)
+    if run.get("reason") and cfg.get("reason_env"):
+        env[cfg["reason_env"]] = run["reason"]
+    if cfg.get("args_env") and run.get("via_wrapper"):
+        # the game's wrapper hands its extra arguments to the script in an environment variable (rally: RR_ARGS)
+        env[cfg["args_env"]] = run.get("args") or ""
+        run = dict(run, args="")
+    log = os.path.join(ctx.logs, "runs", "%s_%s.log" % (run["id"], os.path.splitext(os.path.basename(run["script"]))[0]))
+    os.makedirs(os.path.dirname(log), exist_ok=True)
+    if run.get("mode") not in (None, "", "commandlet"):   # "editor", or a wrapper's own name for it (e.g. "gui")
+        # the builder ran it in a full (headless) editor, not the commandlet: -ExecutePythonScript, quits when done
+        argv = [ctx.editor_cmd, ctx.uproject, "-ExecutePythonScript=%s" % script] + cfg.get("editor_args", [])
+        if not any(x.lower() == "-nullrhi" for x in argv):
+            argv.append("-nullrhi")
+        argv.append("-abslog=" + log)
+    else:
+        sarg = "-script=%s%s" % (script, (" " + run["args"]) if run.get("args") else "")
+        argv = [ctx.editor_cmd, ctx.uproject, "-run=pythonscript", sarg] + cfg.get("editor_args", []) + ["-abslog=" + log]
+    code, secs = heavy("ue-replay %s %s %s" % (cfg["game"], run["id"], os.path.basename(run["script"])), argv, env=env)
+    return code, secs, log, version
+
+
+def engine_crashed(log):
+    """The editor process died on an engine assertion/critical error (not a Python exception in the script)."""
+    try:
+        with open(log, encoding="utf-8", errors="replace") as f:
+            t = f.read()
+    except OSError:
+        return False
+    return "=== Critical error: ===" in t or "appError called" in t
+
+
+def wf_rows(path):
+    if not os.path.exists(path):
+        return []
+    with open(path, encoding="utf-8") as f:
+        return [l for l in f.read().splitlines() if l.strip()]
+
+
+def dump_maps(ctx, maps, out, assets=False, t3d=True, label="dump", project=None, packages=None):
+    """Structure dump through the editor; packages: only these assets (a list of package names), maps: a list or "all"."""
+    proj = project or ctx.proj
+    up = os.path.join(proj, ctx.cfg["uproject"])
+    log = os.path.join(ctx.logs, "%s.log" % label)
+    sarg = "-script=%s --out %s --roots %s --map-roots %s --maps %s --assets %s --t3d %s --module %s" % (
+        DUMP, out.replace("\\", "/"), ",".join(ctx.cfg.get("content_roots", ["/Game"])),
+        ",".join(ctx.cfg.get("map_roots", ctx.cfg.get("content_roots", ["/Game"]))), (",".join(maps) or "none") if isinstance(maps, list) else maps,
+        "1" if assets else "0", "1" if t3d else "0", ctx.cfg.get("module", os.path.splitext(ctx.cfg["uproject"])[0]))
+    if packages is not None:
+        lst = out.rstrip("/\\") + ".packages.txt"
+        os.makedirs(os.path.dirname(lst), exist_ok=True)
+        with open(lst, "w", encoding="utf-8", newline="\n") as f:
+            f.write("".join(p + "\n" for p in packages))
+        sarg += " --packages %s" % lst.replace("\\", "/")
+    # the truth project may name another engine than the replay project (a ported game's final commit vs its replay)
+    editor = ctx.editor_cmd if not project else os.path.join(ctx.engine_for(proj), "Engine", "Binaries", "Win64", "UnrealEditor-Cmd.exe")
+    argv = [editor, up, "-run=pythonscript", sarg] + ctx.cfg.get("editor_args", []) + ["-abslog=" + log]
+    return heavy("ue-replay %s %s" % (ctx.cfg["game"], label), argv)
+
+
+def host_python(ctx, step):
+    """shell step 'host-python script args...': a builder's host-side Python script (not an editor script) run in the
+    replay project with the engine's Python, cwd under the project (e.g. stealth's prune_apply.py deleting pack files).
+    The script must address the project relative to itself or its cwd; one that names the live game repo is refused."""
+    cwd = ctx.p(step.get("cwd", ""))
+    script = os.path.join(cwd, step["argv"][1])
+    text = open(script, encoding="utf-8", errors="replace").read()
+    live = ctx.cfg["repo"].replace("\\", "/").lower()
+    if live in text.replace("\\\\", "/").replace("\\", "/").lower():
+        raise SystemExit("host-python %s names the live game repo; refusing" % step["argv"][1])
+    py = os.path.join(ctx.engine, "Engine", "Binaries", "ThirdParty", "Python3", "Win64", "python.exe")
+    r = subprocess.run([py, script] + list(step["argv"][2:]), cwd=cwd, capture_output=True, text=True, errors="replace")
+    with open(os.path.join(ctx.logs, "host_%s.log" % os.path.splitext(os.path.basename(script))[0]), "a", encoding="utf-8") as f:
+        f.write(r.stdout + r.stderr)
+    if r.returncode:
+        print("   host-python %s exit %s" % (step["argv"][1], r.returncode), flush=True)
+    return r.returncode
+
+
+def delete_paths(ctx, step):
+    """shell step 'delete path...' (an rm of files the builder removed by hand, e.g. maps that no longer load), under
+    cwd; paths stay inside the replay project."""
+    cwd = ctx.p(step.get("cwd", ""))
+    n = 0
+    for rel in step["argv"][1:]:
+        p = os.path.normpath(os.path.join(cwd, rel))
+        if not os.path.normcase(p).startswith(os.path.normcase(os.path.normpath(ctx.proj)) + os.sep):
+            raise SystemExit("shell delete outside the replay project: " + rel)
+        if os.path.isdir(p):
+            shutil.rmtree(p)
+            n += 1
+        elif os.path.exists(p):
+            os.remove(p)
+            n += 1
+    return n
+
+
+def keep_committed(ctx, step, w):
+    """shell step 'keep-committed dir...': a prune the replay cannot recompute (rts-command's prune_packs.py keeps what a
+    registry walk and the Shipping cook output name; the cook is not replayed), reproduced from its result: files under
+    the dirs that the commit `ref` (settings, default the window's commit) does not have are deleted, at the position of
+    the recorded prune command. rts committed the pruned packs over the four commits after the prune: ref names the
+    last of them."""
+    removed = 0
+    ref = git(ctx.proj, "rev-parse", step.get("ref") or w["sha"]).strip()
+    for rel in step["argv"][1:]:
+        rel = rel.strip("/")
+        root = os.path.normpath(ctx.p(rel))
+        if not os.path.normcase(root).startswith(os.path.normcase(os.path.normpath(ctx.proj)) + os.sep):
+            raise SystemExit("keep-committed outside the replay project: " + rel)
+        keep = set(git(ctx.proj, "ls-tree", "-r", "--name-only", ref, "--", rel).splitlines())
+        for dp, dns, fns in os.walk(root, topdown=False):
+            for fn in fns:
+                p = os.path.relpath(os.path.join(dp, fn), ctx.proj).replace("\\", "/")
+                if p not in keep:
+                    os.remove(os.path.join(dp, fn))
+                    removed += 1
+            if not os.listdir(dp):
+                os.rmdir(dp)
+    return removed
+
+
+def move_merge(ctx, step):
+    """shell step 'move-merge src dst' (cp -rn src/. dst/ && rm -rf src) under cwd."""
+    cwd = ctx.p(step.get("cwd", ""))
+    src, dst = os.path.join(cwd, step["argv"][1]), os.path.join(cwd, step["argv"][2])
+    moved = 0
+    if os.path.isdir(src):
+        for dp, _, fns in os.walk(src):
+            for fn in fns:
+                s = os.path.join(dp, fn)
+                d = os.path.join(dst, os.path.relpath(s, src))
+                if not os.path.exists(d):
+                    os.makedirs(os.path.dirname(d), exist_ok=True)
+                    shutil.copy2(s, d)
+                    moved += 1
+        shutil.rmtree(src)
+    return moved
+
+
+def git_tree_files(repo, sha, path):
+    """(path, bytes, sha256) of every file under path at sha; Git LFS pointers give the object's own size and oid."""
+    out = []
+    lines = [l for l in git(repo, "ls-tree", "-r", sha, "--", path).splitlines() if l.strip()]
+    ids = [(l.split("\t", 1)[1], l.split()[2]) for l in lines]
+    if not ids:
+        return out
+    r = subprocess.run(["git", "-C", repo, "cat-file", "--batch"], input=("\n".join(i for _, i in ids) + "\n").encode(),
+                       capture_output=True)
+    data, pos = r.stdout, 0
+    for fp, oid in ids:
+        nl = data.index(b"\n", pos)
+        size = int(data[pos:nl].split()[2])
+        body = data[nl + 1:nl + 1 + size]
+        pos = nl + 1 + size + 1
+        m = re.match(rb"version https://git-lfs.github.com/spec/v1\noid sha256:([0-9a-f]{64})\nsize (\d+)", body)
+        if m:
+            out.append((fp, int(m.group(2)), m.group(1).decode()))
+        else:
+            out.append((fp, size, hashlib.sha256(body).hexdigest()))
+    return out
+
+
+LFS_PTR = re.compile(rb"version https://git-lfs.github.com/spec/v1\r?\noid sha256:([0-9a-f]{64})\r?\nsize (\d+)")
+
+
+def fix_lfs_pointers(ctx, paths):
+    """Files a checkout/restore left as Git LFS pointer text, replaced by the object from the game's LFS store. Happens when
+    the project's .gitattributes (an earlier commit's) does not yet mark the extension as LFS: island's *.jpeg / *.tga
+    pack sources restored from the final commit stayed pointers, so their texture imports failed."""
+    store = None
+    n = 0
+    for rel in paths:
+        root = ctx.p(rel)
+        files = [root] if os.path.isfile(root) else [os.path.join(dp, f) for dp, _, fs in os.walk(root) for f in fs]
+        for fp in files:
+            try:
+                if os.path.getsize(fp) > 1024:
+                    continue
+                with open(fp, "rb") as f:
+                    m = LFS_PTR.match(f.read())
+            except OSError:
+                continue
+            if not m:
+                continue
+            if store is None:
+                store = (git(ctx.proj, "config", "--get", "lfs.storage").strip() or os.path.join(ctx.proj, ".git", "lfs"))
+            oid = m.group(1).decode()
+            obj = os.path.join(store, "objects", oid[:2], oid[2:4], oid)
+            if not os.path.exists(obj):
+                sys.exit("LFS object %s for %s is not in %s" % (oid, fp, store))
+            shutil.copyfile(obj, fp)
+            n += 1
+    return n
+
+
+def drop_assets(ctx, d):
+    n = 0
+    raw = next((r for r in ctx.cfg.get("_raw_drops", []) if r.get("id") == d["id"]), None)
+    for k, it in enumerate(d["items"]):
+        if raw and k < len(raw.get("items", [])) and "{engine}" in str(raw["items"][k].get("from", "")):
+            # engine content (template mannequins...) from the engine in use at this window, not the game's current one
+            it = dict(it, **{"from": ue_replay.expand(raw["items"][k]["from"].replace("{engine}", ctx.engine), ctx.cfg["root"])})
+        if it.get("from_git"):
+            # the pack exactly as the game committed it (e.g. a fetch script that filtered the files), restored from the
+            # final commit into the working tree at the moment the builder copied it in; LFS objects from the game's store
+            ref = git(ctx.proj, "rev-parse", it.get("ref") or ctx.ledger["final"]).strip()   # ref: e.g. the commit that first added the pack
+            git(ctx.proj, "restore", "--source=" + ref, "--worktree", "--", it["from_git"])
+            fix_lfs_pointers(ctx, [it["from_git"]])
+            n += len(git(ctx.proj, "ls-tree", "-r", "--name-only", ref, "--", it["from_git"]).splitlines())
+            continue
+        dst = ctx.p(it["to"])
+        if not os.path.exists(it["from"]):
+            # a wrong source path used to copy nothing without a word (rts-command: "{engine}/../../Templates/...")
+            raise SystemExit("asset drop %s: source %s does not exist" % (d["id"], it["from"]))
+        if os.path.isfile(it["from"]):
+            os.makedirs(os.path.dirname(dst), exist_ok=True)
+            shutil.copy2(it["from"], dst)
+            n += 1
+            continue
+        for dp, _, fns in os.walk(it["from"]):
+            for fn in fns:
+                s = os.path.join(dp, fn)
+                t = os.path.join(dst, os.path.relpath(s, it["from"]))
+                os.makedirs(os.path.dirname(t), exist_ok=True)
+                shutil.copy2(s, t)
+                n += 1
+    return n
+
+
+def note_outputs(ctx, before, after, tag):
+    added, changed, deleted = diff_scan(before, after)
+    prov = ctx.state["provenance"]
+    for p in added + changed:
+        prov[p] = tag
+    for p in deleted:
+        prov.pop(p, None)
+    return {"added": added, "changed": changed, "deleted": deleted}
+
+
+# ------------------------------------------------------------------------------------------------ boundary
+def boundary(ctx, w):
+    """Window check against the commit: content set and identity, fallbacks for content no replayed step produced."""
+    ids = tree_ids(ctx.proj, w["sha"], "Content")
+    prov = ctx.state["provenance"]
+    res = {"fallback": [], "deleted": [], "already_deleted": [], "exact": [], "differs": [], "kept_replay": []}
+    for x in w["content"]:
+        p = x["path"]
+        fp = ctx.p(p)
+        if x["status"] == "D":
+            if os.path.exists(fp):
+                os.remove(fp)
+                res["deleted"].append(p)
+            else:
+                res["already_deleted"].append(p)
+            prov.pop(p, None)
+            continue
+        src = prov.get(p, "")
+        if not os.path.exists(fp) or src.startswith(("git:", "fallback:")) or not src:
+            git(ctx.proj, "checkout", w["sha"], "--", p)
+            fix_lfs_pointers(ctx, [p])
+            prov[p] = "fallback:" + w["sha"][:10]
+            res["fallback"].append({"path": p, "reason": "missing" if not src else "not produced by a replayed step (%s)" % src})
+            continue
+        (res["exact"] if file_matches(fp, ids[p]) else res["differs"]).append({"path": p, "by": src})
+    # content set: what the commit tree has vs what the project has
+    have = set(p for p in scan(ctx.proj))
+    want = set(ids)
+    res["missing"] = sorted(want - have)
+    res["extra"] = sorted(have - want)
+    # inputs back to the commit (reconstructed script texts included)
+    am = [x["path"] for x in w["inputs"] if x["status"] in "AMT"]
+    for r in w["runs"]:
+        am += [p for p in r["texts"] if p not in am]
+    in_tree = set(git(ctx.proj, "ls-tree", "-r", "--name-only", w["sha"]).splitlines())
+    am = [p for p in am if p in in_tree and p != "workflow.jsonl"]
+    if am:
+        git(ctx.proj, "checkout", w["sha"], "--pathspec-from-file=-", inp="\n".join(am).encode("utf-8"))
+        fix_lfs_pointers(ctx, am)
+    return res
+
+
+# ------------------------------------------------------------------------------------------------ run
+def cmd_run(cfg, a):
+    ctx = Ctx(cfg)
+    led = ctx.ledger
+    wins = led["windows"]
+    last = a.until if a.until is not None else len(wins) - 1
+    runs_log = os.path.join(ctx.work, "runs.jsonl")
+    win_log = os.path.join(ctx.work, "windows.jsonl")
+    rows_dir = os.path.join(ctx.work, "rows")
+    os.makedirs(rows_dir, exist_ok=True)
+    for i in range(ctx.state["window"] + 1, last + 1):
+        w = wins[i]
+        t_w = time.time()
+        print("== window %02d %s %s" % (i, w["sha"][:7], w["subject"][:70]), flush=True)
+        done = set(ctx.state["done"])
+        sid = "w%02d.inputs" % i
+        if sid not in done:
+            n_am, n_d = apply_inputs(ctx, w)
+            ctx.state["done"].append(sid)
+            ctx.save()
+            print("   inputs: %d written, %d deleted" % (n_am, n_d), flush=True)
+        if code_changed(w):
+            ctx.state["code_dirty"] = True
+            ctx.save()
+        # engine switch: the commit names another engine (a port): build output of the old engine goes, the editor is
+        # rebuilt with the new one before the next run, and runs.jsonl records it (a report deviation)
+        eng = ctx.engine_for(ctx.proj)
+        if eng != ctx.engine:
+            for d in ("Binaries", "Intermediate"):
+                shutil.rmtree(ctx.p(d), ignore_errors=True)
+            for pdir in glob.glob(ctx.p("Plugins/*")):
+                for d in ("Binaries", "Intermediate"):
+                    shutil.rmtree(os.path.join(pdir, d), ignore_errors=True)
+            jappend(runs_log, {"window": i, "kind": "engine_switch", "step": "w%02d.engine" % i, "commit": w["sha"],
+                               "from": ctx.engine, "to": eng, "time": now()})
+            print("   engine: %s -> %s (Binaries/Intermediate cleared, editor rebuilt before the next run)" % (ctx.engine, eng), flush=True)
+            ctx.set_engine(eng)
+            ctx.state.update({"engine": eng, "code_dirty": True, "built": None})
+            ctx.save()
+        elif ctx.state.get("engine") != ctx.engine:
+            ctx.state["engine"] = ctx.engine
+            ctx.save()
+        # order of the recorded tool calls (each call's end time), then position inside the call; estimated start
+        # times can invert two runs of one command (a duration is printed for one and not the other)
+        steps = [("run", (r["time"], r.get("pos", -1), k), r) for k, r in enumerate(w["runs"])] + \
+                [("drop", (d["time"], -2, 0), d) for d in w["drops"]] + \
+                [("shell", (s["time"], s.get("pos", -1) if s.get("pos", -1) >= 0 else -1, 0), s) for s in w["shell"]]
+        steps.sort(key=lambda s: s[1])
+        wf_path = ctx.p("workflow.jsonl")
+        for kind, t, s in steps:
+            sid = "w%02d.%s.%s" % (i, kind, s.get("id") or s.get("argv", ["?"])[0] + t[0][11:19])
+            if sid in set(ctx.state["done"]):
+                continue
+            # Clean pause between steps (no engine process running): create work/STOP; delete it and run again to
+            # resume from state.json. Killing the runner instead loses the record of the step in flight.
+            if os.path.exists(os.path.join(ctx.work, "STOP")):
+                print("   STOP file found: paused before %s (state saved; delete work/STOP and run again to resume)" % sid, flush=True)
+                return 3
+            rec = {"window": i, "commit": w["sha"], "kind": kind, "step": sid, "time_original": t[0], "start": now()}
+            before = scan(ctx.proj)
+            if kind == "drop":
+                rec["files"] = drop_assets(ctx, s)
+                rec["outputs"] = note_outputs(ctx, before, scan(ctx.proj), "drop:" + s["id"])
+                rec["outputs"] = {k: len(v) for k, v in rec["outputs"].items()}
+            elif kind == "shell":
+                rec["files"] = (move_merge(ctx, s) if s["argv"][0] == "move-merge" else
+                                delete_paths(ctx, s) if s["argv"][0] == "delete" else
+                                keep_committed(ctx, s, w) if s["argv"][0] == "keep-committed" else
+                                host_python(ctx, s) if s["argv"][0] == "host-python" else 0)
+                rec["outputs"] = {k: len(v) for k, v in note_outputs(ctx, before, scan(ctx.proj), "shell:" + sid).items()}
+            else:
+                r = s
+                rec.update({"run": r["id"], "script": r["script"], "readonly": r["readonly"], "exit_code_original": r["exit_code"],
+                            "rows_original": r["rows"]})
+                # (an exit code, even 127, means the run happened: the wrapper printed it after the editor exited)
+                not_run = (r.get("not_run") or
+                           ("no wrapper row and no exit code: the original command stopped before this run"
+                            if r.get("wrapper_rows") == 0 and r.get("exit_code") is None else None))
+                if not_run and not a.force:
+                    rec["skipped"] = not_run
+                    print("   %s %-38s skipped: %s" % (r["id"], os.path.basename(r["script"]), not_run), flush=True)
+                    jappend(runs_log, rec)
+                    ctx.state["done"].append(sid)
