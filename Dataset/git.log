+diff --git a/RawAssets/Effects/CannonFlash.hlsl b/RawAssets/Effects/CannonFlash.hlsl
+new file mode 100644
+index 0000000000000000000000000000000000000000..6f38a2af5f0312634eb974c87efbc80532c031d8
+--- /dev/null
++++ b/RawAssets/Effects/CannonFlash.hlsl
+@@ -0,0 +1,13 @@
++// Original radial muzzle-flash artwork. Billboard UV is [0,1], centre at 0.5.
++float2 p = (UV - 0.5) * 2.0;
++float radius = length(p);
++float angle = atan2(p.y, p.x) + Seed;
++float core = exp(-radius * radius * 42.0);
++float spokes = pow(abs(cos(angle * 3.0)), 18.0);
++float secondary = pow(abs(cos(angle * 2.0 + 0.65)), 24.0);
++float rays = exp(-radius * 4.3) * (0.15 + 0.85 * spokes);
++rays += exp(-radius * 6.0) * secondary * 0.27;
++float mask = saturate(core + rays * 0.82);
++mask *= 1.0 - smoothstep(0.73, 0.98, radius);
++float3 heat = lerp(Color.rgb, float3(1.0, 0.97, 0.82), saturate(core * 1.6));
++return float4(heat, mask);
+diff --git a/RawAssets/Effects/CannonHead.hlsl b/RawAssets/Effects/CannonHead.hlsl
+new file mode 100644
+index 0000000000000000000000000000000000000000..5dab6c429f8bbef8c320b28f94562a6378a86f04
+--- /dev/null
++++ b/RawAssets/Effects/CannonHead.hlsl
+@@ -0,0 +1,9 @@
++// Original circular projectile head: compact hot core and soft amber halo.
++float2 p = (UV - 0.5) * 2.0;
++float radius = length(p);
++float core = exp(-radius * radius * 46.0);
++float halo = exp(-radius * radius * 6.0);
++float mask = saturate(core * 0.68 + halo * 0.42);
++mask *= 1.0 - smoothstep(0.80, 0.98, radius);
++float3 heat = lerp(Color.rgb, float3(1.0, 0.98, 0.90), saturate(core * 1.25));
++return float4(heat, mask);
+diff --git a/RawAssets/Effects/CannonSmoke.hlsl b/RawAssets/Effects/CannonSmoke.hlsl
+new file mode 100644
+index 0000000000000000000000000000000000000000..8ee7458079a39a9cef0e6ada14f1b7162ed90545
+--- /dev/null
++++ b/RawAssets/Effects/CannonSmoke.hlsl
+@@ -0,0 +1,26 @@
++// Original three-octave smoke density; alpha reaches zero before card edges.
++float2 p = (UV - 0.5) * 2.0;
++float2 q = p * 3.8 + float2(Seed, Seed * 0.37);
++float density = 0.0;
++float amplitude = 0.57;
++[unroll]
++for (int octave = 0; octave < 3; ++octave)
++{
++    float2 cell = floor(q);
++    float2 f = frac(q);
++    f = f * f * (3.0 - 2.0 * f);
++    float4 h = float4(dot(cell, float2(127.1, 311.7)),
++                     dot(cell + float2(1, 0), float2(127.1, 311.7)),
++                     dot(cell + float2(0, 1), float2(127.1, 311.7)),
++                     dot(cell + float2(1, 1), float2(127.1, 311.7)));
++    h = frac(sin(h) * 43758.5453);
++    density += lerp(lerp(h.x, h.y, f.x), lerp(h.z, h.w, f.x), f.y) * amplitude;
++    q = q * 2.07 + 17.1;
++    amplitude *= 0.5;
++}
++float angle = atan2(p.y, p.x);
++float boundary = 0.67 + 0.09 * sin(angle * 5.0 + Seed) + 0.055 * sin(angle * 9.0 - Seed * 0.31);
++float mask = 1.0 - smoothstep(boundary - 0.20, boundary + 0.12, length(p));
++mask *= lerp(0.28, 1.0, saturate(density)) * 0.78;
++float3 shade = Color.rgb * lerp(0.72, 1.08, saturate(density));
++return float4(shade, mask);
+diff --git a/RawAssets/Effects/CannonTrail.hlsl b/RawAssets/Effects/CannonTrail.hlsl
+new file mode 100644
+index 0000000000000000000000000000000000000000..470c1082c976991c9ea53a8086f8e6b747c0ebdf
+--- /dev/null
++++ b/RawAssets/Effects/CannonTrail.hlsl
+@@ -0,0 +1,13 @@
++// Engine Plane is 100 cm across, with its length along component-local X.
++// Derive UV from local position so import UV orientation cannot reverse the tail.
++// +X=+50 is head, -X=-50 is tail; component centre is half its length behind bullet.
++float u = saturate((LocalPosition.x + 50.0) * 0.01);
++float v = LocalPosition.y * 0.02;
++float width = lerp(0.18, 1.0, pow(u, 0.65));
++float core = exp(-pow(v * 12.0 / width, 2.0));
++float halo = exp(-pow(v * 3.4 / width, 2.0));
++float lengthFade = pow(u, 1.45) * (1.0 - smoothstep(0.94, 1.0, u));
++float sideFade = 1.0 - smoothstep(0.78, 0.99, abs(v));
++float mask = saturate(core * 0.64 + halo * 0.48) * lengthFade * sideFade;
++float3 heat = lerp(Color.rgb, float3(1.0, 0.97, 0.86), saturate(core * 0.95));
++return float4(heat, mask);
