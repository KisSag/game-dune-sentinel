diff --git a/Source/DuneSentinel/DSEnemyAircraft.h b/Source/DuneSentinel/DSEnemyAircraft.h
index 9ae3da86c9797e7edf9f15ca524503d8cbecb8e4..f63c7c8909e3d2c2a1e2b613ae0f8164557a887b 100644
--- a/Source/DuneSentinel/DSEnemyAircraft.h
+++ b/Source/DuneSentinel/DSEnemyAircraft.h
@@ -5,6 +5,7 @@
 
 class UStaticMeshComponent;
 class USphereComponent;
+class UDSCannonFXComponent;
 UCLASS()
 class DUNESENTINEL_API ADSEnemyAircraft : public AActor
 {
@@ -23,6 +24,7 @@ public:
